<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>StreetCorsa</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>street_corsa.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Title>Street Corsa</Title>
    <Description>Street Corsa: a Street Rod-style career that runs on top of Assetto Corsa</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcTools">
      <HintPath>$(AcToolsLib)AcTools.dll</HintPath>
    </Reference>
    <Reference Include="AcTools.Render">
      <HintPath>$(AcToolsLib)AcTools.Render.dll</HintPath>
    </Reference>
    <Reference Include="SlimDX">
      <HintPath>$(AcToolsLib)SlimDX.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\Backgrounds\*.png" />
    <Resource Include="Assets\Images\Backgrounds\*.jpg" />
    <Resource Include="Assets\Images\Buttons\*.png" />
    <Resource Include="Assets\Images\Icons\*.png" />
    <Resource Include="Assets\Images\UI\*.png" />
    <Resource Include="Assets\Images\Text\*.png" />
    <Resource Include="Assets\Images\Misc\*.png" />
    <Resource Include="Assets\Images\Misc\Calendar\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The styles for the XAML designer: the game merges them itself at start-up (Styles/Theme.cs) -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Content Include="street_corsa.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The base game's content, the first mod (see Mods/ModSet.cs); other mods are dropped into Content next to it -->
    <None Update="Content\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The CSP modes races and free runs run in, installed into AC before each by ScRaceMode -->
    <None Include="..\apps\new-modes\sc_race\*" LinkBase="AcModes\sc_race">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\apps\new-modes\sc_free\*" LinkBase="AcModes\sc_free">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
