<Application x:Class="StreetCorsa.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreetCorsa"
             xmlns:converters="clr-namespace:StreetCorsa.Converters"
             xmlns:mainMenu="clr-namespace:StreetCorsa.Screens.MainMenu"
             xmlns:newGame="clr-namespace:StreetCorsa.Screens.NewGame"
             xmlns:loadGame="clr-namespace:StreetCorsa.Screens.LoadGame"
             xmlns:newspaper="clr-namespace:StreetCorsa.Screens.Newspaper"
             xmlns:dealerMap="clr-namespace:StreetCorsa.Screens.DealerMap"
             xmlns:dealerLot="clr-namespace:StreetCorsa.Screens.DealerLot"
             xmlns:usedParts="clr-namespace:StreetCorsa.Screens.UsedParts"
             xmlns:partShop="clr-namespace:StreetCorsa.Screens.PartShop"
             xmlns:garage="clr-namespace:StreetCorsa.Screens.Garage"
             xmlns:carLot="clr-namespace:StreetCorsa.Screens.CarLot"
             xmlns:diner="clr-namespace:StreetCorsa.Screens.Diner"
             xmlns:cruise="clr-namespace:StreetCorsa.Screens.Cruise"
             xmlns:station="clr-namespace:StreetCorsa.Screens.Station"
             xmlns:settings="clr-namespace:StreetCorsa.Screens.Settings"
             xmlns:carCatalogEditor="clr-namespace:StreetCorsa.Screens.CarCatalogEditor"
             xmlns:soundBrowser="clr-namespace:StreetCorsa.Screens.SoundBrowser"
             xmlns:raceLoading="clr-namespace:StreetCorsa.Screens.RaceLoading"
             xmlns:confirmation="clr-namespace:StreetCorsa.Dialogs.Confirmation"
             xmlns:information="clr-namespace:StreetCorsa.Dialogs.Information"
             xmlns:eventEntry="clr-namespace:StreetCorsa.Dialogs.EventEntry"
             xmlns:timeslip="clr-namespace:StreetCorsa.Dialogs.Timeslip"
             xmlns:dialIn="clr-namespace:StreetCorsa.Dialogs.DialIn"
             xmlns:repairShop="clr-namespace:StreetCorsa.Dialogs.RepairShop"
             xmlns:sellCar="clr-namespace:StreetCorsa.Dialogs.SellCar"
             xmlns:victory="clr-namespace:StreetCorsa.Dialogs.Victory"
             xmlns:quit="clr-namespace:StreetCorsa.Dialogs.Quit"
             xmlns:carInfo="clr-namespace:StreetCorsa.Dialogs.CarInfo"
             xmlns:career="clr-namespace:StreetCorsa.Dialogs.Career"
             xmlns:raceHub="clr-namespace:StreetCorsa.Dialogs.RaceHub"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The look (Styles/*.xaml) is merged in by Styles.Theme.Apply as the app starts, with the mods' theme over
                 the game's colours, sizes and typefaces: see App's constructor. The designer finds them in
                 Properties/DesignTimeResources.xaml -->

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:GaragePanelToVisibilityConverter x:Key="GaragePanelToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:MoneyConverter x:Key="MoneyConverter"/>

            <!-- Screen DataTemplates -->
            <DataTemplate DataType="{x:Type mainMenu:MainMenuScreenViewModel}">
                <mainMenu:MainMenuScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type newGame:NewGameScreenViewModel}">
                <newGame:NewGameScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type loadGame:LoadGameScreenViewModel}">
                <loadGame:LoadGameScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type newspaper:NewspaperScreenViewModel}">
                <newspaper:NewspaperScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type dealerMap:DealerMapScreenViewModel}">
                <dealerMap:DealerMapScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type dealerLot:DealerLotScreenViewModel}">
                <dealerLot:DealerLotScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type usedParts:UsedPartsScreenViewModel}">
                <usedParts:UsedPartsScreenView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type partShop:PartShopScreenViewModel}">
                <partShop:PartShopScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type garage:GarageScreenViewModel}">
                <garage:GarageScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type carLot:CarLotScreenViewModel}">
                <carLot:CarLotScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type diner:DinerScreenViewModel}">
                <diner:DinerScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type cruise:CruiseScreenViewModel}">
                <cruise:CruiseScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type station:GasStationScreenViewModel}">
                <station:GasStationScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type settings:SettingsScreenViewModel}">
                <settings:SettingsScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type soundBrowser:SoundBrowserScreenViewModel}">
                <soundBrowser:SoundBrowserScreenView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type carCatalogEditor:CarCatalogEditorScreenViewModel}">
                <carCatalogEditor:CarCatalogEditorScreenView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type raceLoading:RaceLoadingScreenViewModel}">
                <raceLoading:RaceLoadingScreenView/>
            </DataTemplate>

            <!-- Dialog DataTemplates -->
            <DataTemplate DataType="{x:Type confirmation:ConfirmationDialogViewModel}">
                <confirmation:ConfirmationDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type information:InformationDialogViewModel}">
                <information:InformationDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type eventEntry:EventEntryDialogViewModel}">
                <eventEntry:EventEntryDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type timeslip:TimeslipDialogViewModel}">
                <timeslip:TimeslipDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type dialIn:DialInDialogViewModel}">
                <dialIn:DialInDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type repairShop:RepairShopDialogViewModel}">
                <repairShop:RepairShopDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type sellCar:SellCarDialogViewModel}">
                <sellCar:SellCarDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type victory:VictoryDialogViewModel}">
                <victory:VictoryDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type quit:QuitDialogViewModel}">
                <quit:QuitDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type carInfo:CarInfoDialogViewModel}">
                <carInfo:CarInfoDialogView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type career:CareerDialogViewModel}">
                <career:CareerDialogView/>
            </DataTemplate>

            <!-- Step 25: the racing hub -->
            <DataTemplate DataType="{x:Type raceHub:RaceHubDialogViewModel}">
                <raceHub:RaceHubDialogView/>
            </DataTemplate>
            <!-- end of step 25: the racing hub -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
