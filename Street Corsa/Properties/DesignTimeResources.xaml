<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- For the XAML designer only (ContainsDesignTimeResources in the .csproj): the game merges these at start-up in
         Styles.Theme.Apply, with the mods' theme over them, so App.xaml cannot name them. Never loaded by the game. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/Colors.xaml"/>
        <ResourceDictionary Source="/Styles/Typography.xaml"/>
        <ResourceDictionary Source="/Styles/Fonts.xaml"/>
        <ResourceDictionary Source="/Styles/Brushes.xaml"/>
        <ResourceDictionary Source="/Styles/Icons.xaml"/>
        <ResourceDictionary Source="/Styles/Buttons.xaml"/>
        <ResourceDictionary Source="/Styles/Inputs.xaml"/>
        <ResourceDictionary Source="/Styles/Radio.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
