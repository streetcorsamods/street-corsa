<UserControl x:Class="StreetCorsa.Dialogs.Tune.TuneDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             Width="980"
             Height="640"
             MaxWidth="{Binding (helpers:DialogRoom.Width), RelativeSource={RelativeSource Self}}"
             MaxHeight="{Binding (helpers:DialogRoom.Height), RelativeSource={RelativeSource Self}}">
    <!-- That big, or as big as the window has room for: the rows scroll, the card never has to -->
    <UserControl.Resources>
        <!-- A tab button: the glass toggle, on while its tab shows -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource GlassToggleButtonStyle}">
            <Setter Property="GroupName" Value="TuneTabs"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Style="{StaticResource PanelTitleBandStyle}">
            <DockPanel>
                <Button Style="{StaticResource PanelCloseButtonStyle}"
                        Tag="{StaticResource CloseIcon}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        ToolTip="{t:Text tune.cancel.tip}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{t:Text tune.title}" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding CarName}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The tabs: only those with something to set -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="17,16,17,4" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Style="{StaticResource TabButtonStyle}"
                                 Content="{Binding Name}"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="22,12,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{t:Text tune.nothing}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasRows, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- The rows of the tab on show -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Selected.Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Detail}"/>
                                    </StackPanel>
                                    <Slider Grid.Column="1"
                                            Minimum="{Binding Minimum}"
                                            Maximum="{Binding Maximum}"
                                            SmallChange="{Binding Step}"
                                            LargeChange="{Binding Step}"
                                            TickFrequency="{Binding Step}"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Value, Mode=TwoWay}"
                                            IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBooleanConverter}}"
                                            VerticalAlignment="Center"
                                            Margin="12,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ValueText}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The dyno, beside the engine's rows: the curve as the engine is (dim) and as the tune has it (amber) -->
            <Border Grid.Column="1"
                    Visibility="{Binding ShowsDyno, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{StaticResource UiGlassBrush}"
                    BorderBrush="{StaticResource UiOutlineSoftBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="18,0,0,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{t:Text tune.dyno.title}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                    <Canvas Width="340" Height="150" ClipToBounds="True">
                        <Polyline Points="{Binding StockCurve}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Opacity="0.6"/>
                        <Polyline Points="{Binding TunedCurve}" Stroke="{StaticResource AmberBrush}" StrokeThickness="2.5"/>
                    </Canvas>
                    <TextBlock Text="{Binding Power}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Width="340"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding PowerChange}"
                               Foreground="{StaticResource AmberBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Back to stock, cancel, and done for the garage's time -->
        <Border Grid.Row="3"
                Background="{StaticResource UiBandBrush}"
                BorderBrush="{StaticResource White20Brush}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="{t:Text tune.stock}"
                        ToolTip="{t:Text tune.stock.tip}"
                        Command="{Binding StockCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        MinWidth="140"
                        Height="35"/>
                <Button DockPanel.Dock="Right"
                        Content="{Binding ApplyText}"
                        Command="{Binding ApplyCommand}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="180"
                        Height="35"
                        Margin="10,0,0,0"/>
                <Button DockPanel.Dock="Right"
                        Content="{t:Text common.cancel}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="100"
                        Height="35"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
