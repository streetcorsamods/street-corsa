<UserControl x:Class="StreetCorsa.Dialogs.CarInfo.CarInfoDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="680">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title: the car -->
        <Border Grid.Row="0"
                Background="{StaticResource UiBandBrush}"
                Padding="20,15">
            <TextBlock Text="{Binding Title}"
                       Foreground="{StaticResource CreamBrush}"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- The car at a glance: two columns of label and value -->
        <StackPanel Grid.Row="1" Margin="20,16,20,4">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3,16,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeBody}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       ToolTip="{Binding Value}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding History}"
                       Visibility="{Binding HasHistory, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeCompact}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Every part in the car, under what it is mounted on -->
        <StackPanel Grid.Row="2"
                    Margin="20,12,20,16"
                    Visibility="{Binding HasParts, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Parts installed"
                       Foreground="{StaticResource CreamBrush}"
                       FontSize="{StaticResource FontSizeSubheading}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <Border BorderBrush="{StaticResource UiOutlineBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="0,4">
                <ScrollViewer MaxHeight="340"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto" MinWidth="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               ToolTip="{Binding Name}"
                                               Margin="{Binding Indent}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Kind}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="8,0"
                                               VerticalAlignment="Center"/>
                                    <!-- The part's shape as a bar: green, red when it is nearly gone -->
                                    <ProgressBar Grid.Column="2"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding Condition, Mode=OneWay}"
                                                 Height="8"
                                                 Background="{StaticResource UiBandBrush}"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Foreground" Value="{StaticResource AccentSuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorn}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ConditionDisplay}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="3"
                Background="{StaticResource UiBandBrush}"
                Padding="20,15">
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    IsCancel="True"
                    IsDefault="True"
                    HorizontalAlignment="Right"
                    Width="100"
                    Height="35"/>
        </Border>
    </Grid>
</UserControl>
