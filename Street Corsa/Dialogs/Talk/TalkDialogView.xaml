<UserControl x:Class="StreetCorsa.Dialogs.Talk.TalkDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="560"
             d:DesignHeight="560" d:DesignWidth="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The talk -->
        <Border Grid.Row="0" Padding="20,18,20,16" Height="480" Background="{StaticResource BgPanelBrush}">
            <controls:TalkPanel DataContext="{Binding Talk}"/>
        </Border>

        <!-- Hang up -->
        <Border Grid.Row="1"
                Background="{StaticResource UiBandBrush}"
                BorderBrush="{StaticResource White20Brush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Button Content="{Binding CloseLabel}"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Height="35"/>
        </Border>
    </Grid>
</UserControl>
