<UserControl x:Class="StreetCorsa.Dialogs.Showroom.ShowroomDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             Width="1120"
             Height="700"
             MaxWidth="{Binding (helpers:DialogRoom.Width), RelativeSource={RelativeSource Self}}"
             MaxHeight="{Binding (helpers:DialogRoom.Height), RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <!-- A car's card: dark glass, red glass and an amber outline once picked; dimmed while its tier is shut -->
        <Style x:Key="CarCardStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Width" Value="248"/>
            <Setter Property="Height" Value="210"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource UiPrimaryGlassBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Radio buttons, as the career's sections are: a click on the tier picked leaves it lit -->
        <Style x:Key="TierButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource GlassToggleButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title, and the banked score -->
        <Border Grid.Row="0" Style="{StaticResource PanelTitleBandStyle}">
            <DockPanel>
                <Button Style="{StaticResource PanelCloseButtonStyle}"
                        Tag="{StaticResource CloseIcon}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        ToolTip="{t:Text showroom.close.tip}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{t:Text showroom.title}" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding Banked}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The tiers, the search, and how many are open -->
        <DockPanel Grid.Row="1" Margin="22,16,22,8">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding CountDisplay}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       FontStyle="Italic"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
            <TextBox DockPanel.Dock="Right"
                     Width="240"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     Height="36"
                     FontSize="{StaticResource FontSizeBody}"
                     helpers:GlassInput.Hint="{t:Text showroom.search.hint}"/>
            <ItemsControl ItemsSource="{Binding Tiers}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource TierButtonStyle}"
                                     Content="{Binding Label}"
                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding DataContext.TierCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- The cards: only those in sight are made, and each reads its picture as it first comes into view -->
        <Border Grid.Row="2"
                Margin="22,4,22,10"
                Background="{StaticResource UiGlassBrush}"
                BorderBrush="{StaticResource UiOutlineSoftBrush}"
                BorderThickness="2"
                CornerRadius="6"
                Padding="8,8,4,8">
            <Grid>
                <ItemsControl ItemsSource="{Binding Cards}"
                              VirtualizingPanel.IsVirtualizing="True"
                              Focusable="False">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingUniformWrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CarCardStyle}"
                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Grid Width="232" Height="194" Opacity="{Binding Opacity}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{StaticResource UiFieldBrush}" CornerRadius="4" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{t:Text showroom.no_preview}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasNoPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Image Source="{Binding Preview}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource CardTagStyle}"
                                                    Margin="6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding TierText}" Style="{StaticResource CardTagTextStyle}"/>
                                            </Border>
                                            <Border Background="{StaticResource UiBandBrush}"
                                                    BorderBrush="{StaticResource AmberBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    Margin="6"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding IsOwned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{t:Text showroom.in_garage}"
                                                           FontSize="{StaticResource FontSizeTiny}"
                                                           Foreground="{StaticResource AmberBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="4,8,4,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CreamBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Line}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{t:Text showroom.none}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasCards, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- The car picked, and taking it out -->
        <DockPanel Grid.Row="3" Margin="22,0,22,20" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="{t:Text showroom.take_out}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Command="{Binding TakeOutCommand}"
                    IsDefault="True"
                    FontSize="{StaticResource FontSizeBodyLarge}"
                    MinWidth="220"
                    Height="44"
                    Margin="12,0,0,0"/>
            <TextBlock Text="{Binding Note}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
        </DockPanel>
    </Grid>
</UserControl>
