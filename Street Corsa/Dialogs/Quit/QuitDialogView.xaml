<UserControl x:Class="StreetCorsa.Dialogs.Quit.QuitDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0"
                Background="{StaticResource UiBandBrush}"
                Padding="20,15">
            <TextBlock Text="Quit"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="SemiBold"/>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="20,18,20,8"
                   Text="Your game is saved as you go. Where to?"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="{StaticResource FontSizeBody}"
                   TextWrapping="Wrap"/>

        <!-- The choices, one under the other; Esc or Stay goes back to the game -->
        <StackPanel Grid.Row="2" Margin="20,10,20,20">
            <Button Content="Main Menu"
                    Command="{Binding MainMenuCommand}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Height="40"
                    Margin="0,0,0,10"/>
            <Button Content="Quit to Desktop"
                    Command="{Binding DesktopCommand}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Height="40"
                    Margin="0,0,0,10"/>
            <Button Content="Stay"
                    Command="{Binding StayCommand}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    IsCancel="True"
                    Height="40"/>
        </StackPanel>
    </Grid>
</UserControl>
