<UserControl x:Class="StreetCorsa.Dialogs.PartPreview.PartPreviewDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="680"
             d:DesignHeight="620" d:DesignWidth="680">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0"
                Background="{StaticResource UiBandBrush}"
                BorderBrush="{StaticResource White20Brush}"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <TextBlock Text="{Binding Title}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- The part, turned and wheeled with the mouse. The viewport finds out off the UI thread whether there is a
             picture to show; it is unloaded with the dialog, and its renderer with it. -->
        <Grid Grid.Row="1" Height="440" Background="{StaticResource BgPanelBrush}" ClipToBounds="True">
            <controls:PartViewport3D x:Name="Viewport"
                                     Part="{Binding Part}"
                                     Catalog="{Binding Catalog}"/>

            <!-- A studio's falloff: the light pools on the part, the corners go dark -->
            <Rectangle IsHitTestVisible="False" Opacity="0.6">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.55" GradientOrigin="0.5,0.55" RadiusX="0.75" RadiusY="0.85">
                        <GradientStop Offset="0.35" Color="Transparent"/>
                        <GradientStop Offset="1" Color="{StaticResource Shadow}"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <controls:LoadingIndicator x:Name="Loader"
                                       WaitFor="{Binding ElementName=Viewport}"
                                       Message="{t:Text preview.part.loading}"/>

            <!-- No model, or no 3D on this machine: words where the picture would be -->
            <TextBlock x:Name="NoPicture"
                       Text="{t:Text preview.part.no_picture}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBodyLarge}"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="Hint"
                       Text="{t:Text preview.part.hint}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeCaption}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,12,8"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- What it is, what shape it is in, what it costs -->
        <Grid Grid.Row="2" Margin="20,14,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding PartName}"
                           Visibility="{Binding ShowsPartName, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Group}"
                           Visibility="{Binding Group, Converter={StaticResource StringToVisibilityConverter}}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeCompact}"/>
                <TextBlock Text="{Binding Condition}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeBody}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding PriceLine}"
                       Visibility="{Binding HasPriceLine, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="{StaticResource AccentSuccessBrush}"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </Grid>

        <!-- Buttons -->
        <Border Grid.Row="3"
                Background="{StaticResource UiBandBrush}"
                BorderBrush="{StaticResource White20Brush}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{t:Text common.close}"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="100"
                        Height="35"/>
                <Button Content="{t:Text preview.part.buy}"
                        Command="{Binding BuyCommand}"
                        Visibility="{Binding CanBuy, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Width="100"
                        Height="35"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
