<UserControl x:Class="StreetCorsa.Dialogs.RaceHub.RaceHubDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             Width="1120"
             Height="700"
             MaxWidth="{Binding (helpers:DialogRoom.Width), RelativeSource={RelativeSource Self}}"
             MaxHeight="{Binding (helpers:DialogRoom.Height), RelativeSource={RelativeSource Self}}">
    <!-- That big, or as big as the window has room for: the lists scroll, the card never has to -->
    <UserControl.Resources>
        <!-- A column of the hub: dark glass on the card, its amber title over it -->
        <Style x:Key="ColumnStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource UiGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiOutlineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12,8,12"/>
        </Style>
        <Style x:Key="EmptyLineStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Style="{StaticResource PanelTitleBandStyle}">
            <DockPanel>
                <Button Style="{StaticResource PanelCloseButtonStyle}"
                        Tag="{StaticResource CloseIcon}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        ToolTip="{t:Text racehub.close.tip}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{t:Text racehub.title}" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding EditionDisplay}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontStyle="Italic"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- The race invitations: the ones a car can enter first -->
            <Border Grid.Column="0" Style="{StaticResource ColumnStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{t:Text paper.invitations}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{t:Text paper.invitations.none}"
                               Style="{StaticResource EmptyLineStyle}"
                               Visibility="{Binding HasRaceInvitations, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RaceInvitations}" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource UiGlassCardBrush}"
                                            BorderBrush="{StaticResource UiOutlineSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,10"
                                            Margin="0,0,0,10"
                                            Opacity="{Binding Opacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <!-- The event's name and kind -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="Bold"
                                                               FontSize="{StaticResource FontSizeSubheading}"
                                                               Foreground="{StaticResource CreamBrush}"/>
                                                    <Border Background="{StaticResource UiBandBrush}"
                                                            CornerRadius="3"
                                                            Padding="6,2"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RaceTypeDisplay}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>

                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                                    <Run Text="{t:Text paper.requirements}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                                                    <Run Text="{Binding RequirementsDescription, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <Run Text="{t:Text paper.reward}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                                                    <Run Text="{Binding RewardDescription, Mode=OneWay}" Foreground="{StaticResource AccentSuccessBrush}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding PinkSlipWarning}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding ShowPinkSlipWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <!-- When it runs out, and whether a car of the player's may enter -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding ExpiresInText}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontStyle="Italic">
                                                        <!-- Orange, red when it expires within a day -->
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text=" | "
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding EligibilityText}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontStyle="Italic">
                                                        <!-- Green when a car can enter, red when none can -->
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasEligibleCars}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="{t:Text paper.enter}"
                                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                                    Command="{Binding DataContext.EnterEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanEnter}"
                                                    VerticalAlignment="Center"
                                                    Margin="14,0,0,0"
                                                    Width="96"
                                                    Height="36"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Street News: what the street did the last few days -->
            <Border Grid.Column="2" Style="{StaticResource ColumnStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{t:Text paper.news}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{t:Text paper.news.none}"
                               Style="{StaticResource EmptyLineStyle}"
                               Visibility="{Binding HasArticles, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Articles}" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource UiOutlineSoftBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Headline}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource CreamBrush}">
                                                <!-- The lead story in bigger type -->
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLead}" Value="True">
                                                                <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DateDisplay}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource AmberBrush}"
                                                       Margin="0,2,0,4"/>
                                            <TextBlock Text="{Binding Body}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- The way out onto the streets, as the garage's button went before -->
        <DockPanel Grid.Row="2" Margin="22,0,22,20" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{t:Text racehub.streets.note}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       FontStyle="Italic"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="{t:Text racehub.streets}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Command="{Binding HitTheStreetsCommand}"
                    FontSize="{StaticResource FontSizeBodyLarge}"
                    Width="220"
                    Height="44"/>
        </DockPanel>
    </Grid>
</UserControl>
