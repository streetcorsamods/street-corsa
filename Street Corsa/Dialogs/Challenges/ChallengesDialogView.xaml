<UserControl x:Class="StreetCorsa.Dialogs.Challenges.ChallengesDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             Width="1120"
             Height="700"
             MaxWidth="{Binding (helpers:DialogRoom.Width), RelativeSource={RelativeSource Self}}"
             MaxHeight="{Binding (helpers:DialogRoom.Height), RelativeSource={RelativeSource Self}}">
    <!-- As big as the racing hub, or as the window has room for: the list and the roads scroll -->
    <UserControl.Resources>
        <!-- A Challenge's card: the buttons' dark glass, red glass and an amber outline once picked -->
        <Style x:Key="ChallengeCardStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Command" Value="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
            <Setter Property="CommandParameter" Value="{Binding}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource UiPrimaryGlassBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallLineStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- A medal's word in its colour -->
        <Style x:Key="MedalStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource GrayA0Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGold}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSilver}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource White90Brush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBronze}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SalmonBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource UiGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiOutlineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title, and the banked score -->
        <Border Grid.Row="0" Style="{StaticResource PanelTitleBandStyle}">
            <DockPanel>
                <Button Style="{StaticResource PanelCloseButtonStyle}"
                        Tag="{StaticResource CloseIcon}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        ToolTip="{t:Text challenges.close.tip}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{t:Text challenges.title}" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding Banked}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,16,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The Challenges -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChallengeCardStyle}" Opacity="{Binding Opacity}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Region}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource AmberBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasRegion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CreamBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource SmallLineStyle}"/>
                                            <TextBlock Text="{Binding GoldsText}"
                                                       Style="{StaticResource SmallLineStyle}"
                                                       Foreground="{StaticResource GoldBrush}"
                                                       Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{t:Text challenges.none}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasCards, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- The one picked: its roads in order -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="18,14">
                <DockPanel Visibility="{Binding HasSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border DockPanel.Dock="Top"
                            Height="150"
                            Margin="0,0,0,10"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Visibility="{Binding Selected.HasPicture, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Image Source="{Binding Selected.Picture}" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Selected.Name}"
                                   FontSize="{StaticResource FontSizeDisplaySmall}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CreamBrush}"/>
                        <TextBlock Text="{Binding Selected.Blurb}"
                                   Style="{StaticResource SmallLineStyle}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Visibility="{Binding Selected.HasBlurb, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Roads}" Margin="0,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="12,8"
                                            CornerRadius="4"
                                            BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource UiFieldBrush}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Number}"
                                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AmberBrush}"
                                                       VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Facts}" Style="{StaticResource SmallLineStyle}"/>
                                                <TextBlock Text="{Binding Targets}" Style="{StaticResource SmallLineStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding MedalText}"
                                                           Style="{StaticResource MedalStyle}"
                                                           HorizontalAlignment="Right"
                                                           Visibility="{Binding HasMedal, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Best}"
                                                           Style="{StaticResource SmallLineStyle}"
                                                           HorizontalAlignment="Right"
                                                           Visibility="{Binding HasBest, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding ThisGo}"
                                                           Style="{StaticResource SmallLineStyle}"
                                                           Foreground="{StaticResource CreamBrush}"
                                                           HorizontalAlignment="Right"
                                                           Visibility="{Binding HasThisGo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Getting the road ready, why it cannot go, start over, and drive -->
        <DockPanel Grid.Row="2" Margin="22,0,22,20" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="{Binding DriveText}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Command="{Binding DriveCommand}"
                    IsDefault="True"
                    FontSize="{StaticResource FontSizeBodyLarge}"
                    MinWidth="200"
                    Height="44"
                    Margin="12,0,0,0"/>
            <Button DockPanel.Dock="Right"
                    Content="{t:Text challenges.start_over}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding StartOverCommand}"
                    ToolTip="{t:Text challenges.start_over.tip}"
                    FontSize="{StaticResource FontSizeBodyLarge}"
                    MinWidth="150"
                    Height="44"/>
            <Button DockPanel.Dock="Right"
                    Content="{t:Text challenges.cancel}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CancelSetupCommand}"
                    FontSize="{StaticResource FontSizeBodyLarge}"
                    MinWidth="120"
                    Height="44"
                    Margin="0,0,12,0"
                    Visibility="{Binding CanCancelSetup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding SettingUpText}"
                           Foreground="{StaticResource AmberBrush}"
                           FontSize="{StaticResource FontSizeBody}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsSettingUp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding DriveTip}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasDriveTip, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
