<UserControl x:Class="StreetCorsa.Dialogs.EventEntry.EventEntryDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MaxWidth="{StaticResource TextDialogMaxWidth}"
             d:DesignHeight="550" d:DesignWidth="550">
    <!-- Inside the dialog host's card, which draws the frame -->
    <Border Padding="30"
            MaxWidth="550">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{t:Text event.invitation}"
                          FontSize="{StaticResource FontSizeTitle}"
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          HorizontalAlignment="Center"/>
                <Border Background="{StaticResource BorderLightBrush}"
                        CornerRadius="3"
                        Padding="8,4"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                    <TextBlock Text="{Binding RaceTypeDisplay}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Event Info -->
                    <Border Background="{StaticResource UiBandBrush}"
                           BorderBrush="{StaticResource BorderLightBrush}"
                           BorderThickness="1"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{Binding EventName}"
                                      FontSize="{StaticResource FontSizeHeadingLarge}"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding EventDescription}"
                                      FontSize="{StaticResource FontSizeSmall}"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      TextWrapping="Wrap"
                                      Margin="0,8,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{t:Text event.reward}"
                                          FontSize="{StaticResource FontSizeSmall}"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Reward}"
                                          FontSize="{StaticResource FontSizeSmall}"
                                          FontWeight="Bold"
                                          Foreground="{StaticResource AccentSuccessBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EntryFee}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasEntryFee, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{t:Text event.entry_fee.short}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding CannotAfford, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Opponent Info -->
                    <Border Background="{StaticResource UiBandBrush}"
                           BorderBrush="{StaticResource BorderLightBrush}"
                           BorderThickness="1"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{t:Text event.racing_against}"
                                      FontSize="{StaticResource FontSizeSmall}"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OpponentName}"
                                           FontSize="{StaticResource FontSizeHeading}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock FontSize="{StaticResource FontSizeHeading}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding OpponentNickname, Converter={StaticResource StringToVisibilityConverter}}">
                                    <Run Text="&quot;"/>
                                    <Run Text="{Binding OpponentNickname, Mode=OneWay}"/>
                                    <Run Text="&quot;"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding OpponentCarDisplay}"
                                      FontSize="{StaticResource FontSizeBody}"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,5,0,0"/>

                            <!-- A field: the rest of the grid -->
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding HasField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{t:Text event.field.and}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding FieldLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Car Selection -->
                    <Border Background="{StaticResource UiBandBrush}"
                           BorderBrush="{StaticResource BorderLightBrush}"
                           BorderThickness="1"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{t:Text event.select_car}"
                                      FontSize="{StaticResource FontSizeSmall}"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding EligibleCars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CarBorder"
                                                BorderThickness="2"
                                                CornerRadius="5"
                                                Padding="12"
                                                Margin="0,0,0,8"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectCarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <!-- The background is a Setter, not set on the Border: a local value would beat the selected one -->
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BgMediumBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource TextDisabledBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                                                            <Setter Property="Background" Value="{StaticResource InfoBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Selection indicator -->
                                                <Border Grid.Column="0"
                                                        Width="20" Height="20"
                                                        BorderBrush="{StaticResource InfoBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="10"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <Ellipse x:Name="CheckMark"
                                                            Width="10" Height="10"
                                                            Fill="{StaticResource InfoBrush}"
                                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                              FontSize="{StaticResource FontSizeBody}"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding ConditionText}"
                                                              FontSize="{StaticResource FontSizeCaption}"
                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Pink Slip Warning -->
                    <Border Background="{StaticResource DangerBgBrush}"
                           BorderBrush="{StaticResource DangerBrush}"
                           BorderThickness="2"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,10"
                           Visibility="{Binding IsPinkSlip, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{t:Text event.pink_warning}"
                                      FontSize="{StaticResource FontSizeBody}"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource DangerBrush}"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="{t:Text event.pink_warning.about}"
                                      FontSize="{StaticResource FontSizeSmall}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Content="{t:Text event.enter}"
                       Command="{Binding ConfirmCommand}"
                       IsEnabled="{Binding CanConfirm}"
                       Style="{StaticResource DialogPrimaryButtonStyle}"
                       Width="150"
                       Margin="0,0,10,0"/>

                <Button Content="{t:Text common.cancel}"
                       Command="{Binding CancelCommand}"
                       Style="{StaticResource DialogSecondaryButtonStyle}"
                       Width="100"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
