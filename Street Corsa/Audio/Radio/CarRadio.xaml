<UserControl x:Class="StreetCorsa.Audio.Radio.CarRadio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="380" d:DesignHeight="84">
    <!-- The car's radio in the dash: the power knob, the dial, the tuning knob -->
    <Border CornerRadius="7"
            BorderBrush="{StaticResource CarRadioBezelBrush}"
            BorderThickness="1.5"
            Padding="10,8"
            Background="{StaticResource CarRadioFaceBrush}"
            Effect="{StaticResource DropShadowEffect}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Power: on and off where it was (R) -->
            <Grid Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                <Button x:Name="PowerKnob"
                        Style="{StaticResource RadioKnobStyle}"
                        Width="42"
                        Height="42"
                        Click="OnPower"
                        ToolTip="{t:Text radio.car.power}"/>
                <Ellipse x:Name="Lamp"
                         Width="7"
                         Height="7"
                         Fill="{StaticResource CarRadioLampOffBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"/>
            </Grid>

            <!-- The dial: the song, and the needle running along as it plays. A click opens the radio's panel. -->
            <Border x:Name="Dial"
                    Grid.Column="1"
                    Height="52"
                    MinWidth="220"
                    CornerRadius="4"
                    BorderBrush="{StaticResource RadioRimBrush}"
                    BorderThickness="2"
                    Background="{StaticResource RadioDialBrush}"
                    Cursor="Hand"
                    ToolTip="{t:Text radio.car.panel}"
                    MouseLeftButtonUp="OnDial">
                <Grid ClipToBounds="True">
                    <TextBlock Text="55   60   70   80   100   120   140   160"
                               Foreground="{StaticResource RadioInkFaintBrush}"
                               FontFamily="{StaticResource DialFont}"
                               FontSize="{StaticResource FontSizeMicro}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="SongText"
                               Foreground="{StaticResource RadioInkBrush}"
                               FontFamily="{StaticResource DialFont}"
                               FontWeight="Bold"
                               FontSize="{StaticResource FontSizeCompact}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Bottom"
                               Margin="8,0,8,6"/>
                    <Canvas x:Name="NeedleTrack" IsHitTestVisible="False">
                        <Rectangle x:Name="Needle" Width="2" Height="48" Fill="{StaticResource RadioNeedleBrush}"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Tuning: the next song; the right button, the one before -->
            <Button x:Name="TuneKnob"
                    Grid.Column="2"
                    Style="{StaticResource RadioKnobStyle}"
                    Width="42"
                    Height="42"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Click="OnTune"
                    MouseRightButtonUp="OnTuneBack"
                    ToolTip="{t:Text radio.car.next}"/>
        </Grid>
    </Border>
</UserControl>
