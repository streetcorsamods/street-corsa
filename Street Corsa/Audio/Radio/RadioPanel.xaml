<UserControl x:Class="StreetCorsa.Audio.Radio.RadioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="660">
    <UserControl.Resources>
        <Style x:Key="PanelListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#CC140B05"/>
            <Setter Property="BorderBrush" Value="{StaticResource RadioBrassBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource RadioAmberLightBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="PanelItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF3A2210"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF6A4214"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RadioBrassBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PanelTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF140B05"/>
            <Setter Property="Foreground" Value="{StaticResource RadioAmberLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RadioBrassBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource RadioAmberLightBrush}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- The cabinet -->
    <Border Background="{StaticResource RadioWoodBrush}"
            BorderBrush="#FF1E0E05"
            BorderThickness="3"
            CornerRadius="18"
            Padding="22,18"
            Width="1040"
            MaxHeight="720"
            Effect="{StaticResource DropShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The dial: what plays, and how far it is -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource RadioDialBrush}"
                        BorderBrush="{StaticResource RadioChromeBrush}"
                        BorderThickness="3"
                        CornerRadius="8"
                        Padding="16,8">
                    <Grid>
                        <!-- The band's figures, faint behind the song -->
                        <TextBlock Text="55     60     70     80     100     120     140     160     KC"
                                   Foreground="#553A2008"
                                   FontFamily="Georgia"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="{Binding Radio.NowPlaying}"
                                       Foreground="{StaticResource RadioInkBrush}"
                                       FontFamily="Georgia"
                                       FontSize="{StaticResource FontSizeHeadingLarge}"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Radio.Position}"
                                           Foreground="{StaticResource RadioInkBrush}"
                                           FontFamily="Consolas"/>
                                <TextBlock Text="{Binding Radio.Current.Album}"
                                           Foreground="{StaticResource RadioInkBrush}"
                                           FontFamily="Georgia"
                                           FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource RadioKnobStyle}"
                        Command="{Binding CloseCommand}"
                        Width="34"
                        Height="34"
                        VerticalAlignment="Top"
                        Margin="14,0,0,0"
                        ToolTip="Close (F2, Esc)"/>
            </Grid>

            <!-- The knobs and push buttons -->
            <DockPanel Grid.Row="1" Margin="0,14,0,14" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="⏮" Style="{StaticResource RadioKnobStyle}" Command="{Binding PreviousCommand}" ToolTip="Back a song"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource RadioKnobStyle}" Command="{Binding PlayPauseCommand}" Width="56" Height="56" Margin="8,0" ToolTip="On / pause">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="▶"/>
                                <Setter Property="FontSize" Value="20"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Radio.IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="⏸"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button DockPanel.Dock="Left" Content="⏭" Style="{StaticResource RadioKnobStyle}" Command="{Binding NextCommand}" ToolTip="Next song"/>
                <Button DockPanel.Dock="Left" Content="⏹" Style="{StaticResource RadioKnobStyle}" Command="{Binding StopCommand}" Margin="8,0,24,0" ToolTip="Off"/>

                <ToggleButton DockPanel.Dock="Left" Content="Shuffle" Style="{StaticResource RadioPushStyle}" IsChecked="{Binding Radio.Shuffle}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Left" Content="{Binding RepeatText}" Style="{StaticResource RadioPushStyle}" Command="{Binding CycleRepeatCommand}" VerticalAlignment="Center" MinWidth="120"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume" Foreground="{StaticResource RadioAmberLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Width="160" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                            Value="{Binding Volume}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Lists, songs, and the folders the music is in -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock DockPanel.Dock="Top" Text="LISTS" Style="{StaticResource SectionTitleStyle}"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBox Text="{Binding ListNameText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PanelTextBoxStyle}" ToolTip="A name for a new list, or the picked list's new name"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="New" Style="{StaticResource RadioPushStyle}" Command="{Binding NewListCommand}" Margin="0,0,6,6"/>
                            <Button Content="Rename" Style="{StaticResource RadioPushStyle}" Command="{Binding RenameListCommand}" Margin="0,0,6,6"/>
                            <Button Content="Delete" Style="{StaticResource RadioPushStyle}" Command="{Binding DeleteListCommand}" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                    <ListBox Style="{StaticResource PanelListStyle}"
                             ItemContainerStyle="{StaticResource PanelItemStyle}"
                             ItemsSource="{Binding Lists}"
                             SelectedItem="{Binding SelectedList}"
                             DisplayMemberPath="Title"/>
                </DockPanel>

                <DockPanel Grid.Column="1">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Text="SONGS" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button DockPanel.Dock="Right" Content="Play this list" Style="{StaticResource RadioPushStyle}" Command="{Binding PlayListCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" Style="{StaticResource PanelTextBoxStyle}" ToolTip="Look for a song, an artist or an album"/>
                    </DockPanel>

                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="Play" Style="{StaticResource RadioPushStyle}" Command="{Binding PlaySongCommand}" Margin="0,0,6,6"/>
                        <TextBlock Text="Add to" Foreground="{StaticResource RadioAmberLightBrush}" VerticalAlignment="Center" Margin="8,0,6,6"/>
                        <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding AddTarget}" DisplayMemberPath="Name" Width="150" Margin="0,0,6,6" VerticalAlignment="Center"/>
                        <Button Content="Add" Style="{StaticResource RadioPushStyle}" Command="{Binding AddToListCommand}" Margin="0,0,18,6"/>
                        <Button Content="Take out" Style="{StaticResource RadioPushStyle}" Command="{Binding RemoveFromListCommand}" Margin="0,0,6,6"
                                Visibility="{Binding IsPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="▲" Style="{StaticResource RadioPushStyle}" Command="{Binding MoveUpCommand}" Margin="0,0,6,6"
                                Visibility="{Binding IsPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="▼" Style="{StaticResource RadioPushStyle}" Command="{Binding MoveDownCommand}" Margin="0,0,6,6"
                                Visibility="{Binding IsPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </WrapPanel>

                    <ListBox x:Name="SongList"
                             Style="{StaticResource PanelListStyle}"
                             ItemContainerStyle="{StaticResource PanelItemStyle}"
                             ItemsSource="{Binding Songs}"
                             SelectedItem="{Binding SelectedSong}"
                             VirtualizingPanel.IsVirtualizing="True"
                             MouseDoubleClick="OnSongDoubleClick">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding PlaySongCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LengthText}" Foreground="{StaticResource RadioBrassBrush}" Margin="8,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource RadioBrassBrush}" FontSize="{StaticResource FontSizeCaption}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Artist, Mode=OneWay}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Album, Mode=OneWay}" FontStyle="Italic"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- Where the music is: any folders on the PC -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MUSIC FOLDERS" Style="{StaticResource SectionTitleStyle}"/>
                    <ListBox Style="{StaticResource PanelListStyle}"
                             ItemContainerStyle="{StaticResource PanelItemStyle}"
                             ItemsSource="{Binding Radio.Folders}"
                             SelectedItem="{Binding SelectedFolder}"
                             MaxHeight="84"/>
                    <TextBlock Text="{Binding Radio.Status}"
                               Foreground="{StaticResource RadioAmberLightBrush}"
                               FontSize="{StaticResource FontSizeCaption}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Vertical" Margin="14,22,0,0">
                    <Button Content="Add a folder..." Style="{StaticResource RadioPushStyle}" Command="{Binding AddFolderCommand}" Margin="0,0,0,6" ToolTip="Any folder on the PC; its subfolders come with it"/>
                    <Button Content="Take the folder out" Style="{StaticResource RadioPushStyle}" Command="{Binding RemoveFolderCommand}" Margin="0,0,0,6"/>
                    <Button Content="Open the folder" Style="{StaticResource RadioPushStyle}" Command="{Binding OpenFolderCommand}" Margin="0,0,0,6"/>
                    <Button Content="Look again" Style="{StaticResource RadioPushStyle}" Command="{Binding RescanCommand}" Margin="0,0,0,6"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
