<UserControl x:Class="StreetCorsa.Audio.Radio.RadioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="660">
    <UserControl.Resources>
        <Style x:Key="PanelButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
        </Style>
        <Style x:Key="PanelPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
        </Style>
        <!-- The transport: round buttons, the play one a size up -->
        <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundIconButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <!-- The card, as the dialogs' -->
    <Border Background="{StaticResource UiGlassCardBrush}"
            BorderBrush="{StaticResource UiOutlineBrush}"
            BorderThickness="3"
            CornerRadius="10"
            Width="1040"
            MaxHeight="720"
            Effect="{StaticResource DropShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Style="{StaticResource PanelTitleBandStyle}">
                <DockPanel>
                    <Button Style="{StaticResource PanelCloseButtonStyle}"
                            Tag="{StaticResource CloseIcon}"
                            Command="{Binding CloseCommand}"
                            ToolTip="Close (F2, Esc)"/>
                    <TextBlock Text="Radio" Style="{StaticResource PanelTitleStyle}"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The dial: what plays, and how far it is -->
                <Border Grid.Row="0"
                        Background="{StaticResource RadioDialBrush}"
                        BorderBrush="{StaticResource UiOutlineBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="16,8">
                    <Grid>
                        <!-- The band's figures, faint behind the song -->
                        <TextBlock Text="55     60     70     80     100     120     140     160     KC"
                                   Foreground="#553A2008"
                                   FontFamily="Georgia"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="{Binding Radio.NowPlaying}"
                                       Foreground="{StaticResource RadioInkBrush}"
                                       FontFamily="Georgia"
                                       FontSize="{StaticResource FontSizeHeadingLarge}"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Radio.Position}"
                                           Foreground="{StaticResource RadioInkBrush}"
                                           FontFamily="Consolas"/>
                                <TextBlock Text="{Binding Radio.Current.Album}"
                                           Foreground="{StaticResource RadioInkBrush}"
                                           FontFamily="Georgia"
                                           FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The transport, shuffle and repeat, the volume -->
                <DockPanel Grid.Row="1" Margin="0,14,0,14" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource TransportButtonStyle}" Tag="{StaticResource PreviousIcon}" Command="{Binding PreviousCommand}" ToolTip="Back a song" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Left" Command="{Binding PlayPauseCommand}" ToolTip="On / pause" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
                                <Setter Property="Width" Value="58"/>
                                <Setter Property="Height" Value="58"/>
                                <Setter Property="Padding" Value="16"/>
                                <Setter Property="Tag" Value="{StaticResource PlayIcon}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Radio.IsPlaying}" Value="True">
                                        <Setter Property="Tag" Value="{StaticResource PauseIcon}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource TransportButtonStyle}" Tag="{StaticResource NextIcon}" Command="{Binding NextCommand}" ToolTip="Next song" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource TransportButtonStyle}" Tag="{StaticResource StopIcon}" Command="{Binding StopCommand}" Margin="0,0,24,0" ToolTip="Off" VerticalAlignment="Center"/>

                    <ToggleButton DockPanel.Dock="Left" Content="Shuffle" Style="{StaticResource GlassToggleButtonStyle}" IsChecked="{Binding Radio.Shuffle}"
                                  Height="32" Padding="14,0" Margin="0,0,6,0" FontSize="{StaticResource FontSizeCompact}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Left" Content="{Binding RepeatText}" Style="{StaticResource PanelButtonStyle}" Command="{Binding CycleRepeatCommand}"
                            MinWidth="120" Margin="0" VerticalAlignment="Center"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Volume" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Width="170" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                                Value="{Binding Volume}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Lists, songs, and the folders the music is in -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock DockPanel.Dock="Top" Text="LISTS" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBox Text="{Binding ListNameText, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="{StaticResource FontSizeBody}" helpers:GlassInput.Hint="A list's name"
                                     ToolTip="A name for a new list, or the picked list's new name"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="New" Style="{StaticResource PanelButtonStyle}" Command="{Binding NewListCommand}"/>
                                <Button Content="Rename" Style="{StaticResource PanelButtonStyle}" Command="{Binding RenameListCommand}"/>
                                <Button Content="Delete" Style="{StaticResource PanelButtonStyle}" Command="{Binding DeleteListCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                        <ListBox Style="{StaticResource GlassListBoxStyle}"
                                 ItemsSource="{Binding Lists}"
                                 SelectedItem="{Binding SelectedList}"
                                 DisplayMemberPath="Title"/>
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="SONGS" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button DockPanel.Dock="Right" Content="Play this list" Style="{StaticResource PanelPrimaryButtonStyle}" Command="{Binding PlayListCommand}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" Height="32" FontSize="{StaticResource FontSizeBody}" helpers:GlassInput.Hint="Look for a song, an artist or an album"/>
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Play" Style="{StaticResource PanelPrimaryButtonStyle}" Command="{Binding PlaySongCommand}"/>
                            <TextBlock Text="Add to" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,8,6"/>
                            <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding AddTarget}" DisplayMemberPath="Name" Width="170" Height="32"
                                      FontSize="{StaticResource FontSizeCompact}" Margin="0,0,6,6" VerticalAlignment="Center"/>
                            <Button Content="Add" Style="{StaticResource PanelButtonStyle}" Command="{Binding AddToListCommand}" Margin="0,0,18,6"/>
                            <Button Content="Take out" Style="{StaticResource PanelButtonStyle}" Command="{Binding RemoveFromListCommand}"
                                    Visibility="{Binding IsPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="▲" Style="{StaticResource PanelButtonStyle}" Command="{Binding MoveUpCommand}" ToolTip="Up the list"
                                    Visibility="{Binding IsPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="▼" Style="{StaticResource PanelButtonStyle}" Command="{Binding MoveDownCommand}" ToolTip="Down the list"
                                    Visibility="{Binding IsPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </WrapPanel>

                        <ListBox x:Name="SongList"
                                 Style="{StaticResource GlassListBoxStyle}"
                                 ItemsSource="{Binding Songs}"
                                 SelectedItem="{Binding SelectedSong}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 MouseDoubleClick="OnSongDoubleClick">
                            <ListBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding PlaySongCommand}"/>
                            </ListBox.InputBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LengthText}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Artist, Mode=OneWay}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Album, Mode=OneWay}" FontStyle="Italic"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>

                <!-- Where the music is: any folders on the PC -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MUSIC FOLDERS" Style="{StaticResource SectionTitleStyle}"/>
                        <ListBox Style="{StaticResource GlassListBoxStyle}"
                                 ItemsSource="{Binding Radio.Folders}"
                                 SelectedItem="{Binding SelectedFolder}"
                                 MaxHeight="92"/>
                        <TextBlock Text="{Binding Radio.Status}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="190" Margin="16,22,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
                                <Setter Property="Margin" Value="0,0,0,6"/>
                            </Style>
                        </StackPanel.Resources>
                        <Button Content="Add a folder..." Command="{Binding AddFolderCommand}" ToolTip="Any folder on the PC; its subfolders come with it"/>
                        <Button Content="Take the folder out" Command="{Binding RemoveFolderCommand}"/>
                        <Button Content="Open the folder" Command="{Binding OpenFolderCommand}"/>
                        <Button Content="Look again" Command="{Binding RescanCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
