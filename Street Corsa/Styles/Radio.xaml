<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The radio's look: a 1960s tabletop set in walnut, a speaker grille, an amber dial, chrome knobs. The colours
         are in Colors.xaml with the rest, where a mod's theme reaches them -->

    <LinearGradientBrush x:Key="RadioDialBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource RadioAmberLight}" Offset="0"/>
        <GradientStop Color="{StaticResource RadioAmberDark}" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="RadioChromeBrush" GradientOrigin="0.35,0.3">
        <GradientStop Color="{StaticResource RadioChromeLight}" Offset="0"/>
        <GradientStop Color="{StaticResource RadioChromeMid}" Offset="0.7"/>
        <GradientStop Color="{StaticResource RadioChromeDark}" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="RadioInkBrush" Color="{StaticResource RadioInk}"/>
    <SolidColorBrush x:Key="RadioInkFaintBrush" Color="{StaticResource RadioInkFaint}"/>
    <SolidColorBrush x:Key="RadioInkFainterBrush" Color="{StaticResource RadioInkFainter}"/>
    <SolidColorBrush x:Key="RadioBrassBrush" Color="{StaticResource RadioBrass}"/>
    <SolidColorBrush x:Key="RadioNeedleBrush" Color="{StaticResource RadioNeedle}"/>
    <SolidColorBrush x:Key="RadioRimBrush" Color="{StaticResource RadioRim}"/>
    <SolidColorBrush x:Key="RadioKnobTextBrush" Color="{StaticResource RadioKnobText}"/>

    <!-- The car radio in the dash (CarRadio.xaml) -->
    <LinearGradientBrush x:Key="CarRadioFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource CarRadioFaceTop}" Offset="0"/>
        <GradientStop Color="{StaticResource CarRadioFaceMid}" Offset="0.45"/>
        <GradientStop Color="{StaticResource CarRadioFaceBottom}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CarRadioBezelBrush" Color="{StaticResource CarRadioBezel}"/>
    <SolidColorBrush x:Key="CarRadioLampOffBrush" Color="{StaticResource CarRadioLampOff}"/>
    <SolidColorBrush x:Key="CarRadioLampOnBrush" Color="{StaticResource CarRadioLampOn}"/>

    <!-- The car radio's knobs: round chrome buttons -->
    <Style x:Key="RadioKnobStyle" TargetType="ButtonBase">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource RadioKnobTextBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Ellipse x:Name="knob" Fill="{StaticResource RadioChromeBrush}" Stroke="{StaticResource RadioRimBrush}" StrokeThickness="1.5"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="knob" Property="Stroke" Value="{StaticResource RadioBrassBrush}"/>
                            <Setter TargetName="knob" Property="StrokeThickness" Value="2.5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="knob" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
