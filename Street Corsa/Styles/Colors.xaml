<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <Color x:Key="BgDark">#1B1B1B</Color>
    <Color x:Key="BgMedium">#2A2A2A</Color>
    <Color x:Key="BgLight">#3A3A3A</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#E0E0E0</Color>
    <Color x:Key="TextSecondary">#B0B0B0</Color>
    <Color x:Key="TextDisabled">#606060</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentPrimary">#D32F2F</Color>
    <Color x:Key="AccentHover">#F44336</Color>
    <Color x:Key="AccentPressed">#B71C1C</Color>
    <Color x:Key="AccentSuccess">#90EE90</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderDark">#101010</Color>
    <Color x:Key="BorderLight">#404040</Color>

    <!-- License Input Colors -->
    <Color x:Key="LicenseBrown">#2C1810</Color>

    <!-- Panel and neutral greys. GrayNN is #NNNNNN, so the name says the exact shade -->
    <Color x:Key="BgPanel">#1A1A1A</Color>
    <Color x:Key="Gray26">#262626</Color>
    <Color x:Key="Gray30">#303030</Color>
    <Color x:Key="Gray33">#333333</Color>
    <Color x:Key="Gray50">#505050</Color>
    <Color x:Key="Gray70">#707070</Color>
    <Color x:Key="Gray80">#808080</Color>
    <Color x:Key="GrayA0">#A0A0A0</Color>
    <Color x:Key="White">#FFFFFF</Color>

    <!-- Translucent panels over the background art. The suffix is the alpha byte (BgPanelCC = #CC1A1A1A) -->
    <Color x:Key="BgPanelCC">#CC1A1A1A</Color>
    <Color x:Key="BgPanelF2">#F21A1A1A</Color>
    <Color x:Key="BgDarkDF">#DF1B1B1B</Color>
    <Color x:Key="Glass12C0">#C0121212</Color>
    <Color x:Key="Glass12D0">#D0121212</Color>
    <Color x:Key="Glass14D0">#D0141414</Color>
    <Color x:Key="Glass14E0">#E0141414</Color>
    <Color x:Key="Glass15E8">#E8151515</Color>
    <Color x:Key="Glass10C0">#C0101010</Color>
    <!-- The main screen's cards: dark glass with a touch of blue -->
    <Color x:Key="MenuGlassD8">#D8101114</Color>
    <!-- The edge of the glass panels seen from the driver's seat (street, gas station) -->
    <Color x:Key="PaleGold60">#60FFE68C</Color>

    <!-- Black and white veils (suffix = alpha byte). BlackTransparent is not WPF's Transparent (#00FFFFFF):
         a gradient that fades to it stays black instead of greying through white -->
    <Color x:Key="Overlay">#99000000</Color>
    <Color x:Key="BlackTransparent">#00000000</Color>
    <Color x:Key="Black77">#77000000</Color>
    <Color x:Key="BlackB0">#B0000000</Color>
    <Color x:Key="BlackCC">#CC000000</Color>
    <Color x:Key="White20">#20FFFFFF</Color>
    <Color x:Key="White30">#30FFFFFF</Color>
    <Color x:Key="WhiteB0">#B0FFFFFF</Color>
    <Color x:Key="White38">#38FFFFFF</Color>
    <Color x:Key="White90">#90FFFFFF</Color>
    <!-- Dims the background art behind a list (load game, settings) -->
    <Color x:Key="Scrim">#80000000</Color>
    <!-- Print on paper: the timeslip, the dial-in board -->
    <Color x:Key="Ink">#000000</Color>

    <!-- Status Colors -->
    <Color x:Key="Gold">#FFD700</Color>
    <Color x:Key="GoldCC">#CCFFD700</Color>
    <Color x:Key="Gold33">#33FFD700</Color>
    <Color x:Key="Amber">#FFC107</Color>
    <Color x:Key="Warning">#FFA500</Color>
    <Color x:Key="WarningStrong">#FF8C00</Color>
    <Color x:Key="WarningBg">#3D2F1F</Color>
    <Color x:Key="Danger">#FF6B6B</Color>
    <Color x:Key="DangerStrong">#CC0000</Color>
    <Color x:Key="DangerBg">#3D1F1F</Color>
    <Color x:Key="Salmon">#FF8C6B</Color>
    <Color x:Key="SuccessStrong">#00AA00</Color>
    <Color x:Key="SuccessHover">#7CCD7C</Color>
    <Color x:Key="Fit">#59FF73</Color>
    <Color x:Key="Fit30">#3059FF73</Color>
    <Color x:Key="PaleYellow">#FFE8A0</Color>
    <Color x:Key="Info">#4A90D9</Color>
    <Color x:Key="InfoBg">#1A2A3A</Color>
    <Color x:Key="SuccessBg">#2A3A2A</Color>
    <Color x:Key="GoldBg">#3A3A2A</Color>
    <Color x:Key="RoyalBlue">#4169E1</Color>
    <Color x:Key="SpinnerOrange">#FF6B00</Color>
    <Color x:Key="RedZone">#60C02020</Color>

    <!-- The game's buttons and dialogs: a thick cream outline on dark glass, amber under the pointer -->
    <Color x:Key="UiOutline">#EDE0C4</Color>
    <Color x:Key="UiGlass">#A6101010</Color>
    <Color x:Key="UiGlassHover">#C8202020</Color>
    <Color x:Key="UiGlassPressed">#E0080808</Color>
    <Color x:Key="UiGlassCard">#E0121212</Color>
    <Color x:Key="UiBand">#66000000</Color>
    <Color x:Key="UiPrimaryGlass">#B8A31515</Color>
    <Color x:Key="UiPrimaryGlassHover">#D8C62828</Color>
    <!-- The inputs (Inputs.xaml): a field's outline at rest (the cream, half there), the rail a scroll bar or slider
         runs on, the inside of a text box, dropdown or tick box (near enough solid to read over anything, the
         newspaper included), the amber wash on a row under the pointer -->
    <Color x:Key="UiOutlineSoft">#80EDE0C4</Color>
    <Color x:Key="UiRail">#26EDE0C4</Color>
    <Color x:Key="UiField">#F4141414</Color>
    <Color x:Key="UiRowHover">#2EFFC107</Color>

    <!-- Dealer map and lot: the old-paper look -->
    <Color x:Key="Cream">#F5E6C8</Color>
    <Color x:Key="Cream50">#50F5E6C8</Color>
    <Color x:Key="Cream60">#60F5E6C8</Color>
    <Color x:Key="Cream70">#70F5E6C8</Color>
    <Color x:Key="MapSepia">#6B4A1E</Color>
    <Color x:Key="MapDotFar">#6E6A60</Color>
    <Color x:Key="MapDotFarBorder">#A09A8C</Color>
    <Color x:Key="MapFarText">#E8A15A</Color>

    <!-- Behind the 3D scenes, and the black the screens fade through -->
    <Color x:Key="Stage">#FF000000</Color>
    <!-- Drop shadows under text, cards and panels -->
    <Color x:Key="Shadow">#FF000000</Color>
    <!-- The paper of the licence the player writes their name on -->
    <Color x:Key="LicensePaper">#FFFFFFFF</Color>
    <!-- The tach's needle at the redline (the engine panel) -->
    <Color x:Key="TachRedline">#FFFF0000</Color>
    <!-- The label beside the pointer in the 3D views: its glass and edge (how see-through is each view's own), its text -->
    <Color x:Key="PointerLabelGlass">#FF101010</Color>
    <Color x:Key="PointerLabelEdge">#FFFFE68C</Color>
    <Color x:Key="PointerLabelText">#FFFFFFFF</Color>

    <!-- The intro's title: chrome lettering, top to bottom, and the line under it -->
    <Color x:Key="IntroTitleTop">#FFFFFFFF</Color>
    <Color x:Key="IntroTitleUpper">#FFC8CCD2</Color>
    <Color x:Key="IntroTitleLower">#FF6E747C</Color>
    <Color x:Key="IntroTitleBottom">#FFE6E8EB</Color>
    <Color x:Key="IntroSubtitle">#FFC8CCD2</Color>

    <!-- The main screen: a shade over the room, and the dark band the cards stand on, fading into the room -->
    <Color x:Key="MenuShade">#26000000</Color>
    <Color x:Key="MenuBand">#FF000000</Color>
    <Color x:Key="MenuBandNear">#E6000000</Color>
    <Color x:Key="MenuBandMid">#99000000</Color>
    <Color x:Key="MenuBandEnd">#00000000</Color>

    <!-- The radio's look: a 1960s tabletop set in walnut, a speaker grille, an amber dial, chrome knobs (Radio.xaml) -->
    <Color x:Key="RadioWoodLight">#FF7A4526</Color>
    <Color x:Key="RadioWoodDark">#FF3B1D0D</Color>
    <Color x:Key="RadioWoodEdge">#FF1E0E05</Color>
    <Color x:Key="RadioAmberLight">#FFF7D08A</Color>
    <Color x:Key="RadioAmberDark">#FFD68E2A</Color>
    <Color x:Key="RadioChromeLight">#FFF4F4F4</Color>
    <Color x:Key="RadioChromeMid">#FF9A9A9A</Color>
    <Color x:Key="RadioChromeDark">#FF5A5A5A</Color>
    <Color x:Key="RadioInk">#FF3A2008</Color>
    <!-- The band's figures, faint behind the song: on the car's dial, on the panel's -->
    <Color x:Key="RadioInkFaint">#663A2008</Color>
    <Color x:Key="RadioInkFainter">#553A2008</Color>
    <Color x:Key="RadioGrille">#FF241A12</Color>
    <Color x:Key="RadioBrass">#FFC9A45C</Color>
    <Color x:Key="RadioNeedle">#FFB0201A</Color>
    <Color x:Key="RadioRim">#FF2A2A2A</Color>
    <Color x:Key="RadioKnobText">#FF222222</Color>
    <!-- Round the set in the garage's tile -->
    <Color x:Key="RadioTileBack">#FF17100A</Color>
    <!-- The car radio in the dash: its chrome face, top to bottom, its bezel, the power lamp off and on -->
    <Color x:Key="CarRadioFaceTop">#FFE8E8E8</Color>
    <Color x:Key="CarRadioFaceMid">#FFB4B4B4</Color>
    <Color x:Key="CarRadioFaceBottom">#FF7C7C7C</Color>
    <Color x:Key="CarRadioBezel">#FF3A3A3A</Color>
    <Color x:Key="CarRadioLampOff">#FF4A1A10</Color>
    <Color x:Key="CarRadioLampOn">#FFFF7A3A</Color>

    <!-- The paper's classifieds: ink on newsprint (NewspaperScreenView.xaml) -->
    <Color x:Key="NewsprintPaper">#FFEDE4CF</Color>
    <Color x:Key="NewsprintPaperEdge">#FFD8CBAE</Color>
    <Color x:Key="NewsprintInk">#FF1F1B16</Color>
    <Color x:Key="NewsprintInkFaded">#FF5E564A</Color>
    <!-- The ruled lines between the columns, and under the pointer an ad's faint shade -->
    <Color x:Key="NewsprintRule">#FF4A4237</Color>
    <Color x:Key="NewsprintShade">#1A5A4020</Color>
    <!-- The ring a pencil puts round an ad the player's own, and round a price marked down -->
    <Color x:Key="NewsprintPencil">#FFA4281E</Color>

</ResourceDictionary>
