<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The game's typefaces. Every FontFamily in the views comes from here, so a mod's theme.json changes a face in
         one place (see Theme.cs). A mod's own font goes in its theme/fonts folder and is named by its family name -->

    <!-- Everything not named otherwise: menus, cards, lists, dialogs -->
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <!-- The intro's title -->
    <FontFamily x:Key="DisplayFont">Impact</FontFamily>
    <!-- The radio's lettering: the dial, the song, the toast that says what plays -->
    <FontFamily x:Key="DialFont">Georgia</FontFamily>
    <!-- Figures that line up: the timeslip, the dial-in board, the engine panel, the radio's clock -->
    <FontFamily x:Key="NumbersFont">Consolas</FontFamily>
    <!-- Typed on paper: the licence's name, the main menu badges' labels -->
    <FontFamily x:Key="TypewriterFont">Courier New</FontFamily>
    <!-- The paper's classifieds: the small print of the ads, the masthead -->
    <FontFamily x:Key="NewsprintFont">Times New Roman</FontFamily>
    <!-- The ads' run-in headlines and the section heads, set condensed and bold -->
    <FontFamily x:Key="NewsHeadFont">Bahnschrift</FontFamily>

</ResourceDictionary>
