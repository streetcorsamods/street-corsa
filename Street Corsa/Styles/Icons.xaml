<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The round buttons' icons (RoundIconButtonStyle takes one as its Tag). Only their shape is used: the button
         paints them in its own colour, so a black silhouette and a coloured picture read the same. Decoded small, since
         they are drawn at a few dozen pixels. -->
    <BitmapImage x:Key="CalendarIcon" UriSource="pack://application:,,,/Assets/Icons/calendar.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="CarDealerIcon" UriSource="pack://application:,,,/Assets/Icons/car_dealer.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="CarInfoIcon" UriSource="pack://application:,,,/Assets/Icons/car_info.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="DrivingWheelIcon" UriSource="pack://application:,,,/Assets/Icons/driving_wheel.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="FuelPumpIcon" UriSource="pack://application:,,,/Assets/Icons/fuel_pump.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="GarageIcon" UriSource="pack://application:,,,/Assets/Icons/garage.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="NewspaperIcon" UriSource="pack://application:,,,/Assets/Icons/newspaper.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="PartsIcon" UriSource="pack://application:,,,/Assets/Icons/parts_filled.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="QuitIcon" UriSource="pack://application:,,,/Assets/Icons/quit.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="RadioIcon" UriSource="pack://application:,,,/Assets/Icons/radio.png" DecodePixelWidth="128"/>
    <BitmapImage x:Key="TrophyIcon" UriSource="pack://application:,,,/Assets/Icons/trophy.png" DecodePixelWidth="128"/>

    <!-- Back: an arrow pointing left, drawn rather than a picture -->
    <DrawingImage x:Key="BackIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="White"
                             Geometry="M 0,50 L 42,10 L 42,34 L 100,34 L 100,66 L 42,66 L 42,90 Z"/>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
