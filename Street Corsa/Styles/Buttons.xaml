<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:StreetCorsa.Helpers">

    <!-- Merge Brushes -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml"/>
        <ResourceDictionary Source="Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Main menu badge: the round badge image, lifting a little under the pointer, with its label beneath -->
    <Style x:Key="MenuButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="140"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent">
                        <Border x:Name="badge"
                                Width="116"
                                Height="116"
                                Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="18" Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="label"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Opacity="0.75"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="label" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="label" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="badge" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource Gold}" ShadowDepth="0" BlurRadius="26" Opacity="0.45"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="badge" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="badge" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A card laid over the main screen's cars: dark glass, a thin edge, a soft shadow -->
    <Style x:Key="MenuCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MenuGlassD8Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource White38Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="32,26"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="30" Opacity="0.6"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A card's title -->
    <Style x:Key="MenuCardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,22"/>
    </Style>

    <!-- The game's buttons, everywhere: a thick outline on semi-transparent glass; under the pointer the style's hover
         glass (GlassButton.HoverBrush) and an amber outline fade in over it. Primary (Yes, OK, the one thing to do) is
         red glass, secondary (No, Cancel, the rest) dark glass. -->
    <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
        <Grid x:Name="root">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"/>
            <!-- What the pointer brings: the hover glass and the amber outline, faded in -->
            <Border x:Name="hover"
                    Opacity="0"
                    Background="{Binding (helpers:GlassButton.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}"
                    BorderBrush="{StaticResource AmberBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"/>
            <Border x:Name="pressed"
                    Opacity="0"
                    Background="{StaticResource UiGlassPressedBrush}"
                    CornerRadius="6"
                    Margin="{TemplateBinding BorderThickness}"/>
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.5">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <!-- Only the hover fades: a button goes disabled or comes back at once -->
                        <VisualTransition To="Disabled" GeneratedDuration="0"/>
                        <VisualTransition From="Disabled" GeneratedDuration="0"/>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="pressed" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource UiPrimaryGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UiOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="helpers:GlassButton.HoverBrush" Value="{StaticResource UiPrimaryGlassHoverBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
    </Style>

    <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource UiGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UiOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="helpers:GlassButton.HoverBrush" Value="{StaticResource UiGlassHoverBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
    </Style>

    <!-- A glass button that stays in (Shuffle): while on, its outline is amber with an amber wash under the label.
         The hover fades as on the others. -->
    <Style x:Key="GlassToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource UiGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UiOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="helpers:GlassButton.HoverBrush" Value="{StaticResource UiGlassHoverBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="root">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <Border x:Name="on"
                                Opacity="0"
                                Background="{StaticResource UiRowHoverBrush}"
                                BorderBrush="{StaticResource AmberBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <Border x:Name="hover"
                                Opacity="0"
                                Background="{Binding (helpers:GlassButton.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{StaticResource AmberBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.5">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                    <VisualTransition From="Disabled" GeneratedDuration="0"/>
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.25"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round button with an icon in it (the icon, an ImageSource from Icons.xaml, goes in Tag; what it does in
         ToolTip). Only the icon's shape is used: it is painted in the outline's colour, and both turn amber under the
         pointer. Padding is the room around the icon. -->
    <Style x:Key="RoundIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- The disc, with its glow (off until the pointer comes) -->
                        <Ellipse x:Name="disc" StrokeThickness="3">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{StaticResource UiGlass}"/>
                            </Ellipse.Fill>
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="{StaticResource UiOutline}"/>
                            </Ellipse.Stroke>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource Amber}" ShadowDepth="0" BlurRadius="20" Opacity="0"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- The icon, in the ring's colour -->
                        <Rectangle x:Name="icon" Margin="{TemplateBinding Padding}">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{StaticResource UiOutline}"/>
                            </Rectangle.Fill>
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.5">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <!-- Only the hover fades: a button goes disabled or comes back at once -->
                                    <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                    <VisualTransition From="Disabled" GeneratedDuration="0"/>
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <!-- Each animation names an element and reaches its brush, effect or transform by path: the
                                     generated fade skips one aimed at a named brush (it waits the fade out, then jumps) -->
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="disc" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.8" Duration="0"/>
                                        <ColorAnimation Storyboard.TargetName="disc" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" To="{StaticResource Amber}" Duration="0"/>
                                        <ColorAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="{StaticResource Amber}" Duration="0"/>
                                        <ColorAnimation Storyboard.TargetName="disc" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="{StaticResource UiGlassHover}" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="disc" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.5" Duration="0"/>
                                        <ColorAnimation Storyboard.TargetName="disc" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" To="{StaticResource Amber}" Duration="0"/>
                                        <ColorAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="{StaticResource Amber}" Duration="0"/>
                                        <ColorAnimation Storyboard.TargetName="disc" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="{StaticResource UiGlassPressed}" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same, a notch bigger: the way out onto the streets -->
    <Style x:Key="RoundIconButtonLargeStyle" TargetType="Button" BasedOn="{StaticResource RoundIconButtonStyle}">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- A panel over a screen in the buttons' look: dark glass, the outline, rounded -->
    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UiGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UiOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Every tooltip in the game: dark glass in the buttons' outline -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource UiGlassCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UiOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="420">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game Button Style with Hover Label -->
    <Style x:Key="GameButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="300"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Rounded Border with Image Background -->
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <Border.Clip>
                                <RectangleGeometry RadiusX="20" RadiusY="20">
                                    <RectangleGeometry.Rect>
                                        <Rect Width="300" Height="300"/>
                                    </RectangleGeometry.Rect>
                                </RectangleGeometry>
                            </Border.Clip>
                        </Border>

                        <!-- Hover Label at Bottom Center -->
                        <TextBlock x:Name="hoverLabel"
                                   Text="{TemplateBinding Tag}"
                                   FontFamily="Courier New"
                                   FontSize="{StaticResource FontSizeHeading}"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,20"
                                   Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            <Setter TargetName="hoverLabel" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- License Name Input Style -->
    <Style x:Key="LicenseNameInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource LicenseBrownBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LicenseBrownBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="CharacterCasing" Value="Upper"/>
        <Setter Property="MaxLength" Value="32"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource LicenseBrownBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="38"/>
    </Style>

</ResourceDictionary>
