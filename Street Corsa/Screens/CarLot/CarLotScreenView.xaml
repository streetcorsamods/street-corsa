<UserControl x:Class="StreetCorsa.Screens.CarLot.CarLotScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <!-- A text button on the glass: the warehouse arrows, the list's rows -->
        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass14E0Brush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cream50Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">

        <!-- The warehouse itself, behind everything -->
        <controls:LotViewport3D x:Name="Viewport"
                                ShowroomKn5="{Binding ShowroomKn5}"
                                Cars="{Binding LotCars}"
                                SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                LotRadius="{Binding LotRadius}"
                                LotView="{Binding LotView}"
                                Room="{Binding LotRoom}"
                                Dressing="{Binding Dressing}"
                                IsHitTestVisible="{Binding IsIdle}"/>

        <!-- Covered until every car is standing in its bay, then the cover fades; the same when the next warehouse is
             filled. Without a warehouse installed the cover stays, and the list is the lot. -->
        <Grid Background="{StaticResource BgDarkBrush}"
              helpers:Reveal.IsShown="{Binding IsLotReady, ElementName=Viewport, Converter={StaticResource InverseBooleanConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Width="60" Height="60" Margin="0,0,0,26" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasScene}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="30" CenterY="30"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360"
                                                     Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Ellipse Stroke="{StaticResource SpinnerOrangeBrush}" StrokeThickness="4"
                             StrokeDashArray="3 2"
                             Fill="Transparent"/>
                </Border>
                <TextBlock FontSize="{StaticResource FontSizeTitleSmall}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Opening the warehouse..."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport}" Value="True">
                                    <Setter Property="Text" Value="The warehouse could not be shown in 3D."/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasScene}" Value="False">
                                    <Setter Property="Text" Value="No warehouse is installed: your cars are in the list."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Which warehouse, and the way to the others -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="◀"
                        Style="{StaticResource GlassButtonStyle}"
                        Command="{Binding PreviousWarehouseCommand}"
                        Visibility="{Binding HasSeveralWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}"
                        FontSize="{StaticResource FontSizeHeading}"
                        Padding="12,2"
                        Margin="0,0,14,0"
                        ToolTip="The warehouse before"/>
                <TextBlock Text="{Binding WarehouseTitle}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="Black" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Button Content="▶"
                        Style="{StaticResource GlassButtonStyle}"
                        Command="{Binding NextWarehouseCommand}"
                        Visibility="{Binding HasSeveralWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}"
                        FontSize="{StaticResource FontSizeHeading}"
                        Padding="12,2"
                        Margin="14,0,0,0"
                        ToolTip="The next warehouse"/>
            </StackPanel>
            <TextBlock Text="{Binding WarehouseSummary}"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       IsHitTestVisible="False"
                       Margin="0,3,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Back to the garage -->
        <Button Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource GarageIconButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

        <!-- Bankroll -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="{StaticResource Glass12C0Brush}"
                BorderBrush="{StaticResource Cream50Brush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="14,8,14,10">
            <StackPanel>
                <TextBlock Text="{Binding BankrollDisplay}"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentSuccessBrush}"/>
                <TextBlock Text="{Binding TimeDisplay}"
                           FontSize="{StaticResource FontSizeBody}"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding DateDisplay}"
                           FontSize="{StaticResource FontSizeCaption}"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Every car the player has, the one in the garage first: a click goes to its warehouse and onto it -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Width="280"
                Margin="20,110,0,24"
                Background="{StaticResource Glass12C0Brush}"
                BorderBrush="{StaticResource Cream50Brush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,12,10,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="YOUR CARS"
                           FontSize="{StaticResource FontSizeCompact}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="6,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AllCars}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.FindCarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,6"
                                        Margin="0,0,0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLookedAt}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Glass14E0Brush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Cream70Brush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="{StaticResource FontSizeCompact}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHere}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding PlaceDisplay}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource AccentSuccessBrush}"
                                                CornerRadius="2"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="IN USE"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BgPanelBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- With a car picked, the one thing to do with it: a click on the floor goes back to the whole warehouse -->
        <Button Content="TAKE THIS CAR"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,36"
                Width="280"
                Height="48"
                FontSize="{StaticResource FontSizeBodyLarge}"
                FontWeight="Bold"
                ToolTip="Make it the car you work on and race, and take it to the garage"
                Command="{Binding TakeCarCommand}"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.8"/>
            </Button.Effect>
        </Button>

    </Grid>
</UserControl>
