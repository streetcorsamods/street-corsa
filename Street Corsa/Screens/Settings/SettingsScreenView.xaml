<UserControl x:Class="StreetCorsa.Screens.Settings.SettingsScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:radio="clr-namespace:StreetCorsa.Audio.Radio"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             mc:Ignorable="d"
             d:DesignWidth="800">
    <!-- The Settings card of the main screen -->
    <Border Style="{StaticResource MenuCardStyle}">
        <StackPanel>
            <TextBlock Text="{t:Text settings.title}" Style="{StaticResource MenuCardTitleStyle}"/>

            <!-- Assetto Corsa folder: read at start-up, so a change asks for a restart -->
            <Border Background="{StaticResource ScrimBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Width="560"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{t:Text settings.ac_folder}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding AssettoCorsaFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="{t:Text settings.browse}"
                                Command="{Binding BrowseAssettoCorsaFolderCommand}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Width="100"
                                Margin="10,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding AssettoCorsaFolderHint}"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding AssettoCorsaFolderHint, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <Button Content="{t:Text common.save}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Width="120"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Language: shown when a mod has one besides the game's own; saved at once, spoken from the next start -->
            <Border Background="{StaticResource ScrimBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Width="560"
                    Margin="0,0,0,24"
                    Visibility="{Binding HasLanguages, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock Text="{t:Text settings.language}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding Language}"
                              DisplayMemberPath="Name"
                              Width="220"
                              HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Units: the game's own, or the player's; saved and taken at once -->
            <Border Background="{StaticResource ScrimBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Width="560"
                    Margin="0,0,0,24">
                <DockPanel>
                    <TextBlock Text="{t:Text settings.units}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding UnitChoices}"
                              SelectedItem="{Binding Units}"
                              DisplayMemberPath="Name"
                              Width="300"
                              HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Sound: heard as the sliders move, saved a moment after -->
            <Border Background="{StaticResource ScrimBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Width="560"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{t:Text settings.sound}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1"
                                            Minimum="0"
                                            Maximum="1"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            IsMoveToPointEnabled="True"
                                            Value="{Binding Value}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Label}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Percent}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="{t:Text settings.radio}"
                                Command="{x:Static radio:RadioPanelViewModel.ToggleCommand}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Width="90"
                                Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right"
                                Content="{t:Text settings.sound_library}"
                                Command="{Binding OpenSoundBrowserCommand}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Width="140"/>
                        <CheckBox Content="{t:Text settings.mute_in_background}"
                                  IsChecked="{Binding MuteInBackground}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Edit Car Catalog Button -->
            <Button Content="{t:Text settings.edit_catalog}"
                    Command="{Binding OpenCatalogEditorCommand}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Width="200"
                    Height="45"
                    FontSize="{StaticResource FontSizeSubheading}"
                    HorizontalAlignment="Center"/>

            <Button Content="{t:Text common.back}"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Width="150"
                    Height="45"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    FontSize="{StaticResource FontSizeSubheading}"/>

            <!-- FMOD's licence asks for this line wherever the game credits its tools -->
            <TextBlock Text="{Binding Credits}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="560"
                       Foreground="{StaticResource TextDisabledBrush}"
                       FontSize="{StaticResource FontSizeCaption}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
