<UserControl x:Class="StreetCorsa.Screens.RoadPicker.RoadPickerScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:local="clr-namespace:StreetCorsa.Screens.RoadPicker"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance local:RoadPickerScreenViewModel}"
             FocusManager.FocusedElement="{Binding ElementName=Search}">
    <UserControl.Resources>
        <!-- A road's card: the buttons' dark glass, amber under the pointer; red glass and an amber outline once picked -->
        <Style x:Key="RoadCardStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Width" Value="232"/>
            <Setter Property="Height" Value="204"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="ToolTip" Value="{Binding Track.DisplayName}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource UiPrimaryGlassBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!--
        The roads: the title band across the top (back, what this is, the car driven and the way to another), the cards at
        the left under their search, the road picked at the right with its picture, its best runs and the ways out on it.
        While a run is set up a panel stands over it all with nothing to press but the cancel of a long traffic wait.
    -->
    <Grid Background="{StaticResource StageBrush}">
        <Grid Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- Back, the title and what Drive does -->
            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource RoundIconButtonStyle}"
                        Tag="{StaticResource BackIcon}"
                        ToolTip="{t:Text roadpicker.back.tip}"
                        IsCancel="True"
                        Command="{Binding BackCommand}"
                        Width="56" Height="56" Padding="14"
                        VerticalAlignment="Top"
                        Margin="0,0,18,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{StaticResource FontSizeScreenTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource CreamBrush}"/>
                    <TextBlock Text="{Binding Note}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- The car driven, and the way to another -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource GlassPanelStyle}"
                    Padding="16,10"
                    Margin="0,0,0,18"
                    VerticalAlignment="Center">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{t:Text roadpicker.change_car}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Command="{Binding ChangeCarCommand}"
                            Visibility="{Binding CanChangeCar, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="14,0"
                            Height="36"
                            Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding CarLine}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CreamBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- The search over the cards -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding CountDisplay}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <TextBox x:Name="Search"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             Height="36"
                             FontSize="{StaticResource FontSizeBody}"
                             helpers:GlassInput.Hint="{t:Text trackpicker.search.hint}"/>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{StaticResource UiGlassBrush}"
                        BorderBrush="{StaticResource UiOutlineSoftBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="8,8,4,8">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Cards}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      Focusable="False">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingUniformWrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RoadCardStyle}"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid Width="216" Height="188">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{StaticResource UiFieldBrush}" CornerRadius="4" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{t:Text trackpicker.no_preview}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontStyle="Italic"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasNoPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- The one driven last time -->
                                                    <Border Background="{StaticResource UiBandBrush}"
                                                            BorderBrush="{StaticResource AmberBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="6,2"
                                                            Margin="6"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Visibility="{Binding IsLast, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{t:Text trackpicker.last}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   Foreground="{StaticResource AmberBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="4,8,4,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CreamBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LayoutName}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource AmberBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasLayout, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Place}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasPlace, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{t:Text roadpicker.loading}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{t:Text trackpicker.none}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasNoRoads, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- The road picked -->
            <Border Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource GlassPanelStyle}"
                    Padding="18,18,18,18">
                <DockPanel>
                    <!-- The ways out on it, at the foot -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <TextBlock Text="{Binding Why}"
                                   Style="{StaticResource LineStyle}"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding HasWhy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="{Binding DriveText}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Command="{Binding DriveCommand}"
                                IsDefault="True"
                                FontSize="{StaticResource FontSizeBodyLarge}"
                                Height="48"
                                Visibility="{Binding HasSolo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Content="{t:Text roadpicker.free_run}"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Command="{Binding FreeRunCommand}"
                                    ToolTip="{t:Text garage.free_run.tip}"
                                    Height="42"
                                    Margin="0,0,5,0"/>
                            <Button Content="{t:Text roadpicker.tune}"
                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                    Command="{Binding TuneCommand}"
                                    ToolTip="{t:Text garage.tune.tip}"
                                    Visibility="{Binding CanTune, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Height="42"
                                    Margin="5,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <StackPanel DataContext="{Binding Selected}"
                                        Visibility="{Binding DataContext.HasSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="{StaticResource UiFieldBrush}" CornerRadius="4" ClipToBounds="True" Height="226">
                                    <Grid>
                                        <TextBlock Text="{t:Text trackpicker.no_preview}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasNoPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeTitleSmall}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CreamBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding LayoutName}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource AmberBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasLayout, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Place}"
                                           Style="{StaticResource LineStyle}"
                                           Visibility="{Binding HasPlace, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Facts}"
                                           Style="{StaticResource LineStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Visibility="{Binding HasFacts, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Tags}"
                                           Style="{StaticResource LineStyle}"
                                           FontStyle="Italic"
                                           Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Its best runs -->
                            <StackPanel Margin="0,18,0,0"
                                        Visibility="{Binding HasSolo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{t:Text roadpicker.best}"
                                           FontSize="{StaticResource FontSizeSubheading}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CreamBrush}"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Best}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Place}" Style="{StaticResource CellStyle}" Foreground="{StaticResource AmberBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Score}" Style="{StaticResource CellStyle}" FontWeight="Bold" Foreground="{StaticResource CreamBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Car}" Style="{StaticResource CellStyle}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Date}" Style="{StaticResource CellStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{t:Text roadpicker.no_runs}"
                                           Style="{StaticResource LineStyle}"
                                           FontStyle="Italic"
                                           Visibility="{Binding HasNoBest, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- The run being set up -->
        <Grid Visibility="{Binding IsSettingUp, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Rectangle Fill="{StaticResource ScrimBrush}"/>
            <Border Style="{StaticResource GlassPanelStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="420"
                    Padding="28,22">
                <StackPanel>
                    <TextBlock Text="{Binding SettingUpText}"
                               FontSize="{StaticResource FontSizeHeading}"
                               Foreground="{StaticResource CreamBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <Button Content="{t:Text racehub.traffic.cancel}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Command="{Binding CancelSetupCommand}"
                            Visibility="{Binding CanCancelSetup, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            Padding="18,0"
                            Height="38"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
