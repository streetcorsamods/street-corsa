<UserControl x:Class="StreetCorsa.Screens.ModManager.ModManagerScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="800">
    <!-- The Mod Manager card of the main screen: the mods in the Content folder, installed from zips, switched off and on, deleted -->
    <Border Style="{StaticResource MenuCardStyle}">
        <StackPanel>
            <TextBlock Text="{t:Text mods.title}" Style="{StaticResource MenuCardTitleStyle}"/>

            <!-- Install, the folder -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Button Content="{t:Text menu.mods.install}"
                        Command="{Binding Install.Command}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="18,0"
                        Height="40"
                        Margin="0,0,12,0"/>
                <Button Content="{t:Text newgame.open_content}"
                        Command="{Binding OpenContentFolderCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="18,0"
                        Height="40"/>
            </StackPanel>
            <TextBlock Text="{t:Text menu.mods.installing}"
                       Foreground="{StaticResource AmberBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       Visibility="{Binding Install.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Filters: the type, and words to look for -->
            <Grid Width="760" Margin="0,0,0,10"
                  Visibility="{Binding HasMods, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{t:Text mods.filter.show}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Kinds}"
                          SelectedItem="{Binding Kind}"
                          DisplayMemberPath="Label"
                          Height="34"
                          FontSize="{StaticResource FontSizeBody}"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         helpers:GlassInput.Hint="{t:Text mods.filter.search}"
                         Height="34"
                         FontSize="{StaticResource FontSizeBody}"
                         Margin="16,0,0,0"/>
                <Button Grid.Column="3"
                        Content="{t:Text mods.filter.clear}"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="14,0"
                        Height="34"
                        FontSize="{StaticResource FontSizeSmall}"
                        Margin="8,0,0,0"
                        Visibility="{Binding Search, Converter={StaticResource StringToVisibilityConverter}}"/>
            </Grid>

            <!-- The mods -->
            <Border Background="{StaticResource ScrimBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Width="760"
                    MinHeight="120"
                    MaxHeight="460">
                <Grid>
                    <TextBlock Text="{t:Text mods.none}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSubheading}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasMods, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{t:Text mods.no_match}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSubheading}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding NoMatch, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasMods, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Mods}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgLightBrush}"
                                            BorderBrush="{StaticResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,0,0,10"
                                            Padding="15,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <!-- Switched off: dimmed -->
                                                    <DataTrigger Binding="{Binding On}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding Status}"
                                                               Foreground="{StaticResource AmberBrush}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeHeading}"
                                                               FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Details}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                <!-- What the game says of it -->
                                                <TextBlock Text="{Binding Problems}"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding HasProblems, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="{Binding SwitchText}"
                                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                                        Width="110"
                                                        Height="34"
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,0,8"/>
                                                <Button Content="{t:Text common.delete}"
                                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                                        Width="110"
                                                        Height="34"
                                                        FontSize="{StaticResource FontSizeSmall}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource AccentPrimaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,14,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <TextBlock Text="{t:Text mods.note}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Width="700"
                       Margin="0,12,0,0"/>

            <Button Content="{t:Text common.back}"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Width="150"
                    Height="45"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    FontSize="{StaticResource FontSizeSubheading}"/>
        </StackPanel>
    </Border>
</UserControl>
