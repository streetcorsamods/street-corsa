<UserControl x:Class="StreetCorsa.Screens.Challenges.ChallengesScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:shared="clr-namespace:StreetCorsa.Screens.Shared"
             xmlns:local="clr-namespace:StreetCorsa.Screens.Challenges"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance local:ChallengesScreenViewModel}">
    <UserControl.Resources>
        <!-- A Challenge's card: dark glass, its words from the left; amber under the pointer, red glass and an amber outline once picked -->
        <Style x:Key="ChallengeCardStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="{StaticResource UiGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UiOutlineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Command" Value="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
            <Setter Property="CommandParameter" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource UiPrimaryGlassBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallLineStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- A medal's word in its colour -->
        <Style x:Key="MedalStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource GrayA0Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGold}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSilver}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource White90Brush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBronze}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SalmonBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        The Challenges: the sky, the roads of the one picked flown behind everything (its picture while none of them is
        filmed: before the first comes up, or when none can be), the edges shaded for the words. Back
        and the title at the top left, the car driven at the top right (its button goes to pick another), the cards down
        the left, the one picked at the right with its roads in order, standing on the picture with no panel round them,
        and Start over and Drive at the foot on the right.
    -->
    <Grid Background="{StaticResource BackdropSkyBrush}">
        <controls:RoadBackdropViewport3D x:Name="Backdrop" Roads="{Binding BackdropRoads}"/>
        <Image Source="{Binding Selected.Picture}" Stretch="UniformToFill" IsHitTestVisible="False">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Selected.HasPicture, FallbackValue=False}" Value="True"/>
                                <Condition Binding="{Binding CurrentTitle, ElementName=Backdrop}" Value="{x:Null}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <Rectangle Width="640" HorizontalAlignment="Left" Fill="{StaticResource BackdropShadeLeftBrush}" IsHitTestVisible="False"/>
        <Rectangle Width="760" HorizontalAlignment="Right" Fill="{StaticResource BackdropShadeRightBrush}" IsHitTestVisible="False"/>
        <Rectangle Height="200" VerticalAlignment="Bottom" Fill="{StaticResource BackdropShadeBottomBrush}" IsHitTestVisible="False"/>

        <Grid Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- The sides at their widths on a wide window, all three narrowing together on a small one -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400*" MaxWidth="400"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="520*" MaxWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- Back, the title and the banked score -->
            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,18">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource RoundIconButtonStyle}"
                        Tag="{StaticResource BackIcon}"
                        ToolTip="{t:Text challenges.back.tip}"
                        IsCancel="True"
                        Command="{Binding BackCommand}"
                        Width="56" Height="56" Padding="14"
                        VerticalAlignment="Top"
                        Margin="0,0,18,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{t:Text challenges.title}"
                               FontSize="{StaticResource FontSizeScreenTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource CreamBrush}"/>
                    <TextBlock Text="{Binding Banked}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- The car driven on its card (shared with Home and the roads): pressed, it goes to pick another -->
            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource DrivenCarButtonStyle}"
                    Command="{Binding ChangeCarCommand}"
                    ToolTip="{t:Text challenges.car.tip}"
                    IsHitTestVisible="{Binding CanChangeCar}"
                    VerticalAlignment="Top"
                    Margin="0,0,0,18"
                    Visibility="{Binding HasCar, Converter={StaticResource BooleanToVisibilityConverter}}">
                <shared:DrivenCarCard DataContext="{Binding Car}"/>
            </Button>
            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource DrivenCarButtonStyle}"
                    Command="{Binding ChangeCarCommand}"
                    ToolTip="{t:Text challenges.car.tip}"
                    IsHitTestVisible="{Binding CanChangeCar}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="{Binding ShowsPickCar, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{t:Text challenges.car.none}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="Bold"
                           Foreground="{StaticResource CreamBrush}"/>
            </Button>

            <!-- The Challenges -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.RowSpan="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,8,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChallengeCardStyle}" Opacity="{Binding Opacity}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Region}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{StaticResource AmberBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding ShowsRegion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CreamBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource SmallLineStyle}"/>
                                        <TextBlock Text="{Binding GoldsText}"
                                                   Style="{StaticResource SmallLineStyle}"
                                                   Foreground="{StaticResource GoldBrush}"
                                                   Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{t:Text challenges.none}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasCards, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </Grid>

            <!-- The road on screen, under the picture -->
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding CurrentTitle, ElementName=Backdrop}"
                       FontSize="{StaticResource FontSizeSmall}"
                       FontStyle="Italic"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="16,0,16,6"/>

            <!-- The one picked: its roads in order, on the picture itself -->
            <DockPanel Grid.Row="1" Grid.Column="2"
                       Margin="0,6,0,14"
                       Visibility="{Binding HasSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="{Binding Selected.Name}"
                               FontSize="{StaticResource FontSizeDisplaySmall}"
                               FontWeight="Bold"
                               Foreground="{StaticResource CreamBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Selected.Region}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource AmberBrush}"
                               Visibility="{Binding Selected.ShowsRegion, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                    <TextBlock Text="{Binding Selected.Blurb}"
                               Style="{StaticResource SmallLineStyle}"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="0,6,0,0"
                               Visibility="{Binding Selected.HasBlurb, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Roads}" Margin="0,0,6,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A road: a rule under it, the go's next one marked down its left in amber -->
                                <Border Padding="12,8,4,9" BorderThickness="3,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource UiOutlineSoftBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Number}"
                                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AmberBrush}"
                                                   VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Facts}" Style="{StaticResource SmallLineStyle}"/>
                                            <TextBlock Text="{Binding Targets}" Style="{StaticResource SmallLineStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding MedalText}"
                                                       Style="{StaticResource MedalStyle}"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding HasMedal, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Best}"
                                                       Style="{StaticResource SmallLineStyle}"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding HasBest, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding ThisGo}"
                                                       Style="{StaticResource SmallLineStyle}"
                                                       Foreground="{StaticResource CreamBrush}"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding HasThisGo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Getting the road ready or why it cannot go, then Start over and Drive -->
            <StackPanel Grid.Row="2" Grid.Column="2">
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{Binding SettingUpText}"
                               Foreground="{StaticResource AmberBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               Visibility="{Binding IsSettingUp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding DriveTip}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               Visibility="{Binding HasDriveTip, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
                <!-- Wrapped onto a second line where the column is too narrow for them all -->
                <WrapPanel HorizontalAlignment="Right" Margin="-12,-8,0,0">
                    <Button Content="{t:Text challenges.cancel}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Command="{Binding CancelSetupCommand}"
                            FontSize="{StaticResource FontSizeBodyLarge}"
                            MinWidth="120"
                            Height="48"
                            Margin="12,8,0,0"
                            Visibility="{Binding CanCancelSetup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="{t:Text challenges.start_over}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Command="{Binding StartOverCommand}"
                            ToolTip="{t:Text challenges.start_over.tip}"
                            FontSize="{StaticResource FontSizeBodyLarge}"
                            MinWidth="140"
                            Height="48"
                            Margin="12,8,0,0"/>
                    <Button Content="{Binding DriveText}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Command="{Binding DriveCommand}"
                            IsDefault="True"
                            FontSize="{StaticResource FontSizeBodyLarge}"
                            MinWidth="200"
                            Height="48"
                            Margin="12,8,0,0"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
