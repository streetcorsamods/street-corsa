<UserControl x:Class="StreetCorsa.Screens.Newspaper.NewspaperScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:local="clr-namespace:StreetCorsa.Screens.Newspaper"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600">
    <UserControl.Resources>
        <!-- An ad: the whole of it is clicked to go and look; a faint shade under the pointer, a hairline under each -->
        <Style x:Key="ClassifiedAdStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="600"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ad"
                                Background="Transparent"
                                BorderBrush="{StaticResource NewsprintRuleBrush}"
                                BorderThickness="0,0,0,0.5"
                                Padding="2,7,2,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ad" Property="Background" Value="{StaticResource NewsprintShadeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ad's small print -->
        <Style x:Key="AdTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NewsprintFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
            <Setter Property="Foreground" Value="{StaticResource NewsprintInkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Justify"/>
        </Style>

        <!-- A button printed in ink: Take it, Turn down. Ink fills it under the pointer. -->
        <Style x:Key="InkButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource NewsprintInkBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource NewsHeadFont}"/>
            <Setter Property="FontStretch" Value="Condensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Padding" Value="5,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="box"
                                Background="Transparent"
                                BorderBrush="{StaticResource NewsprintInkBrush}"
                                BorderThickness="1.25"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="label" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource NewsprintInkBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource NewsprintPaperBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="box" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A section's head across the page, in heavy condensed capitals: the one on show in ink and underscored -->
        <Style x:Key="SectionHeadStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Command" Value="{Binding ShowSectionCommand}"/>
            <Setter Property="Foreground" Value="{StaticResource NewsprintInkFadedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource NewsHeadFont}"/>
            <Setter Property="FontStretch" Value="Condensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
            <Setter Property="Margin" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="head" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,4" Padding="4,0,4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NewsprintInkBrush}"/>
                                <Setter TargetName="head" Property="BorderBrush" Value="{StaticResource NewsprintInkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NewsprintInkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line across the page: the masthead's rules -->
        <Style x:Key="PageRuleStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource NewsprintInkBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="PaperNoteStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NewsprintFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{StaticResource NewsprintInkFadedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,24"/>
        </Style>

        <ItemsPanelTemplate x:Key="ColumnsPanel">
            <local:ClassifiedColumnsPanel MinColumnWidth="360" Gutter="32" Rule="{StaticResource NewsprintRuleBrush}"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="{StaticResource NewsprintPaperBrush}"
          Opacity="0">
        <!-- The sheet: newsprint over the whole screen -->
        <Border x:Name="Sheet"
                Padding="40,18,36,0"
                Opacity="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The masthead: the paper's name between its rules, the date and the page's name under it, across the
                     whole page; it starts under the back button on the left and the money card on the right -->
                <StackPanel Grid.Row="0" Margin="0,84,0,0">
                    <Border Style="{StaticResource PageRuleStyle}" BorderThickness="0,0,0,3"/>
                    <TextBlock Text="{t:Text paper.masthead}"
                               FontFamily="{StaticResource NewsprintFont}"
                               FontWeight="Bold"
                               FontSize="{StaticResource FontSizeDisplay}"
                               Foreground="{StaticResource NewsprintInkBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                    <Border Style="{StaticResource PageRuleStyle}"/>
                    <Grid Margin="0,3,0,3">
                        <TextBlock Text="{Binding EditionDisplay}"
                                   FontFamily="{StaticResource NewsprintFont}"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource NewsprintInkBrush}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{t:Text paper.classifieds}"
                                   FontFamily="{StaticResource NewsHeadFont}"
                                   FontStretch="Condensed"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   Foreground="{StaticResource NewsprintInkBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{t:Text paper.masthead.price}"
                                   FontFamily="{StaticResource NewsprintFont}"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource NewsprintInkBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Style="{StaticResource PageRuleStyle}"/>
                    <Border Style="{StaticResource PageRuleStyle}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- The two sections -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,8">
                    <RadioButton Style="{StaticResource SectionHeadStyle}"
                                 Content="{t:Text paper.section.cars}"
                                 IsChecked="{Binding ShowCars, Mode=OneWay}"
                                 CommandParameter="Cars"/>
                    <RadioButton Style="{StaticResource SectionHeadStyle}"
                                 Content="{t:Text paper.section.parts}"
                                 IsChecked="{Binding ShowParts, Mode=OneWay}"
                                 CommandParameter="Parts"/>
                </StackPanel>

                <!-- The paper is being put together: the first market of a game takes a few seconds -->
                <TextBlock Grid.Row="2"
                           Text="{t:Text paper.loading}"
                           Style="{StaticResource PaperNoteStyle}"
                           VerticalAlignment="Top"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Used cars: the player's own ads boxed at the top, then every car for sale -->
                <ScrollViewer x:Name="CarsScroller"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="OnScrollChanged"
                              Visibility="{Binding ShowCars, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="0,0,10,24">
                        <!-- The player's own cars in the paper, and the buyers who called -->
                        <Border BorderBrush="{StaticResource NewsprintInkBrush}"
                                BorderThickness="2"
                                Padding="14,8,14,10"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Left"
                                MinWidth="420"
                                Visibility="{Binding HasPlayerAds, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{t:Text paper.your_ads}"
                                           FontFamily="{StaticResource NewsHeadFont}"
                                           FontStretch="Condensed"
                                           FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeSubheading}"
                                           Foreground="{StaticResource NewsprintInkBrush}"
                                           Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding PlayerAds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding HasOffer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button Content="{t:Text paper.offer.take}" Command="{Binding AcceptCommand}" Style="{StaticResource InkButtonStyle}" Margin="12,0,0,0"/>
                                                    <Button Content="{t:Text paper.offer.turn_down}" Command="{Binding DeclineCommand}" Style="{StaticResource InkButtonStyle}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource AdTextStyle}" TextAlignment="Left">
                                                    <Run Text="{Binding CarName, Mode=OneWay}" FontFamily="{StaticResource NewsHeadFont}" FontStretch="Condensed" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding AskingDisplay, Mode=OneWay}"/><LineBreak/><Run Text="{Binding OfferDisplay, Mode=OneWay}" FontStyle="Italic" Foreground="{StaticResource NewsprintInkFadedBrush}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{t:Text paper.cars.none}"
                                   Style="{StaticResource PaperNoteStyle}"
                                   Visibility="{Binding ShowNoCars, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <ItemsControl ItemsSource="{Binding CarAds.Shown}" ItemsPanel="{StaticResource ColumnsPanel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CarAdViewModel}">
                                    <Button Style="{StaticResource ClassifiedAdStyle}" Command="{Binding LookCommand}" ToolTip="{Binding Details}">
                                        <TextBlock Style="{StaticResource AdTextStyle}">
                                            <Run Text="{Binding Headline, Mode=OneWay}" FontFamily="{StaticResource NewsHeadFont}" FontStretch="Condensed" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding Blurb, Mode=OneWay}"/><Run Text="{Binding WasPriceDisplay, Mode=OneWay}" TextDecorations="Strikethrough" Foreground="{StaticResource NewsprintPencilBrush}"/><Run Text="{Binding PriceDisplay, Mode=OneWay}" FontWeight="Bold"/><Run Text=". "/><Run Text="{Binding SellerDisplay, Mode=OneWay}" FontStyle="Italic"/>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Used parts: every part ad -->
                <ScrollViewer x:Name="PartsScroller"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="OnScrollChanged"
                              Visibility="{Binding ShowParts, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="0,0,10,24">
                        <TextBlock Text="{t:Text paper.parts.none}"
                                   Style="{StaticResource PaperNoteStyle}"
                                   Visibility="{Binding ShowNoParts, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <ItemsControl ItemsSource="{Binding PartAds.Shown}" ItemsPanel="{StaticResource ColumnsPanel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PartAdViewModel}">
                                    <Button Style="{StaticResource ClassifiedAdStyle}" Command="{Binding LookCommand}" ToolTip="{Binding Details}">
                                        <TextBlock Style="{StaticResource AdTextStyle}">
                                            <Run Text="{Binding Headline, Mode=OneWay}" FontFamily="{StaticResource NewsHeadFont}" FontStretch="Condensed" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding Blurb, Mode=OneWay}"/><Run Text="{Binding PriceDisplay, Mode=OneWay}" FontWeight="Bold"/><Run Text=". "/><Run Text="{Binding SellerDisplay, Mode=OneWay}" FontStyle="Italic"/><Run Text="{Binding FitsDisplay, Mode=OneWay}" FontStyle="Italic" Foreground="{StaticResource NewsprintPencilBrush}"/>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Back to the garage -->
        <Button x:Name="BackButton"
                Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource BackIcon}"
                ToolTip="{t:Text common.back}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0"/>
    </Grid>
</UserControl>
