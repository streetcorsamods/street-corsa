<UserControl x:Class="StreetCorsa.Screens.Shared.DrivenCarCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:local="clr-namespace:StreetCorsa.Screens.Shared"
             mc:Ignorable="d"
             d:DesignHeight="110" d:DesignWidth="420"
             d:DataContext="{d:DesignInstance local:DrivenCar}">
    <!--
        The car driven, the same on every screen that tells of it (Home, the roads, the Challenges): its picture at the
        left, at the right its make, its name, its tier and year, and its best run for the score. The screen puts it on
        its own panel or button.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Height="95"
                Background="{StaticResource UiFieldBrush}"
                CornerRadius="4"
                ClipToBounds="True"
                VerticalAlignment="Center">
            <Grid>
                <TextBlock Text="{t:Text trackpicker.no_preview}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasNoPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Image Source="{Binding Preview}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Brand}"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasBrand, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Name}"
                       FontSize="{StaticResource FontSizeTitleSmall}"
                       FontWeight="Bold"
                       Foreground="{StaticResource CreamBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource CardTagStyle}"
                        Visibility="{Binding HasTier, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding TierText}" Style="{StaticResource CardTagTextStyle}"/>
                </Border>
                <TextBlock Text="{Binding Year}"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Visibility="{Binding HasYear, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <TextBlock Text="{Binding Best}"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{StaticResource AmberBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
