<UserControl x:Class="StreetCorsa.Screens.Garage.GarageScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:audio="clr-namespace:StreetCorsa.Audio"
             xmlns:radio="clr-namespace:StreetCorsa.Audio.Radio"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:local="clr-namespace:StreetCorsa.Screens.Garage"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ViewportToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{StaticResource UiGlassBrush}"
                                    BorderBrush="{StaticResource UiOutlineBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"/>
                            <!-- The amber outline, faded in under the pointer -->
                            <Border x:Name="hover"
                                    Opacity="0"
                                    BorderBrush="{StaticResource AmberBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"/>
                            <ContentPresenter Margin="12,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.5">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <!-- Only the hover fades: a button goes disabled or comes back at once -->
                                        <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                        <VisualTransition From="Disabled" GeneratedDuration="0"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource UiPrimaryGlassBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <!-- Everything lives in ContentLayer, which stays invisible until the 3D garage has rendered its
             first frame; then the whole screen (garage, car, overlay) fades in at once. While an engine goes between
             the car and the stand, nothing in it can be used. -->
        <Grid x:Name="ContentLayer"
              Opacity="0"
              IsHitTestVisible="False"
              IsEnabled="{Binding IsMovingEngine, ElementName=Viewport3D, Converter={StaticResource InverseBooleanConverter}}">
        <!-- 3D Garage (whole screen background; renders the empty garage when no car is selected) -->
        <controls:CarViewport3D x:Name="Viewport3D"
                                CarDirectory="{Binding SelectedCar.CarDirectory}"
                                SkinId="{Binding SelectedCar.SkinId}"
                                ShowroomKn5="{Binding GarageShowroomKn5}"
                                PartsCatalog="{Binding Workbench.Catalog}"
                                PartsVisible="{Binding Workbench.IsOpen}"
                                StandMode="{Binding Workbench.IsStand}"
                                StandEngine="{Binding Workbench.StandEngine}"
                                EngineTurnedOver="{Binding Workbench.IsEngineTurnedOver}"
                                Engine="{Binding Workbench.Engine}"
                                Gear="{Binding Workbench.Gear}"
                                EngineLayout="{Binding Workbench.EngineLayout}"
                                Candidates="{Binding Workbench.Candidates}"
                                SelectedPart="{Binding Workbench.SelectedPart}"
                                RunningEngine="{Binding Runner, ElementName=EnginePanel}"
                                FadeInOnReady="False"/>

        <!-- Main Content: 800 wide at most, narrower on a small or high-DPI screen so it keeps clear of the side buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*" MaxWidth="800"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Center Content (Car Name + Preview) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selected Car Display Bar (Clickable): outlined glass, the name in cream over it -->
                <Button x:Name="CarDisplayButton"
                    Grid.Row="0"
                    Command="{Binding SelectCarCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,30,0,20"
                    ToolTip="{t:Text garage.cars.tip}"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                    <Border x:Name="CarDisplayBorder"
                                           Background="{StaticResource UiGlassBrush}"
                                           BorderBrush="{StaticResource UiOutlineBrush}"
                                           BorderThickness="3"
                                           CornerRadius="8"
                                           Padding="30,12"
                                           MaxWidth="800">
                                        <TextBlock Text="{Binding SelectedCarDisplay}"
                                                  FontSize="{StaticResource FontSizeTitleSmall}"
                                                  FontWeight="Bold"
                                                  Foreground="{StaticResource CreamBrush}"
                                                  TextTrimming="CharacterEllipsis"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="6" Opacity="0.9"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Border>
                                    <!-- The hover's glass and amber outline, faded in over it -->
                                    <Border x:Name="CarDisplayHover"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            Background="{StaticResource White20Brush}"
                                            BorderBrush="{StaticResource AmberBrush}"
                                            BorderThickness="3"
                                            CornerRadius="8"
                                            MaxWidth="800"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.5">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <!-- Only the hover fades: a button goes disabled or comes back at once -->
                                        <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                        <VisualTransition From="Disabled" GeneratedDuration="0"/>
                                    </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CarDisplayHover" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CarDisplayHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled"/>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Car Preview Container -->
            <Border x:Name="PreviewContainer"
                    Grid.Row="1"
                    Background="{StaticResource UiGlassCardBrush}"
                    BorderBrush="{StaticResource UiOutlineBrush}"
                    BorderThickness="3"
                    CornerRadius="10"
                    HorizontalAlignment="Stretch"
                    MaxWidth="800"
                    Margin="0,0,0,40">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <!-- Shown for the calendar, or as the 2D fallback when the 3D garage could not start. The calendar
                     rises and fades in as it opens, unless the card is already up as the fallback; the fade lets go of
                     the card when the calendar closes. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePanel}" Value="Calendar">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ActivePanel}" Value="Calendar"/>
                                    <Condition Binding="{Binding HasFailed, ElementName=Viewport3D}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="CalendarRise">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="24" To="0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="CalendarRise"/>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport3D}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                    Direction="270"
                                    ShadowDepth="5"
                                    BlurRadius="15"
                                    Opacity="0.6"/>
                </Border.Effect>

                <Grid>
                    <!-- ==================== CAR PREVIEW PANEL ==================== -->
                    <Grid Visibility="{Binding ActivePanel, Converter={StaticResource GaragePanelToVisibilityConverter}, ConverterParameter=CarPreview}">
                        <!-- Car Preview Image -->
                        <Image Source="{Binding SelectedCar.PreviewImagePath}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{Binding SelectedCar.HasPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Placeholder when no image -->
                        <StackPanel VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding SelectedCar.HasPreviewImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="{t:Text garage.no_preview}"
                                      FontSize="{StaticResource FontSizeScreenTitle}"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource BorderLightBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="{t:Text garage.no_preview.hint}"
                                      FontSize="{StaticResource FontSizeSubheading}"
                                      Foreground="{StaticResource TextDisabledBrush}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                    </Grid>

                    <!-- ==================== CALENDAR PANEL ==================== -->
                    <Grid Visibility="{Binding ActivePanel, Converter={StaticResource GaragePanelToVisibilityConverter}, ConverterParameter=Calendar}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- The month's pictures, framed in the outline -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,12">
                            <StackPanel.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource UiOutlineBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="10" Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <Border>
                                <Image Source="{Binding CalendarImage1}" Stretch="Uniform" Height="120"/>
                            </Border>
                            <Border>
                                <Image Source="{Binding CalendarImage2}" Stretch="Uniform" Height="120"/>
                            </Border>
                            <Border>
                                <Image Source="{Binding CalendarImage3}" Stretch="Uniform" Height="120"/>
                            </Border>
                        </StackPanel>

                        <!-- Bottom: Date/Time and Calendar Grid -->
                        <Grid Grid.Row="1" Margin="20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Month/Year Header -->
                            <TextBlock Grid.Row="0"
                                       Text="{Binding CurrentMonthYear}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <!-- Current Time Display -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,14">
                                <TextBlock Text="{Binding CurrentDayOfWeek}"
                                           FontSize="{StaticResource FontSizeSubheading}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CurrentTimeDisplay}"
                                           FontSize="{StaticResource FontSizeSubheading}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AmberBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Content="{t:Text garage.end_day}"
                                        Command="{Binding EndDayCommand}"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        ToolTip="{t:Text garage.end_day.tip}"
                                        Height="32"
                                        Padding="16,0"
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Calendar Grid -->
                            <Grid Grid.Row="2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Day of Week Headers -->
                            <ItemsControl Grid.Row="0" Margin="0,0,0,2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Width" Value="70"/>
                                        <Setter Property="Margin" Value="3"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                    </Style>
                                </ItemsControl.Resources>
                                <TextBlock Text="{t:Text garage.calendar.sun}"/>
                                <TextBlock Text="{t:Text garage.calendar.mon}"/>
                                <TextBlock Text="{t:Text garage.calendar.tue}"/>
                                <TextBlock Text="{t:Text garage.calendar.wed}"/>
                                <TextBlock Text="{t:Text garage.calendar.thu}"/>
                                <TextBlock Text="{t:Text garage.calendar.fri}"/>
                                <TextBlock Text="{t:Text garage.calendar.sat}"/>
                            </ItemsControl>

                            <!-- Days Grid: glass cells in a faint outline, the days gone faded, today red glass in an
                                 amber ring with a glow -->
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="6" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="70"
                                                Height="45"
                                                Margin="3"
                                                CornerRadius="6"
                                                BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource UiGlassBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource UiOutlineSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrentDay}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource UiPrimaryGlassHoverBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{StaticResource Amber}" ShadowDepth="0" BlurRadius="18" Opacity="0.7"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Day}"
                                                       FontSize="{StaticResource FontSizeHeading}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentDay}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Floating Car Bar (3D controls + car details) -->
            <StackPanel x:Name="CarInfoBar"
                        Grid.Row="1"
                        MaxWidth="800"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,30"
                        Visibility="{Binding ActivePanel, Converter={StaticResource GaragePanelToVisibilityConverter}, ConverterParameter=CarPreview}">
                <!-- 3D Viewport Controls: the engine on the left, the view toggles on the right -->
                <Grid Margin="0,0,0,8"
                      Visibility="{Binding HasCar, ElementName=Viewport3D, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- The engine takes 340 when there is room and gives way to the toggles when there is not -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" MaxWidth="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:EnginePanel x:Name="EnginePanel"
                                      Grid.Column="0"
                                      VerticalAlignment="Bottom"
                                      Engine="{Binding SelectedEngine}"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                    <ToggleButton Content="{t:Text garage.view.lights}"
                                  audio:Sfx.Click="ui.lights"
                                  Style="{StaticResource ViewportToggleStyle}"
                                  IsChecked="{Binding HeadlightsOn, ElementName=Viewport3D, Mode=TwoWay}"/>
                    <ToggleButton Content="{t:Text garage.view.doors}"
                                  Style="{StaticResource ViewportToggleStyle}"
                                  Visibility="{Binding HasDoors, ElementName=Viewport3D, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  IsChecked="{Binding DoorsOpen, ElementName=Viewport3D, Mode=TwoWay}"/>
                    <ToggleButton Content="{t:Text garage.view.parts}"
                                  Style="{StaticResource ViewportToggleStyle}"
                                  Visibility="{Binding Workbench.IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  IsChecked="{Binding Workbench.IsCarView, Mode=TwoWay}"/>
                    <ToggleButton Content="{t:Text garage.view.stand}"
                                  Style="{StaticResource ViewportToggleStyle}"
                                  ToolTip="{t:Text garage.view.stand.tip}"
                                  Visibility="{Binding Workbench.IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  IsChecked="{Binding Workbench.IsStandView, Mode=TwoWay}"/>
                    <ToggleButton Content="{t:Text garage.view.turn_over}"
                                  Style="{StaticResource ViewportToggleStyle}"
                                  ToolTip="{t:Text garage.view.turn_over.tip}"
                                  Visibility="{Binding Workbench.CanTurnEngineOver, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  IsChecked="{Binding Workbench.IsEngineTurnedOver, Mode=TwoWay}"/>
                    <ToggleButton Content="{t:Text garage.view.rotate}"
                                  Style="{StaticResource ViewportToggleStyle}"
                                  IsChecked="{Binding AutoRotate, ElementName=Viewport3D, Mode=TwoWay}"/>
                </StackPanel>
                </Grid>

                <!-- The police impound: the selected car is held there until it is collected -->
                <Border Background="{StaticResource WarningBgBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="20,8"
                        Margin="0,0,0,6"
                        Visibility="{Binding IsSelectedCarImpounded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="{Binding CollectButtonText}"
                                Command="{Binding CollectCommand}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Padding="15,5"
                                FontSize="{StaticResource FontSizeBody}"
                                VerticalAlignment="Center"
                                ToolTip="{t:Text garage.collect.tip}"/>
                        <TextBlock Text="{Binding ImpoundNote}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,20,0"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- What can be done with the car (its details are in Car info, on the right) -->
                <Border Background="{StaticResource UiGlassBrush}"
                       BorderBrush="{StaticResource UiOutlineBrush}"
                       BorderThickness="3"
                       CornerRadius="8"
                       Padding="16,8"
                       HorizontalAlignment="Center"
                       Visibility="{Binding HasCars, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Repairs: what the races did to the car, and fixing it -->
                        <Button Content="{t:Text garage.repairs}"
                                Command="{Binding RepairsCommand}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Padding="15,5"
                                Margin="0,0,10,0"
                                FontSize="{StaticResource FontSizeBody}"
                                VerticalAlignment="Center"
                                ToolTip="{t:Text garage.repairs.tip}"/>

                        <!-- Sell: to a dealer at once, or through an ad in the paper -->
                        <Button Content="{Binding SellButtonText}"
                                Command="{Binding SellCommand}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Padding="15,5"
                                FontSize="{StaticResource FontSizeBody}"
                                VerticalAlignment="Center"
                                ToolTip="{t:Text garage.sell.tip}"/>

                        <!-- Free run: the car alone on a track of the player's choosing -->
                        <ComboBox ItemsSource="{Binding FreeRunTracks}"
                                  SelectedItem="{Binding FreeRunTrack}"
                                  DisplayMemberPath="Name"
                                  Width="230"
                                  Height="30"
                                  FontSize="{StaticResource FontSizeCompact}"
                                  Margin="20,0,8,0"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ToolTip="{t:Text garage.free_run.track.tip}"
                                  Visibility="{Binding HasFreeRunTracks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="{t:Text garage.free_run}"
                                Command="{Binding FreeRunCommand}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Padding="15,5"
                                FontSize="{StaticResource FontSizeBody}"
                                VerticalAlignment="Center"
                                ToolTip="{t:Text garage.free_run.tip}"/>

                        <!-- Test-and-tune: passes at the strip for timeslips -->
                        <Button Content="{t:Text garage.test_and_tune}"
                                Command="{Binding TestAndTuneCommand}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Padding="15,5"
                                Margin="10,0,0,0"
                                FontSize="{StaticResource FontSizeBody}"
                                VerticalAlignment="Center"
                                ToolTip="{t:Text garage.test_and_tune.tip}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </Grid>

        <!-- Parts workbench (engine sheet, picked part, shelf) around the 3D view while the parts are on show;
             its cards come and go by themselves -->
        <local:PartsWorkbenchView Grid.Row="0"
                                  DataContext="{Binding Workbench}"/>

        <!-- ==================== OVERLAY NAVIGATION ==================== -->
        <!-- Round icon buttons around the car. All but Quit make room while the car is being worked on (the workbench's
             cards take the sides then). -->

        <!-- Quit (top left): back to the main menu, or out of the game -->
        <Button x:Name="QuitButton"
                Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource QuitIcon}"
                Command="{Binding QuitCommand}"
                ToolTip="{t:Text garage.tile.quit}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="30,30,0,0"/>

        <!-- Hit the Streets (centre left) -->
        <Button x:Name="HitTheStreetsButton"
                Style="{StaticResource RoundIconButtonLargeStyle}"
                Tag="{StaticResource DrivingWheelIcon}"
                Command="{Binding HitTheStreetsCommand}"
                ToolTip="{t:Text garage.tile.streets}"
                helpers:Reveal.IsShown="{Binding ShowNavigation}"
                helpers:Reveal.OffsetX="-60"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="30,0,0,0"/>

        <!-- Bottom left, from the top: car dealers, part dealers, the newspaper -->
        <StackPanel helpers:Reveal.IsShown="{Binding ShowNavigation}"
                    helpers:Reveal.OffsetX="-60"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="30,0,0,30">
            <Button x:Name="CarDealersButton"
                    Style="{StaticResource RoundIconButtonLargeStyle}"
                    Tag="{StaticResource CarDealerIcon}"
                    Padding="9"
                    Command="{Binding CarDealersCommand}"
                    ToolTip="{t:Text garage.tile.car_dealers}"/>
            <!-- The part shops' own map -->
            <Button x:Name="PartDealersButton"
                    Style="{StaticResource RoundIconButtonLargeStyle}"
                    Tag="{StaticResource PartsIcon}"
                    Command="{Binding PartDealersCommand}"
                    ToolTip="{t:Text garage.tile.part_dealers}"
                    Margin="0,16,0,0"/>
            <Button x:Name="NewspaperButton"
                    Style="{StaticResource RoundIconButtonLargeStyle}"
                    Tag="{StaticResource NewspaperIcon}"
                    Command="{Binding NewspaperCommand}"
                    ToolTip="{t:Text garage.tile.newspaper}"
                    Margin="0,16,0,0"/>
        </StackPanel>

        <!-- Car info (centre right): everything about the selected car and its parts -->
        <Button x:Name="CarInfoButton"
                Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource CarInfoIcon}"
                Command="{Binding CarInfoCommand}"
                ToolTip="{t:Text garage.tile.car_info}"
                helpers:Reveal.IsShown="{Binding ShowNavigation}"
                helpers:Reveal.OffsetX="60"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,30,0"/>

        <!-- The gas station (bottom right): filling up, the oil and the wash are done there -->
        <Button x:Name="GasStationButton"
                Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource FuelPumpIcon}"
                Command="{Binding GasStationCommand}"
                ToolTip="{t:Text garage.tile.gas_station}"
                helpers:Reveal.IsShown="{Binding ShowNavigation}"
                helpers:Reveal.OffsetX="60"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,30"/>

        <!-- Right, under the window's money card: the career, the calendar under it, the radio under that -->
        <StackPanel x:Name="RightButtons"
                    helpers:Reveal.IsShown="{Binding ShowNavigation}"
                    helpers:Reveal.OffsetX="60"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,120,30,0">
            <Button Style="{StaticResource RoundIconButtonStyle}"
                    Tag="{StaticResource TrophyIcon}"
                    Command="{Binding CareerCommand}"
                    ToolTip="{t:Text garage.tile.career}"/>
            <Button x:Name="CalendarButton"
                    Style="{StaticResource RoundIconButtonStyle}"
                    Tag="{StaticResource CalendarIcon}"
                    Command="{Binding ShowCalendarCommand}"
                    ToolTip="{t:Text garage.tile.calendar}"
                    Margin="0,16,0,0"/>
            <!-- The radio on the bench: the player's own music, on every screen but a race (F2 anywhere). What it puts on
                 comes out of it. -->
            <Button x:Name="RadioButton"
                    Style="{StaticResource RoundIconButtonStyle}"
                    Tag="{StaticResource RadioIcon}"
                    Command="{x:Static radio:RadioPanelViewModel.ToggleCommand}"
                    ToolTip="{t:Text garage.tile.radio}"
                    radio:RadioToastAnchor.IsAnchor="True"
                    Margin="0,16,0,0"/>
        </StackPanel>
        </Grid>

        <!-- Loading Layer (shown until the 3D garage is ready) -->
        <controls:LoadingIndicator x:Name="LoadingLayer" Message="Opening the garage..."/>
    </Grid>
</UserControl>
