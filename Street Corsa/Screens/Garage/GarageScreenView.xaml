<UserControl x:Class="StreetCorsa.Screens.Garage.GarageScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:audio="clr-namespace:StreetCorsa.Audio"
             xmlns:radio="clr-namespace:StreetCorsa.Audio.Radio"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:local="clr-namespace:StreetCorsa.Screens.Garage"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             xmlns:theme="clr-namespace:StreetCorsa.Styles"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- A round button round the car, as the flow's tile has it -->
        <DataTemplate x:Key="GarageTileTemplate" DataType="{x:Type local:GarageTile}">
            <Button Style="{StaticResource RoundIconButtonStyle}"
                    Tag="{Binding Icon}"
                    Command="{Binding Command}"
                    ToolTip="{Binding Text}"
                    Width="{Binding Size}"
                    Height="{Binding Size}"
                    Padding="{Binding Padding}"
                    Margin="{Binding Margin}"
                    radio:RadioToastAnchor.IsAnchor="{Binding IsRadio}"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <!-- Everything lives in ContentLayer, which stays invisible until the 3D garage has rendered its
             first frame; then the whole screen (garage, car, overlay) fades in at once. While an engine goes between
             the car and the stand, nothing in it can be used. -->
        <Grid x:Name="ContentLayer"
              Opacity="0"
              IsHitTestVisible="False"
              IsEnabled="{Binding IsMovingEngine, ElementName=Viewport3D, Converter={StaticResource InverseBooleanConverter}}">
        <!-- 3D Garage (whole screen background; renders the empty garage when no car is selected) -->
        <controls:CarViewport3D x:Name="Viewport3D"
                                CarDirectory="{Binding SelectedCar.CarDirectory}"
                                SkinId="{Binding SelectedCar.SkinId}"
                                ShowroomKn5="{Binding GarageShowroomKn5}"
                                PartsCatalog="{Binding Workbench.Catalog}"
                                PartsVisible="{Binding Workbench.IsOpen}"
                                PartShows="{Binding Workbench.PartShows}"
                                StandMode="{Binding Workbench.IsStand}"
                                StandEngine="{Binding Workbench.StandEngine}"
                                EngineTurnedOver="{Binding Workbench.IsEngineTurnedOver}"
                                Engine="{Binding Workbench.Engine}"
                                Gear="{Binding Workbench.Gear}"
                                Shown="{Binding Workbench.Shown}"
                                EngineLayout="{Binding Workbench.EngineLayout}"
                                Candidates="{Binding Workbench.Candidates}"
                                SelectedPart="{Binding Workbench.SelectedPart}"
                                RunningEngine="{Binding Runner, ElementName=EnginePanel}"
                                FadeInOnReady="False"/>

        <!-- Main Content: 800 wide at most, narrower on a small or high-DPI screen so it keeps clear of the side buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*" MaxWidth="800"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Center Content (Car Name + Preview) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The car's name, and selling it at its right -->
                <Grid Grid.Row="0" Margin="0,30,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Selected Car Display Bar (Clickable): outlined glass, the name in cream over it -->
                <Button x:Name="CarDisplayButton"
                    Grid.Column="0"
                    Command="{Binding SelectCarCommand}"
                    HorizontalAlignment="Stretch"
                    ToolTip="{t:Text garage.cars.tip}"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                    <Border x:Name="CarDisplayBorder"
                                           Background="{StaticResource UiGlassBrush}"
                                           BorderBrush="{StaticResource UiOutlineBrush}"
                                           BorderThickness="3"
                                           CornerRadius="8"
                                           Padding="30,12"
                                           MaxWidth="800">
                                        <TextBlock Text="{Binding SelectedCarDisplay}"
                                                  FontSize="{StaticResource FontSizeTitleSmall}"
                                                  FontWeight="Bold"
                                                  Foreground="{StaticResource CreamBrush}"
                                                  TextTrimming="CharacterEllipsis"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="6" Opacity="0.9"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Border>
                                    <!-- The hover's glass and amber outline, faded in over it -->
                                    <Border x:Name="CarDisplayHover"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            Background="{StaticResource White20Brush}"
                                            BorderBrush="{StaticResource AmberBrush}"
                                            BorderThickness="3"
                                            CornerRadius="8"
                                            MaxWidth="800"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.5">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <!-- Only the hover fades: a button goes disabled or comes back at once -->
                                        <VisualTransition To="Disabled" GeneratedDuration="0"/>
                                        <VisualTransition From="Disabled" GeneratedDuration="0"/>
                                    </VisualStateGroup.Transitions>
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CarDisplayHover" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CarDisplayHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled"/>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

                <!-- Sell: to a dealer at once, or through an ad in the paper. A dot on it while the car is in the paper,
                     amber and glowing when someone has made an offer. -->
                <Grid Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasCars, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource RoundIconButtonStyle}"
                            Tag="{theme:Image icons/handshake, Size=128}"
                            Content="{Binding SellButtonText}"
                            Command="{Binding SellCommand}"
                            Width="56"
                            Height="56"
                            Padding="13">
                        <Button.ToolTip>
                            <StackPanel MaxWidth="320">
                                <TextBlock Text="{Binding SellButtonText}" FontWeight="SemiBold"/>
                                <TextBlock Text="{t:Text garage.sell.tip}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                    <Ellipse Width="12"
                             Height="12"
                             Margin="0,1,1,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             IsHitTestVisible="False"
                             StrokeThickness="1.5"
                             Stroke="{StaticResource UiGlassBrush}"
                             Visibility="{Binding IsSelectedCarInPaper, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource UiOutlineBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSaleOffer}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AmberBrush}"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="{StaticResource Amber}" ShadowDepth="0" BlurRadius="10" Opacity="0.9"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                </Grid>

            <!-- Car Preview Container -->
            <Border x:Name="PreviewContainer"
                    Grid.Row="1"
                    Background="{StaticResource UiGlassCardBrush}"
                    BorderBrush="{StaticResource UiOutlineBrush}"
                    BorderThickness="3"
                    CornerRadius="10"
                    HorizontalAlignment="Stretch"
                    MaxWidth="800"
                    Margin="0,0,0,40">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <!-- Shown for the calendar, or as the 2D fallback when the 3D garage could not start. The calendar
                     rises and fades in as it opens, unless the card is already up as the fallback; the fade lets go of
                     the card when the calendar closes. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePanel}" Value="Calendar">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ActivePanel}" Value="Calendar"/>
                                    <Condition Binding="{Binding HasFailed, ElementName=Viewport3D}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="CalendarRise">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="24" To="0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="CalendarRise"/>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport3D}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Shadow}"
                                    Direction="270"
                                    ShadowDepth="5"
                                    BlurRadius="15"
                                    Opacity="0.6"/>
                </Border.Effect>

                <Grid>
                    <!-- ==================== CAR PREVIEW PANEL ==================== -->
                    <Grid Visibility="{Binding ActivePanel, Converter={StaticResource GaragePanelToVisibilityConverter}, ConverterParameter=CarPreview}">
                        <!-- Car Preview Image -->
                        <Image Source="{Binding SelectedCar.PreviewImagePath}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{Binding SelectedCar.HasPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Placeholder when no image -->
                        <StackPanel VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding SelectedCar.HasPreviewImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="{t:Text garage.no_preview}"
                                      FontSize="{StaticResource FontSizeScreenTitle}"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource BorderLightBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="{t:Text garage.no_preview.hint}"
                                      FontSize="{StaticResource FontSizeSubheading}"
                                      Foreground="{StaticResource TextDisabledBrush}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                    </Grid>

                    <!-- ==================== CALENDAR PANEL ==================== -->
                    <Grid Visibility="{Binding ActivePanel, Converter={StaticResource GaragePanelToVisibilityConverter}, ConverterParameter=Calendar}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- The month's pictures, framed in the outline -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,12">
                            <StackPanel.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource UiOutlineBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="{StaticResource Shadow}" ShadowDepth="3" BlurRadius="10" Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <Border>
                                <Image Source="{Binding CalendarImage1}" Stretch="Uniform" Height="120"/>
                            </Border>
                            <Border>
                                <Image Source="{Binding CalendarImage2}" Stretch="Uniform" Height="120"/>
                            </Border>
                            <Border>
                                <Image Source="{Binding CalendarImage3}" Stretch="Uniform" Height="120"/>
                            </Border>
                        </StackPanel>

                        <!-- Bottom: Date/Time and Calendar Grid -->
                        <Grid Grid.Row="1" Margin="20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Month/Year Header -->
                            <TextBlock Grid.Row="0"
                                       Text="{Binding CurrentMonthYear}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <!-- Current Time Display -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,14">
                                <TextBlock Text="{Binding CurrentDayOfWeek}"
                                           FontSize="{StaticResource FontSizeSubheading}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CurrentTimeDisplay}"
                                           FontSize="{StaticResource FontSizeSubheading}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AmberBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Content="{t:Text garage.end_day}"
                                        Command="{Binding EndDayCommand}"
                                        Visibility="{Binding CanEndDayHere, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        ToolTip="{t:Text garage.end_day.tip}"
                                        Height="32"
                                        Padding="16,0"
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Calendar Grid -->
                            <Grid Grid.Row="2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Day of Week Headers -->
                            <ItemsControl Grid.Row="0" Margin="0,0,0,2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Width" Value="70"/>
                                        <Setter Property="Margin" Value="3"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                    </Style>
                                </ItemsControl.Resources>
                                <TextBlock Text="{t:Text garage.calendar.sun}"/>
                                <TextBlock Text="{t:Text garage.calendar.mon}"/>
                                <TextBlock Text="{t:Text garage.calendar.tue}"/>
                                <TextBlock Text="{t:Text garage.calendar.wed}"/>
                                <TextBlock Text="{t:Text garage.calendar.thu}"/>
                                <TextBlock Text="{t:Text garage.calendar.fri}"/>
                                <TextBlock Text="{t:Text garage.calendar.sat}"/>
                            </ItemsControl>

                            <!-- Days Grid: glass cells in a faint outline, the days gone faded, today red glass in an
                                 amber ring with a glow -->
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="6" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="70"
                                                Height="45"
                                                Margin="3"
                                                CornerRadius="6"
                                                BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource UiGlassBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource UiOutlineSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrentDay}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource UiPrimaryGlassHoverBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{StaticResource Amber}" ShadowDepth="0" BlurRadius="18" Opacity="0.7"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Day}"
                                                       FontSize="{StaticResource FontSizeHeading}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentDay}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Under the car: the impound's note, then the key and what can be done with the car -->
            <StackPanel x:Name="CarInfoBar"
                        Grid.Row="1"
                        MaxWidth="800"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,30"
                        Visibility="{Binding ActivePanel, Converter={StaticResource GaragePanelToVisibilityConverter}, ConverterParameter=CarPreview}">
                <!-- The police impound: the selected car is held there until it is collected -->
                <Border Background="{StaticResource WarningBgBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="20,8"
                        Margin="0,0,0,6"
                        Visibility="{Binding IsSelectedCarImpounded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="{Binding CollectButtonText}"
                                Command="{Binding CollectCommand}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Padding="15,5"
                                FontSize="{StaticResource FontSizeBody}"
                                VerticalAlignment="Center"
                                ToolTip="{t:Text garage.collect.tip}"/>
                        <TextBlock Text="{Binding ImpoundNote}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,20,0"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- What can be done with the car (its details are in Car info, on the right) -->
                <!-- The key at the left, then the car's buttons. Turning the key starts the engine: the buttons sink away
                     and the engine (tach and pedal) rises in their place; turned back, the engine goes off and the buttons
                     come back (GarageScreenView.xaml.cs). The car's details are in Car info, on the right. -->
                <!-- Only with a car in the garage: the selected car home (not at the impound) and standing there in 3D, or
                     the garage in 2D when the 3D one could not start -->
                <Grid HorizontalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCarHere}" Value="True"/>
                                        <Condition Binding="{Binding HasCar, ElementName=Viewport3D}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCarHere}" Value="True"/>
                                        <Condition Binding="{Binding HasFailed, ElementName=Viewport3D}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The ignition: in while the engine is the player's to run -->
                    <ToggleButton x:Name="KeyButton"
                                  Grid.Column="0"
                                  Style="{StaticResource RoundIconToggleStyle}"
                                  Tag="{theme:Image icons/car_key, Size=128}"
                                  Content="{t:Text garage.key}"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Focusable="False"
                                  IsEnabled="{Binding Runner.CanToggle, ElementName=EnginePanel}"
                                  Visibility="{Binding HasCar, ElementName=Viewport3D, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Click="OnKeyClick">
                        <ToggleButton.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{t:Text garage.key.start.tip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.IsChecked, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="True">
                                                <Setter Property="Text" Value="{t:Text garage.key.stop.tip}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton.ToolTip>
                    </ToggleButton>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <!-- What can be done with the car; the 3D view's own only when the car is shown in 3D -->
                        <StackPanel x:Name="CarButtons" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform/>
                            </StackPanel.RenderTransform>
                            <StackPanel.Resources>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource RoundIconToggleStyle}">
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasCar, ElementName=Viewport3D, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ToggleButton Tag="{theme:Image icons/car_parts, Size=128}"
                                              Content="{t:Text garage.view.parts}"
                                              ToolTip="{t:Text garage.view.parts.tip}"
                                              Visibility="{Binding Workbench.IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              IsChecked="{Binding Workbench.IsCarView, Mode=TwoWay}"/>
                            </StackPanel>

                            <!-- Repairs: what the races did to the car, and fixing it -->
                            <Button Style="{StaticResource RoundIconButtonStyle}"
                                    Tag="{theme:Image icons/wrench, Size=128}"
                                    Content="{t:Text garage.repairs}"
                                    Command="{Binding RepairsCommand}"
                                    Margin="0,0,10,0"
                                    ToolTip="{t:Text garage.repairs.tip}"/>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasCar, ElementName=Viewport3D, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ToggleButton Tag="{theme:Image icons/high_beam, Size=128}"
                                              Content="{t:Text garage.view.lights}"
                                              ToolTip="{t:Text garage.view.lights.tip}"
                                              audio:Sfx.Click="ui.lights"
                                              IsChecked="{Binding HeadlightsOn, ElementName=Viewport3D, Mode=TwoWay}"/>
                                <ToggleButton Tag="{theme:Image icons/car_door, Size=128}"
                                              Content="{t:Text garage.view.doors}"
                                              ToolTip="{t:Text garage.view.doors.tip}"
                                              Visibility="{Binding HasDoors, ElementName=Viewport3D, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              IsChecked="{Binding DoorsOpen, ElementName=Viewport3D, Mode=TwoWay}"/>
                                <ToggleButton Tag="{theme:Image icons/rotate, Size=128}"
                                              Content="{t:Text garage.view.rotate}"
                                              ToolTip="{t:Text garage.view.rotate.tip}"
                                              Margin="0"
                                              IsChecked="{Binding AutoRotate, ElementName=Viewport3D, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- The engine, once the key is turned: rpm, tach and pedal. Faded out it stays where it is,
                             only out of reach: a panel out of sight switches its engine off. -->
                        <controls:EnginePanel x:Name="EnginePanel"
                                              Engine="{Binding SelectedEngine}"
                                              ShowStartButton="False"
                                              MinWidth="340"
                                              VerticalAlignment="Center"
                                              Opacity="0"
                                              IsHitTestVisible="False">
                            <controls:EnginePanel.RenderTransform>
                                <TranslateTransform Y="24"/>
                            </controls:EnginePanel.RenderTransform>
                        </controls:EnginePanel>
                    </Grid>

                    <!-- The parts view's own row: the Parts button lit, the stand, turning the engine over and the buttons
                         that put kinds of part out of sight. When the parts view opens the row above sinks away first,
                         then this one rises; closing it, the other way round (GarageScreenView.xaml.cs). -->
                    <StackPanel x:Name="PartsRow"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0"
                                IsHitTestVisible="False"
                                IsEnabled="False">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="24"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Resources>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource RoundIconToggleStyle}">
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </StackPanel.Resources>
                        <ToggleButton Tag="{theme:Image icons/car_parts, Size=128}"
                                      Content="{t:Text garage.view.parts}"
                                      ToolTip="{t:Text garage.view.parts.tip}"
                                      IsChecked="{Binding Workbench.IsCarView, Mode=TwoWay}"/>
                        <ToggleButton Tag="{theme:Image icons/engine_stand, Size=128}"
                                      Content="{t:Text garage.view.stand}"
                                      ToolTip="{t:Text garage.view.stand.tip}"
                                      Visibility="{Binding Workbench.CanShowStand, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      IsChecked="{Binding Workbench.IsStandView, Mode=TwoWay}"/>
                        <ToggleButton Tag="{theme:Image icons/gears, Size=128}"
                                      Content="{t:Text garage.view.turn_over}"
                                      ToolTip="{t:Text garage.view.turn_over.tip}"
                                      Visibility="{Binding Workbench.CanTurnEngineOver, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      IsChecked="{Binding Workbench.IsEngineTurnedOver, Mode=TwoWay}"/>
                        <!-- With the car's parts on show (not the stand): a button for each kind that can be put
                             out of sight, lit while it is in sight (part_groups.json's shows) -->
                        <ItemsControl ItemsSource="{Binding Workbench.PartShows}"
                                      Focusable="False"
                                      Visibility="{Binding Workbench.IsCarView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource RoundIconToggleStyle}"
                                                  Margin="0,0,10,0"
                                                  Tag="{Binding Icon}"
                                                  Content="{Binding Name}"
                                                  ToolTip="{Binding Tip}"
                                                  IsChecked="{Binding IsShown, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
            </Grid>
        </Grid>

        <!-- Parts workbench (engine sheet, picked part, shelf) around the 3D view while the parts are on show;
             its cards come and go by themselves -->
        <local:PartsWorkbenchView Grid.Row="0"
                                  DataContext="{Binding Workbench}"/>

        <!-- ==================== OVERLAY NAVIGATION ==================== -->
        <!-- Round icon buttons around the car. All but Quit make room while the car is being worked on (the workbench's
             cards take the sides then). -->

        <!-- The tiles, as the flow has them (flow/*.json, "tiles"), each spot a column of them from the top. Top left
             (the way out) stays while the car is being worked on; the rest make room for the workbench's cards. In the
             base game: Quit top left; Go race! at the left; car dealers, part dealers and the newspaper bottom left; car
             info at the right; the gas station bottom right; the career, the calendar and the radio top right, under the
             window's money card. -->
        <ItemsControl ItemsSource="{Binding TopLeftTiles}"
                      ItemTemplate="{StaticResource GarageTileTemplate}"
                      Focusable="False"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="30,30,0,0"/>

        <ItemsControl ItemsSource="{Binding LeftTiles}"
                      ItemTemplate="{StaticResource GarageTileTemplate}"
                      Focusable="False"
                      helpers:Reveal.IsShown="{Binding ShowNavigation}"
                      helpers:Reveal.OffsetX="-60"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="30,0,0,0"/>

        <ItemsControl ItemsSource="{Binding BottomLeftTiles}"
                      ItemTemplate="{StaticResource GarageTileTemplate}"
                      Focusable="False"
                      helpers:Reveal.IsShown="{Binding ShowNavigation}"
                      helpers:Reveal.OffsetX="-60"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      Margin="30,0,0,30"/>

        <ItemsControl ItemsSource="{Binding RightTiles}"
                      ItemTemplate="{StaticResource GarageTileTemplate}"
                      Focusable="False"
                      helpers:Reveal.IsShown="{Binding ShowNavigation}"
                      helpers:Reveal.OffsetX="60"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,30,0"/>

        <ItemsControl ItemsSource="{Binding BottomRightTiles}"
                      ItemTemplate="{StaticResource GarageTileTemplate}"
                      Focusable="False"
                      helpers:Reveal.IsShown="{Binding ShowNavigation}"
                      helpers:Reveal.OffsetX="60"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,30,30"/>

        <ItemsControl ItemsSource="{Binding TopRightTiles}"
                      ItemTemplate="{StaticResource GarageTileTemplate}"
                      Focusable="False"
                      helpers:Reveal.IsShown="{Binding ShowNavigation}"
                      helpers:Reveal.OffsetX="60"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,120,30,0"/>
        </Grid>

        <!-- Loading Layer (shown until the 3D garage is ready) -->
        <controls:LoadingIndicator x:Name="LoadingLayer" Message="Opening the garage..."/>

        <!-- Comes down over the car when a mod's script drives it out (garage.leave) -->
        <Border x:Name="Curtain" Background="{StaticResource StageBrush}" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
