<UserControl x:Class="StreetCorsa.Screens.Garage.PartsWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1280">
    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Glass14D0Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,12,2"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- A job the picked part can have done: its button, and why it cannot be done now under it -->
        <DataTemplate x:Key="RebuildOfferTemplate">
            <StackPanel Margin="0,3">
                <Button Command="{Binding DataContext.RebuildCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Padding="10,5">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="{StaticResource FontSizeCompact}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding PriceDisplay}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding WhyNot}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{StaticResource SalmonBrush}"
                           TextWrapping="Wrap"
                           Margin="2,2,0,0"
                           Visibility="{Binding WhyNot, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- No background: the 3D view below takes every click that does not land on a panel -->
    <Grid>
        <!-- Shelf: loose parts, pick one to see where it goes -->
        <Border Style="{StaticResource PanelStyle}"
                helpers:Reveal.IsShown="{Binding IsOpen}"
                helpers:Reveal.OffsetX="-60"
                IsEnabled="{Binding IsIdle}"
                Width="260"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Margin="20,180,0,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{t:Text workbench.shelf}" Style="{StaticResource PanelTitleStyle}"/>

                <TextBlock Grid.Row="1"
                           Text="{t:Text workbench.shelf.empty}"
                           Style="{StaticResource LabelStyle}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasShelfItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Shelf}"
                         SelectedItem="{Binding SelectedShelfItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasShelfItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="row"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,5"
                                                Margin="0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource White30Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource Fit30Brush}"/>
                                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource FitBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding Kind, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding Detail, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding WorthDisplay}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource AccentSuccessBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="0,8,0,0"
                            Visibility="{Binding ShelfHint, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ShelfHint}"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{StaticResource FitBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{t:Text workbench.never_mind}"
                                Command="{Binding CancelMountCommand}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="12,4"
                                FontSize="{StaticResource FontSizeCompact}"/>
                        <Button Content="{t:Text workbench.put_on_stand}"
                                Command="{Binding PutOnStandCommand}"
                                Visibility="{Binding IsShelfEngine, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{t:Text workbench.put_on_stand.tip}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Padding="12,4"
                                FontSize="{StaticResource FontSizeCompact}"
                                Margin="8,0,0,0"/>
                        <Button Content="{t:Text workbench.take_apart}"
                                Command="{Binding TakeApartCommand}"
                                Visibility="{Binding CanTakeApart, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{t:Text workbench.take_apart.tip}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="12,4"
                                FontSize="{StaticResource FontSizeCompact}"
                                Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- The work the picked part can have done, here on the shelf -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasShelfRebuilds, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{t:Text workbench.rebuild}" Style="{StaticResource PanelTitleStyle}"/>
                        <ItemsControl ItemsSource="{Binding Rebuilds}" ItemTemplate="{StaticResource RebuildOfferTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Engine sheet and the part that is clicked on -->
        <StackPanel helpers:Reveal.IsShown="{Binding IsOpen}"
                    helpers:Reveal.OffsetX="60"
                    IsEnabled="{Binding IsIdle}"
                    Width="260"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,120,20,0">
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding EngineTitle}" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding EngineName}"
                               FontSize="{StaticResource FontSizeSubheading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <Grid Visibility="{Binding HasEngine, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{t:Text workbench.power}" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PowerDisplay}" Style="{StaticResource ValueStyle}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{t:Text workbench.torque}" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TorqueDisplay}" Style="{StaticResource ValueStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{t:Text workbench.size}" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplacementDisplay}" Style="{StaticResource ValueStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{t:Text workbench.gearbox}" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GearsDisplay}" Style="{StaticResource ValueStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{t:Text workbench.weight}" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MassDisplay}" Style="{StaticResource ValueStyle}"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusDisplay}"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{StaticResource SalmonBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding StatusDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelStyle}"
                    Margin="0,12,0,0"
                    helpers:Reveal.IsShown="{Binding HasSelection}"
                    helpers:Reveal.OffsetY="-14">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedKind}" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding SelectedName}"
                               FontSize="{StaticResource FontSizeBodyLarge}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{t:Text workbench.condition}" Style="{StaticResource LabelStyle}"/>
                        <ProgressBar Grid.Column="1"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding SelectedCondition, Mode=OneWay}"
                                     Height="8"
                                     Foreground="{StaticResource AccentSuccessBrush}"
                                     Background="{StaticResource Gray30Brush}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding SelectedConditionDisplay}" Style="{StaticResource ValueStyle}" Margin="10,2,0,2"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{t:Text workbench.worth}" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding SelectedWorthDisplay}" Style="{StaticResource ValueStyle}" Foreground="{StaticResource AccentSuccessBrush}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedAttachedDisplay}"
                               Style="{StaticResource LabelStyle}"
                               TextWrapping="Wrap"
                               Visibility="{Binding SelectedAttachedDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Placement mode (F5): a tool for fitting the converted parts -->
                    <Border Background="{StaticResource Gold33Brush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="6" Margin="0,6,0,0"
                            Visibility="{Binding PlacementDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding PlacementDisplay}" FontSize="{StaticResource FontSizeCaption}" FontFamily="{StaticResource NumbersFont}" Foreground="{StaticResource PaleYellowBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- What the work order says is in the way -->
                    <TextBlock Text="{Binding SelectedBlockedDisplay}"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{StaticResource SalmonBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding SelectedBlockedDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding RemoveButtonText}"
                                Command="{Binding RemoveSelectedCommand}"
                                Style="{StaticResource DialogPrimaryButtonStyle}"
                                Padding="15,5"
                                FontSize="{StaticResource FontSizeBody}"/>
                        <Button Content="{t:Text workbench.put_in_car}"
                                Command="{Binding InstallFromStandCommand}"
                                Visibility="{Binding CanInstallFromStand, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{t:Text workbench.put_in_car.tip}"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Padding="15,5"
                                FontSize="{StaticResource FontSizeBody}"
                                Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- The work the picked part can have done where it is -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasPartRebuilds, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{t:Text workbench.rebuild}" Style="{StaticResource PanelTitleStyle}"/>
                        <ItemsControl ItemsSource="{Binding Rebuilds}" ItemTemplate="{StaticResource RebuildOfferTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{t:Text workbench.help}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource WhiteB0Brush}"
                       TextWrapping="Wrap"
                       Margin="4,10,0,0"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- A job being done: its name, the step on now, how far it is, the game's clock and the part's condition going up -->
        <Border Style="{StaticResource PanelStyle}"
                helpers:Reveal.IsShown="{Binding IsWorking}"
                helpers:Reveal.OffsetY="30"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,40">
            <StackPanel>
                <TextBlock Text="{Binding WorkTitle}" Style="{StaticResource PanelTitleStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WorkCaption}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <ProgressBar Minimum="0" Maximum="1"
                             Value="{Binding WorkProgress, Mode=OneWay}"
                             Height="6"
                             Foreground="{StaticResource AccentPrimaryBrush}"
                             Background="{StaticResource Gray30Brush}"
                             BorderThickness="0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding WorkClock}"
                               FontFamily="{StaticResource NumbersFont}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{t:Text workbench.condition}" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding WorkCondition}" Style="{StaticResource ValueStyle}" Foreground="{StaticResource AccentSuccessBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{t:Text workbench.work.skip}"
                            Command="{Binding SkipWorkCommand}"
                            ToolTip="{t:Text workbench.work.skip.tip}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Padding="12,4"
                            FontSize="{StaticResource FontSizeCompact}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
