<UserControl x:Class="StreetCorsa.Screens.DealerLot.DealerLotScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{StaticResource BgDarkBrush}">

        <!-- The lot itself, behind everything -->
        <controls:LotViewport3D x:Name="Viewport"
                                      ShowroomKn5="{Binding ShowroomKn5}"
                                      Cars="{Binding LotCars}"
                                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                      LotRadius="{Binding LotRadius}"
                                      RunningEngine="{Binding Runner, ElementName=EnginePanel}"/>

        <!-- The lot is covered until every car is standing in it, then the cover fades and the viewport
             fades up underneath. Watching an empty room fill a car at a time is not worth showing. -->
        <Grid Background="{StaticResource BgDarkBrush}"
              helpers:Reveal.IsShown="{Binding IsLotReady, ElementName=Viewport, Converter={StaticResource InverseBooleanConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Width="60" Height="60" Margin="0,0,0,26" HorizontalAlignment="Center">
                    <!-- Nothing is coming once the viewport has failed; a spinner over that message would promise otherwise -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="30" CenterY="30"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360"
                                                     Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Ellipse Stroke="{StaticResource SpinnerOrangeBrush}" StrokeThickness="4"
                             StrokeDashArray="3 2"
                             Fill="Transparent"/>
                </Border>
                <TextBlock FontSize="{StaticResource FontSizeTitleSmall}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{t:Text dealer.lot.loading}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport}" Value="True">
                                    <Setter Property="Text" Value="{t:Text dealer.lot.no_3d}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Header: the dealer, over the whole lot -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,26,0,0"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding DealerName}"
                       FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding StockSummary}"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding SaleNotice}"
                       Visibility="{Binding HasSaleNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                       FontSize="{StaticResource FontSizeCompact}"
                       FontWeight="Bold"
                       Foreground="{StaticResource GoldBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Back to the map -->
        <Button Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource BackIcon}"
                ToolTip="{t:Text common.back}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>
        <!-- The left card, under the back button. With the player's AI on, the salesman's talk: he comes over as the
             player arrives, follows them round the lot, tells them about the car, and closes the deal ("Buy it for $X").
             Two thirds of the room down there; the tab with his name opens and closes it, the card sliding off to the
             left as it fades, and back -->
        <Grid HorizontalAlignment="Left"
              Width="360"
              Margin="20,100,0,20"
              Visibility="{Binding HasTalk, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ToggleButton Grid.Row="0"
                          Style="{StaticResource GlassToggleButtonStyle}"
                          IsChecked="{Binding Talk.IsOpen, Mode=TwoWay}"
                          ToolTip="{t:Text chat.ui.toggle}"
                          HorizontalAlignment="Left"
                          Height="36"
                          Padding="14,0"
                          FontSize="{StaticResource FontSizeCompact}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Talk.Title}" VerticalAlignment="Center"/>
                    <!-- The chevron turns down with the talk open, right with it shut -->
                    <TextBlock Text="▾" Margin="10,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Talk.IsOpen}" Value="False">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="-90" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ToggleButton>
            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="{StaticResource Glass15E8Brush}"
                    BorderBrush="{StaticResource Cream70Brush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,14">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="0.8"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Talk.IsOpen}" Value="False">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="-60" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Hidden}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:TalkPanel DataContext="{Binding Talk}"/>
            </Border>
        </Grid>

        <!-- With the AI off, nobody to tell the player about the car: the same card has its facts and Buy -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="360"
                Margin="20,100,0,20"
                Background="{StaticResource Glass15E8Brush}"
                BorderBrush="{StaticResource Cream70Brush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,14"
                Visibility="{Binding ShowsCarInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel DataContext="{Binding SelectedCar}">
                <TextBlock Text="{Binding YearDisplay}"
                           FontSize="{StaticResource FontSizeCompact}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{t:Text dealer.lot.condition}" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="{Binding ConditionLabel, Mode=OneWay}"/>
                        <Run Text="{Binding ConditionDisplay, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{t:Text dealer.lot.mileage}" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding MileageDisplay}" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
                <TextBlock Text="{Binding EngineDisplay}"
                           Visibility="{Binding EngineDisplay, Converter={StaticResource StringToVisibilityConverter}}"
                           FontSize="{StaticResource FontSizeCompact}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,8,0,0"/>
                <!-- Who had it, how it has raced -->
                <TextBlock Text="{Binding HistoryDisplay}"
                           Visibility="{Binding HistoryDisplay, Converter={StaticResource StringToVisibilityConverter}}"
                           FontSize="{StaticResource FontSizeCompact}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0"/>
                <!-- The ad's few words -->
                <TextBlock Text="{Binding Listing.Description}"
                           Visibility="{Binding Listing.Description, Converter={StaticResource StringToVisibilityConverter}}"
                           FontStyle="Italic"
                           FontSize="{StaticResource FontSizeCompact}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,10,0,0"/>
                <Button Content="{t:Text dealer.lot.buy}"
                        Margin="0,16,0,0"
                        Height="42"
                        FontSize="{StaticResource FontSizeBodyLarge}"
                        FontWeight="Bold"
                        Command="{Binding DataContext.PurchaseCarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </Border>

        <!-- The car picked: the garage's name card (centre, 800 wide at most), up level with the window's money card,
             the name and its price on one line -->
        <Grid VerticalAlignment="Top"
              IsHitTestVisible="False"
              Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*" MaxWidth="800"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1"
                    Margin="0,20,0,0"
                    Background="{StaticResource UiGlassBrush}"
                    BorderBrush="{StaticResource UiOutlineBrush}"
                    BorderThickness="3"
                    CornerRadius="8"
                    Padding="30,12">
                <TextBlock FontSize="{StaticResource FontSizeTitleSmall}"
                           FontWeight="Bold"
                           Foreground="{StaticResource CreamBrush}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="6" Opacity="0.9"/>
                    </TextBlock.Effect>
                    <Run Text="{Binding SelectedCar.DisplayName, Mode=OneWay}"/>
                    <Run Text="   "/>
                    <Run Text="{Binding SelectedCar.WasPriceDisplay, Mode=OneWay}"
                         FontWeight="Normal"
                         TextDecorations="Strikethrough"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding SelectedCar.PriceDisplay, Mode=OneWay}" Foreground="{StaticResource AccentSuccessBrush}"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Start it up before you buy it, at the bottom centre -->
        <controls:EnginePanel x:Name="EnginePanel"
                              Width="340"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,30"
                              Engine="{Binding SelectedEngine}"
                              Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>

    </Grid>
</UserControl>
