<UserControl x:Class="StreetCorsa.Screens.Diner.DinerScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:StreetCorsa.Converters"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- How tough an opponent is, as the colour of their card and reputation -->
        <converters:DifficultyToBrushConverter x:Key="DifficultyTextBrushConverter"
                                               Easy="{StaticResource AccentSuccessBrush}"
                                               Matched="{StaticResource GoldBrush}"
                                               Hard="{StaticResource DangerBrush}"
                                               Other="{StaticResource WhiteBrush}"/>
        <converters:DifficultyToBrushConverter x:Key="DifficultyBorderBrushConverter"
                                               Easy="{StaticResource SuccessStrongBrush}"
                                               Matched="{StaticResource WarningBrush}"
                                               Hard="{StaticResource DangerStrongBrush}"
                                               Other="{StaticResource BorderLightBrush}"/>
        <!-- A crew's colour from its file; none, or one too dark for the card, in the card's own -->
        <converters:ColourToBrushConverter x:Key="CrewBrushConverter" Fallback="{StaticResource TextSecondaryBrush}"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource StageBrush}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Background fade in -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.0"
                                       To="1.0"
                                       Duration="0:0:0.5"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- The diner's street from the driver's seat: the car comes down it into its bay, the diner ahead -->
        <controls:DinerViewport3D x:Name="StreetView"
                                  Scene="{Binding Scene}"
                                  Light="{Binding Light}"
                                  PlayerCar="{Binding PlayerCar}"
                                  Stage="{Binding Stage}"
                                  ParkedCars="{Binding ParkedCars}"/>

        <!-- No street to show (no 3D here, or no street's model): the diner as a picture -->
        <Border Background="{StaticResource DinerBackgroundBrush}"
                Visibility="{Binding HasStreetModel, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        <Border Background="{StaticResource DinerBackgroundBrush}"
                Visibility="{Binding HasFailed, ElementName=StreetView, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- The diner: its name and who is in tonight, once the car is in its bay -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" IsHitTestVisible="False"
                    helpers:Reveal.IsShown="{Binding IsParked}">
            <Border Background="{StaticResource BgPanelCCBrush}"
                    CornerRadius="5"
                    Padding="28,4"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource FontSizeScreenTitle}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
            <Border Background="{StaticResource BgPanelCCBrush}" CornerRadius="4" Padding="14,3" Margin="0,6,0,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- The class of the place, then who is in -->
                    <TextBlock Text="{Binding ClassDisplay, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{StaticResource AmberBrush}"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding RacersIn}"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Drag to look round -->
        <TextBlock Text="{t:Text station.ui.look_hint}"
                   FontSize="{StaticResource FontSizeTiny}"
                   Foreground="{StaticResource White90Brush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,8"
                   IsHitTestVisible="False"
                   helpers:Reveal.IsShown="{Binding ShowsDinerButton}"/>

        <!-- Into the diner -->
        <Button HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,34"
                Padding="30,12"
                Style="{StaticResource DialogPrimaryButtonStyle}"
                FontSize="{StaticResource FontSizeBodyLarge}"
                Content="{t:Text diner.ui.go_in}"
                Command="{Binding ToggleDinerCommand}"
                helpers:Reveal.IsShown="{Binding ShowsDinerButton}"/>

        <!-- Garage Button -->
        <Button x:Name="GarageButton"
                Grid.Row="0"
                Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource GarageIcon}"
                ToolTip="{t:Text diner.back.tooltip}"
                Command="{Binding GarageCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                helpers:Reveal.IsShown="{Binding IsParked}"/>

        <!-- Out to the street, and off to another diner by the map: beside the garage button, above the panels (the money
             card has the top right) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,30,0,0">
            <Button Content="{t:Text diner.cruise}"
                    Command="{Binding CruiseCommand}"
                    Visibility="{Binding CanCruise, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Foreground="{StaticResource BgPanelBrush}"
                    Background="{StaticResource GoldBrush}"
                    helpers:GlassButton.HoverBrush="{StaticResource PaleYellowBrush}"
                    FontWeight="Bold"
                    Padding="24,12"
                    ToolTip="{t:Text diner.cruise.tooltip}"/>
            <Button Content="{t:Text diner.map}"
                    Command="{Binding MapCommand}"
                    Visibility="{Binding CanMap, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    FontWeight="Bold"
                    Padding="24,12"
                    Margin="12,0,0,0"
                    ToolTip="{t:Text diner.map.tooltip}"/>
        </StackPanel>

        <!-- In the diner, over the street: who is in tonight and the word on the street; a racer picked, their options,
             the race and a word with them in the same window -->
        <Grid helpers:Reveal.IsShown="{Binding IsDinerOpen}" helpers:Reveal.OffsetY="24">
            <Border Background="{StaticResource OverlayBrush}"/>
            <Border Style="{StaticResource GlassPanelStyle}"
                    Margin="90,120,90,40"
                    MaxWidth="1500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title band: back to everyone (a racer picked) at the left, out of the diner at the right -->
                    <Border Grid.Row="0" Style="{StaticResource PanelTitleBandStyle}" CornerRadius="4,4,0,0">
                        <DockPanel>
                            <Button Style="{StaticResource PanelCloseButtonStyle}"
                                    Tag="{StaticResource CloseIcon}"
                                    ToolTip="{t:Text diner.ui.go_out}"
                                    Command="{Binding ToggleDinerCommand}"/>
                            <Button Style="{StaticResource PanelCloseButtonStyle}"
                                    DockPanel.Dock="Left"
                                    Tag="{StaticResource BackIcon}"
                                    ToolTip="{t:Text diner.ui.everyone}"
                                    Command="{Binding BackToListCommand}"
                                    Margin="0,0,14,0"
                                    Visibility="{Binding HasSelectedOpponent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Grid>
                                <TextBlock Text="{t:Text diner.opponents}" Style="{StaticResource PanelTitleStyle}"
                                           Visibility="{Binding HasSelectedOpponent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{t:Text diner.racer.title}" Style="{StaticResource PanelTitleStyle}"
                                           Visibility="{Binding HasSelectedOpponent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Everyone who is in, and the word on the street beside them, while nobody is picked -->
                    <Border Grid.Row="1"
                           Padding="8,8,8,8"
                           Visibility="{Binding HasSelectedOpponent, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="460"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Empty State -->
                            <Border Grid.Row="0"
                                   Visibility="{Binding HasOpponents, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                   Padding="20">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{t:Text diner.no_racers}"
                                              FontSize="{StaticResource FontSizeBody}"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center"
                                              TextWrapping="Wrap"/>
                                    <TextBlock Text="{t:Text diner.check_back}"
                                              FontSize="{StaticResource FontSizeSmall}"
                                              Foreground="{StaticResource TextDisabledBrush}"
                                              HorizontalAlignment="Center"
                                              Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- List -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Visibility="{Binding HasOpponents, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Opponents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Opponent Card -->
                                            <Button Command="{Binding DataContext.SelectOpponentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="0"
                                                   Margin="10"
                                                   HorizontalContentAlignment="Stretch"
                                                   Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="CardBorder"
                                                                           BorderBrush="{Binding Difficulty, Converter={StaticResource DifficultyBorderBrushConverter}}"
                                                                           Background="{StaticResource UiGlassCardBrush}"
                                                                           BorderThickness="2"
                                                                           CornerRadius="6"
                                                                           Padding="10">

                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Portrait -->
                                                                            <Border Grid.Column="0"
                                                                                   Width="70"
                                                                                   Height="70"
                                                                                   Background="{StaticResource BgMediumBrush}"
                                                                                   BorderBrush="{StaticResource BorderLightBrush}"
                                                                                   BorderThickness="1"
                                                                                   CornerRadius="5"
                                                                                   Margin="0,0,10,0">
                                                                                <Grid>
                                                                                    <Image Source="{Binding PortraitImage}"
                                                                                          Stretch="UniformToFill"
                                                                                          Visibility="{Binding HasPortrait, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                                                    <TextBlock Text="?"
                                                                                              FontSize="{StaticResource FontSizeScreenTitle}"
                                                                                              FontWeight="Bold"
                                                                                              Foreground="{StaticResource BorderLightBrush}"
                                                                                              HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"
                                                                                              Visibility="{Binding HasPortrait, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                                                </Grid>
                                                                            </Border>

                                                                            <!-- Info -->
                                                                            <StackPanel Grid.Column="1"
                                                                                       VerticalAlignment="Center">
                                                                                <!-- Name -->
                                                                                <TextBlock FontSize="{StaticResource FontSizeSubheading}"
                                                                                          FontWeight="Bold"
                                                                                          Foreground="{StaticResource TextPrimaryBrush}">
                                                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                                                </TextBlock>

                                                                                <!-- Nickname -->
                                                                                <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                                                                          Foreground="{StaticResource GoldBrush}"
                                                                                          Margin="0,2,0,5">
                                                                                    <Run Text="&quot;"/>
                                                                                    <Run Text="{Binding Nickname, Mode=OneWay}"/>
                                                                                    <Run Text="&quot;"/>
                                                                                </TextBlock>

                                                                                <!-- The crew they ride with, in its colours -->
                                                                                <TextBlock Text="{Binding CrewDisplay, Mode=OneWay}"
                                                                                          Visibility="{Binding HasCrew, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                          FontSize="{StaticResource FontSizeTiny}"
                                                                                          FontWeight="Bold"
                                                                                          Foreground="{Binding CrewColour, Mode=OneWay, Converter={StaticResource CrewBrushConverter}}"
                                                                                          Margin="0,-3,0,4"/>

                                                                                <!-- Reputation -->
                                                                                <StackPanel Orientation="Horizontal"
                                                                                           Margin="0,0,0,2">
                                                                                    <TextBlock Text="{t:Text diner.reputation}"
                                                                                              FontSize="{StaticResource FontSizeCaption}"
                                                                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <TextBlock Foreground="{Binding Difficulty, Converter={StaticResource DifficultyTextBrushConverter}}"
                                                                                               FontSize="{StaticResource FontSizeCaption}"
                                                                                              FontWeight="Bold">
                                                                                        <Run Text="{Binding ReputationTier, Mode=OneWay}"/>
                                                                                        <Run Text=" ("/>
                                                                                        <Run Text="{Binding Reputation, Mode=OneWay}"/>
                                                                                        <Run Text=")"/>
                                                                                    </TextBlock>
                                                                                </StackPanel>

                                                                                <!-- Record -->
                                                                                <TextBlock Text="{Binding RecordDisplay}"
                                                                                          FontSize="{StaticResource FontSizeTiny}"
                                                                                          Foreground="{StaticResource TextSecondaryBrush}"/>

                                                                                <!-- Lost a pink slip to the player and wants it settled -->
                                                                                <Border Background="{StaticResource DangerBrush}"
                                                                                        CornerRadius="3"
                                                                                        Padding="6,2"
                                                                                        Margin="0,4,0,0"
                                                                                        HorizontalAlignment="Left"
                                                                                        Visibility="{Binding WantsRematch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <TextBlock Text="{Binding RematchDisplay}"
                                                                                               FontSize="{StaticResource FontSizeTiny}"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                                </Border>

                                                                                <!-- A regular of a diner above the player's car: won't race it here -->
                                                                                <Border Background="{StaticResource WarningBgBrush}"
                                                                                        BorderBrush="{StaticResource WarningBrush}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="3"
                                                                                        Padding="6,2"
                                                                                        Margin="0,4,0,0"
                                                                                        HorizontalAlignment="Left"
                                                                                        Visibility="{Binding IsSnubbing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <TextBlock Text="{Binding SnubDisplay}"
                                                                                               FontSize="{StaticResource FontSizeTiny}"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="{StaticResource WarningBrush}"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource UiGlassHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Word on the street: what the rivals have been up to -->
                            <Border Grid.Column="1"
                                   Style="{StaticResource GlassCardStyle}"
                                   Margin="8,10,10,10"
                                   Padding="16,12"
                                   Visibility="{Binding HasStreetTalk, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top"
                                              Text="{t:Text diner.word_on_street}"
                                              Style="{StaticResource SectionTitleStyle}"
                                              Margin="0,0,0,10"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding StreetTalk}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="62"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                  Text="{Binding When}"
                                                                  FontSize="{StaticResource FontSizeTiny}"
                                                                  Foreground="{StaticResource TextDisabledBrush}"
                                                                  Margin="0,2,0,0"/>
                                                        <TextBlock Grid.Column="1"
                                                                  Text="{Binding Text}"
                                                                  FontSize="{StaticResource FontSizeSmall}"
                                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                                  TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- A racer picked: who they are, their car, the race and the stakes -->
                    <Border Grid.Row="1"
                           Visibility="{Binding HasSelectedOpponent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="20,16,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Racer Header Section: Portrait+Info Left, Cards Right -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Portrait, Speech Bubble, and Identity -->
                                <StackPanel Grid.Column="0"
                                           Margin="0,0,20,0"
                                           VerticalAlignment="Top">
                                    <!-- Portrait and Speech Bubble Row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Portrait -->
                                        <Border Grid.Column="0"
                                               Width="150"
                                               Height="150"
                                               VerticalAlignment="Top"
                                               Background="{StaticResource UiGlassCardBrush}"
                                               BorderBrush="{StaticResource UiOutlineSoftBrush}"
                                               BorderThickness="2"
                                               CornerRadius="5">
                                            <Grid>
                                                <Image Source="{Binding SelectedOpponent.PortraitImage}"
                                                      Stretch="UniformToFill"
                                                      Visibility="{Binding SelectedOpponent.HasPortrait, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <TextBlock Text="?"
                                                          FontSize="{StaticResource FontSizeHero}"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource BorderLightBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding SelectedOpponent.HasPortrait, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Beside the portrait and as tall as it: who they are, a word with them, the speech bubble -->
                                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top">
                                            <!-- Who they are, in line with the bubble's body (its pointer takes the first 10 px) -->
                                            <StackPanel Margin="10,0,0,0">
                                                <!-- The name, their reputation beside it in the colour of how tough they are; the tier and
                                                     what it means in its tooltip -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SelectedOpponent.Name}"
                                                               FontSize="{StaticResource FontSizeSubtitle}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding SelectedOpponent.ReputationDisplay, Mode=OneWay}"
                                                               Foreground="{Binding SelectedOpponent.Difficulty, Converter={StaticResource DifficultyTextBrushConverter}}"
                                                               FontSize="{StaticResource FontSizeBody}"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="10,2,0,0"
                                                               Background="Transparent"
                                                               Cursor="Help"
                                                               ToolTipService.InitialShowDelay="200">
                                                        <TextBlock.ToolTip>
                                                            <StackPanel MaxWidth="280">
                                                                <TextBlock Text="{Binding SelectedOpponent.ReputationTier, Mode=OneWay}"
                                                                           Foreground="{Binding SelectedOpponent.Difficulty, Converter={StaticResource DifficultyTextBrushConverter}}"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding SelectedOpponent.ReputationAbout, Mode=OneWay}"
                                                                           FontSize="{StaticResource FontSizeSmall}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding SelectedOpponent.DifficultyAbout, Mode=OneWay}"
                                                                           Foreground="{Binding SelectedOpponent.Difficulty, Converter={StaticResource DifficultyTextBrushConverter}}"
                                                                           FontSize="{StaticResource FontSizeSmall}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- The nickname, and a word with them while the player's AI speaks for them -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock FontSize="{StaticResource FontSizeBody}"
                                                               Foreground="{StaticResource GoldBrush}"
                                                               VerticalAlignment="Center">
                                                        <Run Text="&quot;"/>
                                                        <Run Text="{Binding SelectedOpponent.Nickname, Mode=OneWay}"/>
                                                        <Run Text="&quot;"/>
                                                    </TextBlock>
                                                    <Button Content="{t:Text chat.ui.talk}"
                                                            Command="{Binding TalkCommand}"
                                                            Visibility="{Binding CanTalk, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Style="{StaticResource DialogSecondaryButtonStyle}"
                                                            FontSize="{StaticResource FontSizeSmall}"
                                                            VerticalAlignment="Center"
                                                            MinWidth="90"
                                                            Padding="14,4"
                                                            Margin="14,0,0,0"/>
                                                </StackPanel>

                                                <!-- The crew they ride with, in its colours -->
                                                <TextBlock Text="{Binding SelectedOpponent.CrewDisplay, Mode=OneWay}"
                                                           Visibility="{Binding SelectedOpponent.HasCrew, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding SelectedOpponent.CrewColour, Mode=OneWay, Converter={StaticResource CrewBrushConverter}}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <!-- Speech Bubble with fade animation -->
                                            <Grid x:Name="SpeechBubble"
                                                 Margin="0,10,0,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding HasOpponentMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOpponentMessage}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                           From="0" To="1"
                                                                                           Duration="0:0:0.3"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <!-- Triangle pointer pointing left -->
                                                <Path Data="M 10,0 L 0,12 L 10,24 Z"
                                                     Fill="{StaticResource BgMediumBrush}"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,0,0"/>

                                                <!-- Bubble content -->
                                                <Border Background="{StaticResource BgMediumBrush}"
                                                       BorderBrush="{StaticResource Gray50Brush}"
                                                       BorderThickness="1"
                                                       CornerRadius="8"
                                                       Padding="12,10"
                                                       Margin="10,0,0,0"
                                                       Width="300">
                                                    <TextBlock Text="{Binding OpponentMessage}"
                                                              FontSize="{StaticResource FontSizeCompact}"
                                                              FontStyle="Italic"
                                                              Foreground="{StaticResource TextPrimaryBrush}"
                                                              TextWrapping="Wrap"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Right: Info Cards -->
                                <Grid Grid.Column="1" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Record Card -->
                                    <Border Grid.Column="0"
                                           Style="{StaticResource GlassCardStyle}"
                                           Padding="12"
                                           Height="150"
                                           Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="{t:Text diner.record}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>

                                            <!-- Overall Record -->
                                            <TextBlock Text="{Binding SelectedOpponent.RecordDisplay}"
                                                      FontSize="{StaticResource FontSizeHeading}"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Margin="0,0,0,8"/>

                                            <!-- Drag Race Record -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{t:Text diner.drag}"
                                                          FontSize="{StaticResource FontSizeMicro}"
                                                          Foreground="{StaticResource WarningBrush}"
                                                          Width="28"/>
                                                <TextBlock Text="{Binding SelectedOpponent.DragRecordDisplay}"
                                                          FontSize="{StaticResource FontSizeMicro}"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>

                                            <!-- Road Race Record -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{t:Text diner.road}"
                                                          FontSize="{StaticResource FontSizeMicro}"
                                                          Foreground="{StaticResource RoyalBlueBrush}"
                                                          Width="28"/>
                                                <TextBlock Text="{Binding SelectedOpponent.RoadRecordDisplay}"
                                                          FontSize="{StaticResource FontSizeMicro}"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>

                                            <!-- Pink Slips -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{t:Text diner.pink_slips}"
                                                          FontSize="{StaticResource FontSizeTiny}"
                                                          Foreground="{StaticResource GoldBrush}"
                                                          Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding SelectedOpponent.PinkSlipsDisplay}"
                                                          FontSize="{StaticResource FontSizeTiny}"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Current Car Card -->
                                    <Border Grid.Column="1"
                                           Style="{StaticResource GlassCardStyle}"
                                           Padding="12"
                                           Height="150"
                                           Margin="10,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{t:Text diner.current_car}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>

                                            <!-- Car Brand & Name -->
                                            <TextBlock Text="{Binding SelectedOpponent.CarBrand}"
                                                      FontSize="{StaticResource FontSizeBody}"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedOpponent.CarName}"
                                                      FontSize="{StaticResource FontSizeSmall}"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Margin="0,0,0,6"/>

                                            <!-- Car Year -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{t:Text diner.year}"
                                                          FontSize="{StaticResource FontSizeTiny}"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          Width="50"/>
                                                <TextBlock Text="{Binding SelectedOpponent.CarYear}"
                                                          FontSize="{StaticResource FontSizeTiny}"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>

                                            <!-- Car Power -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{t:Text diner.power}"
                                                          FontSize="{StaticResource FontSizeTiny}"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          Width="50"/>
                                                <TextBlock Text="{Binding SelectedOpponent.CarPower}"
                                                          FontSize="{StaticResource FontSizeTiny}"
                                                          Foreground="{StaticResource AccentSuccessBrush}"
                                                          FontWeight="Bold"/>
                                            </StackPanel>

                                            <!-- Car Weight -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{t:Text diner.weight}"
                                                          FontSize="{StaticResource FontSizeTiny}"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          Width="50"/>
                                                <TextBlock Text="{Binding SelectedOpponent.CarWeight}"
                                                          FontSize="{StaticResource FontSizeTiny}"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                             </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- The race, the matchup and the stakes side by side, all in sight; the tracks in their own picker.
                                 Scrolls only when the window is too short for the tallest column. -->
                            <ScrollViewer Grid.Row="1"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Margin="0,20,0,0">
                                <Grid>
                                    <Grid.Resources>
                                        <Style x:Key="OptionNoteStyle" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Margin" Value="0,6,0,0"/>
                                        </Style>
                                        <!-- Cash or pink slips: the glass toggle, on while its bet is the one -->
                                        <Style x:Key="BetButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource GlassToggleButtonStyle}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Height" Value="38"/>
                                            <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- The race: the track (changed in the picker), the format it is run as, a bracket race -->
                                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{t:Text diner.format}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                                            <!-- No tracks at all -->
                                            <TextBlock Text="{t:Text diner.no_tracks}"
                                                       Style="{StaticResource OptionNoteStyle}"
                                                       Margin="0"
                                                       Visibility="{Binding HasAnyTracks, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                            <!-- The track picked: its picture, its name, the races it takes -->
                                            <Grid Visibility="{Binding HasSelectedTrack, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="128" Height="76"
                                                        Background="{StaticResource UiFieldBrush}"
                                                        BorderBrush="{StaticResource UiOutlineSoftBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding SelectedTrack.Kind}"
                                                                   FontSize="{StaticResource FontSizeSubheading}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource Gray50Brush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <Image Source="{Binding SelectedTrack.PreviewImage}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedTrack.DisplayName}"
                                                               FontSize="{StaticResource FontSizeBody}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource CreamBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <Border Style="{StaticResource CardTagStyle}"
                                                            Padding="6,1"
                                                            Margin="0,5,0,0"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding SelectedTrack.Kind}" Style="{StaticResource CardTagTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <Button Content="{t:Text diner.track.change}"
                                                    ToolTip="{t:Text diner.track.change.tip}"
                                                    Command="{Binding PickTrackCommand}"
                                                    Style="{StaticResource DialogSecondaryButtonStyle}"
                                                    FontSize="{StaticResource FontSizeCompact}"
                                                    HorizontalAlignment="Left"
                                                    MinWidth="140"
                                                    Padding="18,7"
                                                    Margin="0,12,0,0"
                                                    Visibility="{Binding HasAnyTracks, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- When the track takes more than one race the diner offers (a circuit race or a time attack) -->
                                            <StackPanel Margin="0,14,0,0"
                                                        Visibility="{Binding HasFormatChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ComboBox ItemsSource="{Binding FormatChoices}"
                                                          SelectedItem="{Binding SelectedFormat}"
                                                          DisplayMemberPath="Name"/>
                                                <TextBlock Text="{Binding FormatNote}"
                                                           Style="{StaticResource OptionNoteStyle}"
                                                           Visibility="{Binding HasFormatNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Bracket race: on a strip that runs the quarter -->
                                            <StackPanel Margin="0,14,0,0"
                                                        Visibility="{Binding CanBracket, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <CheckBox Content="{t:Text diner.bracket}"
                                                          IsChecked="{Binding IsBracket}"
                                                          FontSize="{StaticResource FontSizeCompact}"
                                                          FontWeight="Bold"
                                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{t:Text diner.bracket.about}" Style="{StaticResource OptionNoteStyle}"/>
                                                <TextBlock Text="{Binding BracketNote}"
                                                           Style="{StaticResource OptionNoteStyle}"
                                                           Foreground="{StaticResource GoldBrush}"
                                                           Visibility="{Binding IsBracket, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- The matchup: the player's car against theirs, figure by figure -->
                                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{t:Text diner.matchup}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                                            <!-- No car to set against theirs -->
                                            <TextBlock Text="{t:Text diner.matchup.none}"
                                                       Style="{StaticResource OptionNoteStyle}"
                                                       Margin="0"
                                                       Visibility="{Binding HasMatchupStats, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                            <!-- The label column is as wide as the widest label, the header's and every row's alike -->
                                            <StackPanel Grid.IsSharedSizeScope="True"
                                                        Visibility="{Binding HasMatchupStats, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <!-- Headers -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="MatchupLabel"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{t:Text diner.you}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{t:Text diner.them}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding MatchupStats}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource UiRailBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="MatchupLabel"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="28"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding PlayerValue}"
                                                                               FontSize="{StaticResource FontSizeCompact}"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               HorizontalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Label}"
                                                                               FontSize="{StaticResource FontSizeCaption}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Margin="6,0"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding OpponentValue}"
                                                                               FontSize="{StaticResource FontSizeCompact}"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               HorizontalAlignment="Center"/>

                                                                    <!-- Green when the player has the edge, red when the opponent has, grey when even -->
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding AdvantageIndicator}"
                                                                               FontSize="{StaticResource FontSizeSmall}"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource Gray80Brush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Advantage}" Value="1">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentSuccessBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Advantage}" Value="-1">
                                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- The stakes: cash or pink slips, then what the bet comes to -->
                                    <Border Grid.Column="4" Style="{StaticResource GlassCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{t:Text diner.bet_type}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>

                                            <UniformGrid Columns="2">
                                                <RadioButton Style="{StaticResource BetButtonStyle}"
                                                             Content="{t:Text diner.cash_wager}"
                                                             IsChecked="{Binding IsCashBet, Mode=OneWay}"
                                                             Command="{Binding CashBetCommand}"
                                                             Margin="0,0,5,0"/>
                                                <RadioButton Style="{StaticResource BetButtonStyle}"
                                                             Content="{t:Text diner.pink_slips}"
                                                             IsChecked="{Binding IsPinkSlipBet, Mode=OneWay}"
                                                             Command="{Binding PinkSlipBetCommand}"
                                                             Margin="5,0,0,0"/>
                                            </UniformGrid>

                                            <!-- Cash: how much, on a slider -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding IsCashBet, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding WagerAmountDisplay}"
                                                           FontSize="{StaticResource FontSizeHeadingLarge}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentSuccessBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,6"/>
                                                <Slider Value="{Binding WagerAmount}"
                                                        Minimum="{Binding MinWager, Mode=OneWay}"
                                                        Maximum="{Binding MaxWager, Mode=OneWay}"
                                                        TickFrequency="10"
                                                        IsSnapToTickEnabled="True"/>
                                                <DockPanel Margin="0,3,0,0">
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding MaxWager, Converter={StaticResource MoneyConverter}, Mode=OneWay}"
                                                               FontSize="{StaticResource FontSizeTiny}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding MinWager, Converter={StaticResource MoneyConverter}, Mode=OneWay}"
                                                               FontSize="{StaticResource FontSizeTiny}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding StakesNote}"
                                                           Style="{StaticResource OptionNoteStyle}"
                                                           Foreground="{StaticResource GoldBrush}"
                                                           Visibility="{Binding HasStakesNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Pink slips: the winner takes the car -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding IsPinkSlipBet, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{t:Text diner.pink_slips.about}" Style="{StaticResource OptionNoteStyle}" Margin="0"/>
                                                <Border Background="{StaticResource DangerBgBrush}"
                                                        BorderBrush="{StaticResource DangerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,5"
                                                        Margin="0,8,0,0">
                                                    <TextBlock Text="{t:Text diner.high_stakes}"
                                                               FontSize="{StaticResource FontSizeTiny}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- The police risk of a road race -->
                                            <TextBlock Text="{Binding PoliceNote}"
                                                       Style="{StaticResource OptionNoteStyle}"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       Margin="0,10,0,0"
                                                       Visibility="{Binding HasPoliceNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- The regulars won't race the player's car: below the place's class -->
                                            <Border Background="{StaticResource WarningBgBrush}"
                                                    BorderBrush="{StaticResource WarningBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10,6"
                                                    Margin="0,10,0,0"
                                                    Visibility="{Binding IsSnubbed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding SnubNote, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- Can't cover the smallest wager -->
                                            <Border Background="{StaticResource WarningBgBrush}"
                                                    BorderBrush="{StaticResource WarningBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10,6"
                                                    Margin="0,10,0,0"
                                                    Visibility="{Binding CanAffordMinBet, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding InsufficientFundsMessage, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- Challenge: the gold glass of the street's Cruise button -->
                            <Button Grid.Row="2"
                                   Content="{t:Text diner.challenge}"
                                   Command="{Binding ChallengeCommand}"
                                   Style="{StaticResource DialogPrimaryButtonStyle}"
                                   Foreground="{StaticResource BgPanelBrush}"
                                   Background="{StaticResource GoldBrush}"
                                   helpers:GlassButton.HoverBrush="{StaticResource PaleYellowBrush}"
                                   FontSize="{StaticResource FontSizeHeading}"
                                   FontWeight="Bold"
                                   Padding="20,14"
                                   Margin="0,16,0,0"
                                   HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- Black until the car comes down the street, and again once it has driven off -->
        <Border x:Name="Curtain"
                Background="{StaticResource StageBrush}"
                IsHitTestVisible="False"/>

        <!-- Until the street is up -->
        <controls:LoadingIndicator WaitFor="{Binding ElementName=StreetView}" Message="{t:Text diner.ui.loading}"/>

    </Grid>
</UserControl>
