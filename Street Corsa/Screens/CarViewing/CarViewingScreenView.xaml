<UserControl x:Class="StreetCorsa.Screens.CarViewing.CarViewingScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">

    <Grid Background="{StaticResource BgDarkBrush}">

        <!-- The car where its seller has it, behind everything -->
        <controls:CarViewingViewport3D x:Name="Viewport"
                                       Stage="{Binding Stage}"
                                       RunningEngine="{Binding Runner, ElementName=EnginePanel}"/>

        <!-- Covered until the car stands in its scene -->
        <controls:LoadingIndicator Message="{t:Text preview.car.loading}"
                                   IsLoading="{Binding IsSettled, ElementName=Viewport, Converter={StaticResource InverseBooleanConverter}}"/>

        <!-- No 3D on this machine: the card still says everything -->
        <TextBlock Text="{t:Text preview.car.no_3d}"
                   FontSize="{StaticResource FontSizeTitleSmall}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasFailed, ElementName=Viewport, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- The car: the garage's name card (centre, 800 wide at most), level with the window's money card, the name and
             its price on one line -->
        <Grid VerticalAlignment="Top" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*" MaxWidth="800"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1"
                    Margin="0,20,0,0"
                    Background="{StaticResource UiGlassBrush}"
                    BorderBrush="{StaticResource UiOutlineBrush}"
                    BorderThickness="3"
                    CornerRadius="8"
                    Padding="30,12">
                <TextBlock FontSize="{StaticResource FontSizeTitleSmall}"
                           FontWeight="Bold"
                           Foreground="{StaticResource CreamBrush}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="6" Opacity="0.9"/>
                    </TextBlock.Effect>
                    <Run Text="{Binding Car.DisplayName, Mode=OneWay}"/>
                    <Run Text="   "/>
                    <Run Text="{Binding Car.WasPriceDisplay, Mode=OneWay}"
                         FontWeight="Normal"
                         TextDecorations="Strikethrough"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding Car.PriceDisplay, Mode=OneWay}" Foreground="{StaticResource AccentSuccessBrush}"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Back to the paper -->
        <Button Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource BackIcon}"
                ToolTip="{t:Text preview.car.back}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

        <!-- Straight home to the garage -->
        <Button Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource GarageIcon}"
                ToolTip="{t:Text preview.car.garage}"
                Command="{Binding GarageCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,100,0,0"/>

        <TextBlock Text="{t:Text preview.car.hint}"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,24,20"
                   IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="1"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- The left card, under the round buttons. With the player's AI on, the talk with the seller (two thirds of the
             room down there, behind a tab that opens and shuts it): they begin it as the player arrives, tell them about
             the car, and close the deal ("Buy it for $X") -->
        <Grid HorizontalAlignment="Left"
              Width="360"
              Margin="20,180,0,20"
              Visibility="{Binding HasTalk, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:TalkCard DataContext="{Binding Talk}"/>
        </Grid>

        <!-- With the AI off, nobody to tell the player about the car: the same card has its facts and Buy -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="360"
                Margin="20,180,0,20"
                Background="{StaticResource Glass15E8Brush}"
                BorderBrush="{StaticResource Cream70Brush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,14"
                Visibility="{Binding ShowsCarInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding PlaceLine}"
                           FontSize="{StaticResource FontSizeCompact}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10"/>
                <StackPanel DataContext="{Binding Car}">
                    <TextBlock Text="{Binding YearDisplay}"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{t:Text preview.car.condition}" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding ConditionLabel, Mode=OneWay}"/>
                            <Run Text="{Binding ConditionDisplay, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{t:Text preview.car.mileage}" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MileageDisplay}" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeCompact}"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{t:Text preview.car.seller}" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DealerName}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                                   FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding EngineDisplay}"
                               Visibility="{Binding EngineDisplay, Converter={StaticResource StringToVisibilityConverter}}"
                               FontSize="{StaticResource FontSizeCompact}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,0"/>
                    <!-- Who had it, how it has raced -->
                    <TextBlock Text="{Binding HistoryDisplay}"
                               Visibility="{Binding HistoryDisplay, Converter={StaticResource StringToVisibilityConverter}}"
                               FontSize="{StaticResource FontSizeCompact}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <!-- The ad's few words, as printed -->
                <TextBlock Text="{Binding Description}"
                           Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"
                           FontStyle="Italic"
                           FontSize="{StaticResource FontSizeCompact}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,10,0,0"/>
                <TextBlock Text="{Binding AffordLine}"
                           Visibility="{Binding AffordLine, Converter={StaticResource StringToVisibilityConverter}}"
                           FontSize="{StaticResource FontSizeCompact}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource GoldBrush}"
                           Margin="0,12,0,0"/>
                <Button Content="{t:Text preview.car.buy}"
                        Margin="0,16,0,0"
                        Height="42"
                        FontSize="{StaticResource FontSizeBodyLarge}"
                        FontWeight="Bold"
                        Command="{Binding BuyCommand}"/>
            </StackPanel>
        </Border>

        <!-- Start it up before you buy it, at the bottom centre -->
        <controls:EnginePanel x:Name="EnginePanel"
                              Width="340"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,30"
                              Engine="{Binding Engine}"/>

    </Grid>
</UserControl>
