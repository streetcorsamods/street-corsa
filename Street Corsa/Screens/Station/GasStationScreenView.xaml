<UserControl x:Class="StreetCorsa.Screens.Station.GasStationScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <SolidColorBrush x:Key="GlassBrush" Color="#C0101010"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#60FFE68C"/>
    </UserControl.Resources>

    <Grid Background="Black">
        <!-- The station, from the driver's seat -->
        <controls:StationViewport3D x:Name="StationView"
                                    Station="{Binding Station}"
                                    Light="{Binding Light}"
                                    PlayerCar="{Binding PlayerCar}"
                                    Stage="{Binding Stage}"/>

        <!-- No 3D: the station works without the picture -->
        <TextBlock Text="The gas station can't be shown on this machine, but the attendant is there all the same."
                   FontSize="{StaticResource FontSizeBody}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasFailed, ElementName=StationView, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Where, when, and the money -->
        <Border Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="18,12"
                Margin="20,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="Bold"
                           Foreground="{StaticResource GoldBrush}"/>
                <TextBlock Text="{Binding ClockDisplay}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding BankrollDisplay}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentSuccessBrush}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- What is going on -->
        <Border Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="14,10"
                Margin="20,0,0,20"
                MaxWidth="560"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Drag to look round -->
        <TextBlock Text="Drag to look around · double-click to look back"
                   FontSize="{StaticResource FontSizeTiny}"
                   Foreground="#90FFFFFF"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,8"
                   IsHitTestVisible="False"/>

        <!-- The attendant at the window, and what he can do -->
        <Border Width="420"
                Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="2"
                CornerRadius="6"
                Padding="18"
                Margin="0,20,20,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="{Binding IsAtPump, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="THE ATTENDANT"
                           FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="Bold"
                           Foreground="{StaticResource GoldBrush}"
                           Margin="0,0,0,8"/>

                <!-- What he says, a line each -->
                <Border Background="{StaticResource BgMediumBrush}"
                        CornerRadius="4"
                        Padding="12,8"
                        MaxHeight="300">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="LinesScroller">
                        <ItemsControl ItemsSource="{Binding AttendantLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- A job under way: the pump's dials, a bar filling -->
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding WorkTitle}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Height="12"
                            CornerRadius="3"
                            Background="{StaticResource BgMediumBrush}"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            Margin="0,8,0,6"
                            ClipToBounds="True">
                        <Border Background="{StaticResource GoldBrush}"
                                CornerRadius="2"
                                HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding WorkProgress}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock Text="{Binding WorkDetail}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- The jobs -->
                <ItemsControl ItemsSource="{Binding Jobs}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding Detail, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding TimeDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding CostDisplay}"
                                        Command="{Binding Command}"
                                        Style="{StaticResource DialogPrimaryButtonStyle}"
                                        MinWidth="72"
                                        Padding="14,6"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Nothing to do: the tank is full, the oil's on the mark and she's clean."
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasJobs}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="{Binding DriveOffText}"
                        Command="{Binding DriveOffCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Padding="22,10"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- The curtain: black until the car rolls in, black again when it has gone -->
        <Border x:Name="Curtain"
                Background="Black"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
