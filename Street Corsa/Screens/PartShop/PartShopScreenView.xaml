<UserControl x:Class="StreetCorsa.Screens.PartShop.PartShopScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bottomBar="clr-namespace:StreetCorsa.Components.BottomBar"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{StaticResource BgPanelCCBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray80Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Back Button -->
        <Button x:Name="BackButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

        <!-- Content -->
        <Grid Grid.Row="0"
              MaxWidth="1100"
              Margin="110,20,110,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The shop: its name, what kind of place it is, and what is off today -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border Background="{StaticResource BgPanelCCBrush}"
                        CornerRadius="5"
                        Padding="28,4"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ShopName}"
                               FontSize="{StaticResource FontSizeScreenTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           FontSize="{StaticResource FontSizeCompact}"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                    <Run Text="  ·  "/>
                    <Run Text="{Binding Region, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Blurb}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="700"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Notice}"
                           Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           FontSize="{StaticResource FontSizeCompact}"
                           FontWeight="Bold"
                           Foreground="{StaticResource GoldBrush}"/>
            </StackPanel>

            <!-- Pages -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <RadioButton Content="{Binding BuyTabLabel}"
                             Style="{StaticResource TabButtonStyle}"
                             IsChecked="{Binding IsBuyTab, Mode=OneWay}"
                             Command="{Binding ShowTabCommand}"
                             CommandParameter="Buy"/>
                <RadioButton Content="{Binding SellTabLabel}"
                             Style="{StaticResource TabButtonStyle}"
                             IsChecked="{Binding IsSellTab, Mode=OneWay}"
                             Command="{Binding ShowTabCommand}"
                             CommandParameter="Sell"/>
            </StackPanel>

            <!-- Filters -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgPanelCCBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14,8"
                    Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Kind:"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              Width="220"
                              Height="28"
                              FontSize="{StaticResource FontSizeCompact}"
                              VerticalContentAlignment="Center"/>

                    <TextBlock Text="Name:"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="20,0,8,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             Width="200"
                             Height="28"
                             FontSize="{StaticResource FontSizeCompact}"
                             Padding="5,3"
                             VerticalContentAlignment="Center"/>

                    <CheckBox Content="{Binding FitFilterLabel}"
                              IsChecked="{Binding OnlyFitting}"
                              Visibility="{Binding CanFilterByFit, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="{StaticResource FontSizeBody}"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Offers -->
            <Border Grid.Row="3"
                    Background="{StaticResource Glass14E0Brush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <ListBox ItemsSource="{Binding Offers}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="row"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource Gray30Brush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,7">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource White20Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeBodyLarge}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding Group, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding Detail, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{StaticResource Fit30Brush}"
                                        BorderBrush="{StaticResource FitBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Margin="10,0"
                                        Visibility="{Binding Fits, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="fits your car" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource FitBrush}"/>
                                </Border>

                                <!-- The price before today's sale and the regulars' discount, struck through -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WasPriceDisplay}"
                                           Visibility="{Binding HasWasPrice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           TextDecorations="Strikethrough"
                                           FontSize="{StaticResource FontSizeCompact}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding PriceDisplay}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentSuccessBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="4"
                                        Content="Haggle"
                                        Command="{Binding DataContext.HaggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanHaggle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                        Padding="12,4"
                                        FontSize="{StaticResource FontSizeCompact}"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0"/>

                                <Button Grid.Column="5"
                                        Content="{Binding ActionLabel}"
                                        Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanAfford}"
                                        Style="{StaticResource DialogPrimaryButtonStyle}"
                                        Padding="16,4"
                                        FontSize="{StaticResource FontSizeCompact}"
                                        MinWidth="70"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="4"
                       Text="{Binding StatusText}"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="1" BlurRadius="4"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <!-- Bottom Nav Bar -->
        <bottomBar:BottomBarView Grid.Row="1"
                                 BankrollDisplay="{Binding BankrollDisplay}"/>
    </Grid>
</UserControl>
