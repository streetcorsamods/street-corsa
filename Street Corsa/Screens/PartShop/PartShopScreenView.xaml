<UserControl x:Class="StreetCorsa.Screens.PartShop.PartShopScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{StaticResource BgPanelCCBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray80Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">

        <!-- Inside the shop, behind everything: its stock on its shelves -->
        <controls:ShopViewport3D x:Name="Viewport"
                                 SceneKn5="{Binding SceneKn5}"
                                 Stock="{Binding StockShown}"
                                 Catalog="{Binding Catalog}"
                                 Places="{Binding Places}"
                                 Dressing="{Binding Dressing}"
                                 View="{Binding View}"
                                 Room="{Binding Room}"
                                 IsCovered="{Binding IsCounterOpen}"/>

        <!-- Covered until the shop stands with its stock in it -->
        <Grid Background="{StaticResource BgDarkBrush}"
              Visibility="{Binding HasScene, Converter={StaticResource BooleanToVisibilityConverter}}"
              helpers:Reveal.IsShown="{Binding IsShopReady, ElementName=Viewport, Converter={StaticResource InverseBooleanConverter}}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeTitleSmall}"
                       Foreground="{StaticResource TextPrimaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{t:Text partshop.walking_in}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport}" Value="True">
                                <Setter Property="Text" Value="{t:Text partshop.no_3d}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- The shop: its name, what kind of place it is, and what is off today -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" IsHitTestVisible="False">
            <Border Background="{StaticResource BgPanelCCBrush}"
                    CornerRadius="5"
                    Padding="28,4"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding ShopName}"
                           FontSize="{StaticResource FontSizeScreenTitle}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
            <Border Background="{StaticResource BgPanelCCBrush}" CornerRadius="4" Padding="14,3" Margin="0,6,0,0" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSizeCompact}"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding Region, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Blurb}"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="700"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Notice}"
                               Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               FontSize="{StaticResource FontSizeCompact}"
                               FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Up to the counter: the clerk looks up as the player comes in, and the button calls while they wait -->
        <Button HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,34"
                Padding="30,12"
                Style="{StaticResource DialogPrimaryButtonStyle}"
                FontSize="{StaticResource FontSizeBodyLarge}"
                Command="{Binding ToggleCounterCommand}"
                helpers:Reveal.IsShown="{Binding ShowsCounterButton}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,10,0" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center"
                         Visibility="{Binding Talk.HasUnread, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                <TextBlock Text="{t:Text partshop.counter}" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- The counter, over the shop: the clerk on the left, the stock on the right -->
        <Grid helpers:Reveal.IsShown="{Binding IsCounterOpen}" helpers:Reveal.OffsetY="24">
            <Border Background="{StaticResource OverlayBrush}"/>
            <Border Style="{StaticResource GlassPanelStyle}"
                    Margin="90,120,90,40"
                    MaxWidth="1500"
                    Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Whoever is behind the counter, while the player's AI is on -->
                    <Border Grid.Column="0"
                            Width="380"
                            Margin="0,0,18,0"
                            Padding="14"
                            CornerRadius="5"
                            Background="{StaticResource BgPanelCCBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasTalk, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:TalkPanel DataContext="{Binding Talk}"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                            <!-- Pages -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <RadioButton Content="{Binding BuyTabLabel}"
                                             Style="{StaticResource TabButtonStyle}"
                                             IsChecked="{Binding IsBuyTab, Mode=OneWay}"
                                             Command="{Binding ShowTabCommand}"
                                             CommandParameter="Buy"/>
                                <RadioButton Content="{Binding SellTabLabel}"
                                             Style="{StaticResource TabButtonStyle}"
                                             IsChecked="{Binding IsSellTab, Mode=OneWay}"
                                             Command="{Binding ShowTabCommand}"
                                             CommandParameter="Sell"/>
                            </StackPanel>

                            <!-- Filters -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource BgPanelCCBrush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="14,8"
                                    Margin="0,0,0,8">
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="{t:Text market.kind_filter}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding Groups}"
                                              SelectedItem="{Binding SelectedGroup}"
                                              Width="220"
                                              Height="28"
                                              FontSize="{StaticResource FontSizeCompact}"
                                              VerticalContentAlignment="Center"/>

                                    <TextBlock Text="{t:Text partshop.name_filter}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="20,0,8,0"/>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                             Width="200"
                                             Height="28"
                                             FontSize="{StaticResource FontSizeCompact}"
                                             Padding="5,3"
                                             VerticalContentAlignment="Center"/>

                                    <CheckBox Content="{Binding FitFilterLabel}"
                                              IsChecked="{Binding OnlyFitting}"
                                              Visibility="{Binding CanFilterByFit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              FontSize="{StaticResource FontSizeBody}"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Margin="20,0,0,0"/>

                                    <Button Command="{Binding ClearMaxPriceCommand}"
                                            Visibility="{Binding HasMaxPrice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="{t:Text partshop.clear_price}"
                                            Style="{StaticResource DialogSecondaryButtonStyle}"
                                            Padding="10,2"
                                            FontSize="{StaticResource FontSizeCompact}"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0">
                                        <TextBlock>
                                            <Run Text="{Binding MaxPriceLabel, Mode=OneWay}"/>
                                            <Run Text="  ✕"/>
                                        </TextBlock>
                                    </Button>
                                </WrapPanel>
                            </Border>

                            <!-- Offers -->
                            <Border Grid.Row="3"
                                    Background="{StaticResource Glass14E0Brush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <ListBox ItemsSource="{Binding Offers}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="row"
                                                                Background="Transparent"
                                                                BorderBrush="{StaticResource Gray30Brush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="14,7">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="{StaticResource Glass14E0Brush}"/>
                                                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                                                                <Setter TargetName="row" Property="BorderThickness" Value="3,0,0,1"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="{StaticResource White20Brush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{t:Text partshop.picked}"
                                                               Visibility="{Binding IsPicked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AmberBrush}"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="{StaticResource FontSizeBodyLarge}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Group, Mode=OneWay}"/>
                                                        <Run Text="  ·  "/>
                                                        <Run Text="{Binding Detail, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Fit30Brush}"
                                                        BorderBrush="{StaticResource FitBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0"
                                                        Visibility="{Binding Fits, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{t:Text partshop.fits}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource FitBrush}"/>
                                                </Border>

                                                <!-- The price before today's sale and the regulars' discount, struck through -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding WasPriceDisplay}"
                                                           Visibility="{Binding HasWasPrice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           TextDecorations="Strikethrough"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding PriceDisplay}"
                                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentSuccessBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="4"
                                                        Content="{t:Text partshop.haggle_button}"
                                                        Command="{Binding DataContext.HaggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanHaggle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                                        Padding="12,4"
                                                        FontSize="{StaticResource FontSizeCompact}"
                                                        VerticalAlignment="Center"
                                                        Margin="14,0,0,0"/>

                                                <Button Grid.Column="5"
                                                        Content="{Binding ActionLabel}"
                                                        Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanAfford}"
                                                        Style="{StaticResource DialogPrimaryButtonStyle}"
                                                        Padding="16,4"
                                                        FontSize="{StaticResource FontSizeCompact}"
                                                        MinWidth="70"
                                                        VerticalAlignment="Center"
                                                        Margin="14,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Grid.Row="4"
                                       Text="{Binding StatusText}"
                                       FontSize="{StaticResource FontSizeCompact}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{StaticResource Shadow}" ShadowDepth="1" BlurRadius="4"/>
                                </TextBlock.Effect>
                            </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!-- Away from the counter, back to the shop -->
            <Button Style="{StaticResource PanelCloseButtonStyle}"
                    Tag="{StaticResource CloseIcon}"
                    ToolTip="{t:Text partshop.counter_close}"
                    Command="{Binding ToggleCounterCommand}"
                    Visibility="{Binding HasScene, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,96,66,0"/>
        </Grid>

        <!-- Back: off the counter first, then out of the shop -->
        <Button x:Name="BackButton"
                Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource BackIcon}"
                ToolTip="{t:Text common.back}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

    </Grid>
</UserControl>
