<UserControl x:Class="StreetCorsa.Screens.DealerMap.DealerMapScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{StaticResource BgDarkBrush}">

        <!-- The map fills the window and the pins are placed against exactly the piece of it on screen, so
             neither is compromised for the other. The panel grows the crop to the window's shape rather than
             stretching the picture into it; see MapPanel. -->
        <helpers:MapPanel x:Name="Map"
                          Anchor="{Binding MapAnchor}"
                          ImagePixelWidth="{Binding MapImageWidth}"
                          ImagePixelHeight="{Binding MapImageHeight}">

            <!-- Stretch=Fill is right here: the viewbox is already the shape of the panel -->
            <Rectangle>
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{Binding MapImage}"
                                Viewbox="{Binding EffectiveCrop, ElementName=Map}"
                                ViewboxUnits="RelativeToBoundingBox"
                                Stretch="Fill"/>
                </Rectangle.Fill>
            </Rectangle>

            <!-- A modern street map read as old paper: warmed and quietened so the print stops competing
                 with the pins -->
            <Rectangle Opacity="0.30">
                <Rectangle.Fill>
                    <SolidColorBrush Color="{StaticResource MapSepia}"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <!-- Darker at the edges so the pins over the city read against the print -->
                    <RadialGradientBrush GradientOrigin="0.42,0.5" Center="0.42,0.5" RadiusX="0.8" RadiusY="0.85">
                        <GradientStop Color="{StaticResource BlackTransparent}" Offset="0.45"/>
                        <GradientStop Color="{StaticResource Black77}" Offset="1.0"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Pins, each held at its own spot on the map -->
            <ItemsControl ItemsSource="{Binding Pins}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <helpers:MapPanel Anchor="{Binding Anchor, ElementName=Map}"
                                          ImagePixelWidth="{Binding ImagePixelWidth, ElementName=Map}"
                                          ImagePixelHeight="{Binding ImagePixelHeight, ElementName=Map}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="helpers:MapPanel.MapX" Value="{Binding MapX}"/>
                        <Setter Property="helpers:MapPanel.MapY" Value="{Binding MapY}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The pin is the button; the card is its tooltip -->
                        <Button Command="{Binding DataContext.VisitDealerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel x:Name="Root" Orientation="Vertical" HorizontalAlignment="Center">
                                        <Border x:Name="Dot"
                                                Width="18" Height="18"
                                                CornerRadius="9"
                                                Background="{StaticResource AccentPrimaryBrush}"
                                                BorderBrush="{StaticResource CreamBrush}"
                                                BorderThickness="2"
                                                HorizontalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="0.85"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="Plate"
                                                Margin="0,5,0,0"
                                                Background="{StaticResource Glass12D0Brush}"
                                                BorderBrush="{StaticResource Cream70Brush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,3,8,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StockDisplay}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <!-- The closing-down sale, or a lot that is new: worth the drive -->
                                                <TextBlock Text="{Binding Notice}"
                                                           Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource GoldBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <!-- A part shop: a gold square, not a red dot, so it reads apart from the lots -->
                                        <DataTrigger Binding="{Binding IsPartShop}" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource GoldBrush}"/>
                                            <Setter TargetName="Dot" Property="CornerRadius" Value="3"/>
                                        </DataTrigger>
                                        <!-- A diner: a cream diamond, the landmark the racers go to -->
                                        <DataTrigger Binding="{Binding IsDiner}" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource CreamBrush}"/>
                                            <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter TargetName="Dot" Property="CornerRadius" Value="2"/>
                                            <Setter TargetName="Dot" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                            <Setter TargetName="Dot" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="45"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <!-- Too far to get back from today: still there to be clicked, but greyed so the
                                             cost is visible before the click, not sprung by the dialog after it -->
                                        <DataTrigger Binding="{Binding FitsToday}" Value="False">
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource MapDotFarBrush}"/>
                                            <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource MapDotFarBorderBrush}"/>
                                            <Setter TargetName="Root" Property="Opacity" Value="0.62"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                            <Setter TargetName="Dot" Property="Width" Value="22"/>
                                            <Setter TargetName="Dot" Property="Height" Value="22"/>
                                            <Setter TargetName="Dot" Property="CornerRadius" Value="11"/>
                                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                            <Setter TargetName="Root" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <!-- A part shop keeps its corners when hovered -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPartShop}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Dot" Property="CornerRadius" Value="4"/>
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource GoldCCBrush}"/>
                                        </MultiDataTrigger>
                                        <!-- A diner keeps its diamond when hovered -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDiner}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Dot" Property="CornerRadius" Value="3"/>
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource CreamBrush}"/>
                                            <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip>
                                <ToolTip Background="{StaticResource BgPanelF2Brush}" BorderBrush="{StaticResource Cream60Brush}" BorderThickness="1" Padding="12">
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource FontSizeSubheading}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Region}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Blurb}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextWrapping="Wrap"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding NoticeDetail}"
                                                   Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource GoldBrush}"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding PriceDisplay}"
                                                   FontSize="{StaticResource FontSizeCompact}"
                                                   Foreground="{StaticResource AccentSuccessBrush}"/>
                                        <!-- A diner's visit pays its own half hour; a lot's drive is said here -->
                                        <TextBlock Text="{t:Text dealermap.diner.visit}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding IsDiner, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding TravelDisplay}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding IsDiner, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding DayCostDisplay}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontStyle="Italic"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding IsDiner, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FitsToday}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource MapFarTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </helpers:MapPanel>

        <!-- The map is a pale sheet and the chrome sits straight on it, so the top is shaded to give the
             title and the back button something to read against -->
        <Rectangle VerticalAlignment="Top" Height="150" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource BlackB0}" Offset="0.0"/>
                    <GradientStop Color="{StaticResource BlackTransparent}" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Header -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,28,0,0">
            <TextBlock Text="{Binding Title}"
                       FontSize="{StaticResource FontSizeTitleLarge}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding Subtitle}"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{StaticResource Shadow}" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>

        </StackPanel>

        <!-- The part shops' map: the mail order, beside the back button -->
        <Button Style="{StaticResource DialogSecondaryButtonStyle}"
                Content="{t:Text dealermap.mail_order}"
                ToolTip="{t:Text dealermap.mail_order.tip}"
                Command="{Binding MailOrderCommand}"
                Visibility="{Binding CanMailOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="104,32,0,0"
                Padding="20,0"
                Height="40"/>

        <!-- Back -->
        <Button Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource BackIcon}"
                ToolTip="{t:Text common.back}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>
        <!-- Nothing to show: the definitions file did not load. Drawn under the loading overlay, so the
             first market of a game does not read as an empty map on the way past -->
        <TextBlock Text="{Binding EmptyText}"
                   FontSize="{StaticResource FontSizeSubheading}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasDealers, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

        <!-- The first market of a game takes a few seconds to put together -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{StaticResource BlackB0Brush}">
            <TextBlock Text="{Binding LoadingText}"
                       FontSize="{StaticResource FontSizeHeading}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>
