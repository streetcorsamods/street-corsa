<UserControl x:Class="StreetCorsa.Screens.NewGame.NewGameScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="800">
    <!-- The New Game card of the main screen: the licence to sign and the difficulty to start on -->
    <Border Style="{StaticResource MenuCardStyle}">
        <StackPanel>
            <TextBlock Text="{t:Text newgame.title}" Style="{StaticResource MenuCardTitleStyle}"/>

            <!-- Driver's License with Name Input -->
            <Grid Width="600" Margin="0,0,0,20">
                <!-- Driver's License Image -->
                <Image Source="pack://application:,,,/Assets/Images/Misc/license.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>

                <!-- Name Input Overlay - Positioned on License -->
                <TextBox x:Name="PlayerNameTextBox"
                         Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource LicenseNameInputStyle}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         TextAlignment="Left"
                         Width="260"
                         Margin="221,95,0,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding StartGameCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>

            <!-- Difficulty: a preset, and its figures for whoever wants to adjust them -->
            <Border Width="600"
                    Background="{StaticResource BgPanelCCBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="20,12"
                    Margin="0,0,0,10">
                <Border.Resources>
                    <Style x:Key="RulesLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="RulesValue" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Right"/>
                    </Style>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                        <Setter Property="Margin" Value="0,0,25,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
                        <Setter Property="Margin" Value="0,4"/>
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{t:Text newgame.difficulty}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"/>
                        <RadioButton Content="{t:Text difficulty.easy}" IsChecked="{Binding Rules.IsEasy, Mode=OneWay}"
                                     Command="{Binding Rules.PickCommand}" CommandParameter="Easy"/>
                        <RadioButton Content="{t:Text difficulty.normal}" IsChecked="{Binding Rules.IsNormal, Mode=OneWay}"
                                     Command="{Binding Rules.PickCommand}" CommandParameter="Normal"/>
                        <RadioButton Content="{t:Text difficulty.hard}" IsChecked="{Binding Rules.IsHard, Mode=OneWay}"
                                     Command="{Binding Rules.PickCommand}" CommandParameter="Hard"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Rules.Summary}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <Expander Header="{t:Text newgame.adjust}"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="{StaticResource FontSizeSmall}"
                              Margin="0,8,0,0">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{t:Text newgame.car_prices}" Style="{StaticResource RulesLabel}"/>
                        <Slider Grid.Row="0" Grid.Column="1" Value="{Binding Rules.CarPricePercent}" Minimum="50" Maximum="200"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Rules.CarPricePercent, StringFormat='{}{0}%'}" Style="{StaticResource RulesValue}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{t:Text newgame.part_prices}" Style="{StaticResource RulesLabel}"/>
                        <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Rules.PartPricePercent}" Minimum="50" Maximum="200"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Rules.PartPricePercent, StringFormat='{}{0}%'}" Style="{StaticResource RulesValue}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{t:Text newgame.prizes}" Style="{StaticResource RulesLabel}"/>
                        <Slider Grid.Row="2" Grid.Column="1" Value="{Binding Rules.PrizePercent}" Minimum="50" Maximum="200"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Rules.PrizePercent, StringFormat='{}{0}%'}" Style="{StaticResource RulesValue}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{t:Text newgame.wear}" Style="{StaticResource RulesLabel}"/>
                        <Slider Grid.Row="3" Grid.Column="1" Value="{Binding Rules.WearPercent}" Minimum="25" Maximum="200"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Rules.WearPercent, StringFormat='{}{0}%'}" Style="{StaticResource RulesValue}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{t:Text newgame.rival_skill}" Style="{StaticResource RulesLabel}"/>
                        <Slider Grid.Row="4" Grid.Column="1" Value="{Binding Rules.OpponentSkill}" Minimum="-5" Maximum="5"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Rules.OpponentSkill, StringFormat='{}{0:+0;-0;0}'}" Style="{StaticResource RulesValue}"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{t:Text newgame.rival_aggression}" Style="{StaticResource RulesLabel}"/>
                        <Slider Grid.Row="5" Grid.Column="1" Value="{Binding Rules.OpponentAggression}" Minimum="-50" Maximum="50"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Rules.OpponentAggression, StringFormat='{}{0:+0;-0;0}'}" Style="{StaticResource RulesValue}"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{t:Text newgame.pink_slips}" Style="{StaticResource RulesLabel}"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,4"
                                  ItemsSource="{Binding Rules.PinkSlipFrequencies}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Rules.PinkSlipFrequency}"/>
                        <CheckBox Grid.Row="7" Grid.ColumnSpan="3" Content="{t:Text newgame.race_simulation}"
                                  IsChecked="{Binding Rules.RaceSimulationEnabled}"/>
                        <CheckBox Grid.Row="8" Grid.ColumnSpan="3" Content="{t:Text newgame.seasons}"
                                  IsChecked="{Binding Rules.SeasonalRacingEnabled}"/>
                        <CheckBox Grid.Row="9" Grid.ColumnSpan="3" Content="{t:Text newgame.market_refresh}"
                                  IsChecked="{Binding Rules.MarketRefreshEnabled}"/>
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource AccentPrimaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextAlignment="Center"
                       Margin="0,0,0,10"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Buttons Container -->
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0">
                <Button Content="{t:Text common.back}"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="150"
                        Height="45"
                        Margin="0,0,20,0"
                        FontSize="{StaticResource FontSizeSubheading}"/>
                <Button Content="{t:Text newgame.start}"
                        Command="{Binding StartGameCommand}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Width="150"
                        Height="45"
                        FontSize="{StaticResource FontSizeSubheading}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
