<UserControl x:Class="StreetCorsa.Screens.MainMenu.IntroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <!--
        The title, laid over the main screen while its showroom loads behind it. MainMenuScreenView decides when it
        goes; a click takes it away sooner.
    -->
    <Grid Background="{StaticResource InitBackgroundBrush}">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Background fade in -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.0"
                                       To="1.0"
                                       Duration="0:0:1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- The title: a mod's logo picture (theme/images/intro/logo) when it has one, else the title in lettering -->
        <Grid x:Name="Logo"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Opacity="0">
            <Image x:Name="LogoImage"
                   Stretch="Uniform"
                   MaxWidth="1100"
                   MaxHeight="520"
                   Visibility="Collapsed"/>
            <StackPanel x:Name="LogoText">
                <TextBlock Text="{t:Text intro.title}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="{StaticResource FontSizeIntroTitle}"
                           FontStyle="Italic"
                           Foreground="{StaticResource IntroTitleBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource Shadow}" BlurRadius="12" ShadowDepth="4" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{t:Text intro.powered_by}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="{StaticResource FontSizeTitleLarge}"
                           FontStyle="Italic"
                           Foreground="{StaticResource IntroSubtitleBrush}"
                           HorizontalAlignment="Right">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource Shadow}" BlurRadius="8" ShadowDepth="3" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- The title fades in after the background -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           BeginTime="0:0:1"
                                           Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Grid>
</UserControl>
