<UserControl x:Class="StreetCorsa.Screens.MainMenu.MainMenuScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:StreetCorsa.Controls"
             xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
             xmlns:local="clr-namespace:StreetCorsa.Screens.MainMenu"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <!--
        The cars fill the lower part of the screen, fading into black towards the top. The menu and its cards sit in the
        dark part; the cars go on below them whatever is open.
    -->
    <Grid Background="{StaticResource StageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="44*"/>
        </Grid.RowDefinitions>

        <!-- The picture the screen had before, only when there is no showroom to show: while one loads the screen is black -->
        <Border x:Name="Fallback"
                Grid.RowSpan="3"
                Background="{StaticResource MainBackgroundBrush}"
                Opacity="0"/>

        <controls:ShowcaseViewport3D x:Name="Showcase"
                                     Grid.Row="1"
                                     Grid.RowSpan="2"
                                     Cars="{Binding ShowcaseCars}"
                                     Scenes="{Binding ShowcaseScenes}"/>

        <!-- The cars a shade darker, so they stay behind the menu -->
        <Rectangle Grid.Row="1" Grid.RowSpan="2" Fill="{StaticResource MenuShadeBrush}" IsHitTestVisible="False"/>

        <!-- The fade to black the menu stands in -->
        <Rectangle Grid.Row="0" Fill="{StaticResource MenuBandBrush}" IsHitTestVisible="False"/>
        <Rectangle Grid.Row="1" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource MenuBand}" Offset="0"/>
                    <GradientStop Color="{StaticResource MenuBandNear}" Offset="0.2"/>
                    <GradientStop Color="{StaticResource MenuBandMid}" Offset="0.55"/>
                    <GradientStop Color="{StaticResource MenuBandEnd}" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Which car the camera is on -->
        <TextBlock Grid.Row="2"
                   Text="{Binding CurrentTitle, ElementName=Showcase}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="{StaticResource FontSizeBody}"
                   FontStyle="Italic"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,36,28"
                   Opacity="0.85"
                   IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="8" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Exit. Hidden until the menu first comes up (ShowPanel): the title fades in over this screen, and a button
             up from the start would show through it -->
        <Button x:Name="ExitButton"
                Grid.Row="0"
                Opacity="0"
                Style="{StaticResource RoundIconButtonStyle}"
                Tag="{StaticResource QuitIcon}"
                ToolTip="{t:Text menu.quit}"
                Command="{Binding ExitCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

        <!-- Bottom left: who made the music, a click away from their site (the music's sfx\credits.csv). Hidden until the
             menu first comes up, as the corner buttons -->
        <Button x:Name="MusicBadge"
                Grid.Row="2"
                Opacity="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="24,0,0,24"
                Cursor="Hand"
                Focusable="False"
                ToolTip="{Binding MusicMaker.Link.AbsoluteUri}"
                Command="{Binding OpenMusicMakerCommand}"
                Visibility="{Binding HasMusicMaker, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="plate"
                            CornerRadius="22"
                            Padding="12,6,18,7"
                            BorderThickness="2"
                            Background="{StaticResource UiGlassBrush}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource RadioBrass}"/>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Shadow}" ShadowDepth="2" BlurRadius="10" Opacity="0.8"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <!-- A pair of eighth notes -->
                            <Path Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Data="F1 M12,17 A3,2.4 0 1 1 12,16.9 Z M22,15 A3,2.4 0 1 1 22,14.9 Z M10,17 L10,4 L22,1.5 L22,15 L20,15 L20,4.2 L12,5.9 L12,17 Z">
                                <Path.Fill>
                                    <SolidColorBrush Color="{StaticResource RadioBrass}"/>
                                </Path.Fill>
                            </Path>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{t:Text menu.music_by}"
                                           Foreground="{StaticResource Cream70Brush}"
                                           FontSize="{StaticResource FontSizeSmall}"/>
                                <TextBlock x:Name="maker"
                                           Text="{Binding MusicMaker.Author}"
                                           Foreground="{StaticResource CreamBrush}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontStyle="Italic"
                                           FontSize="{StaticResource FontSizeHeading}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{StaticResource UiGlassHoverBrush}"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="{StaticResource CreamBrush}"/>
                            <Setter TargetName="plate" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{StaticResource UiGlassPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Top right: a lit warning when races will not run on AC's Custom Shaders Patch -->
        <StackPanel x:Name="CornerPanel"
                    Grid.Row="0"
                    Opacity="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,20,20,0"
                    Panel.ZIndex="1">
            <Button Style="{StaticResource RoundIconButtonStyle}"
                    Tag="{StaticResource WarningIcon}"
                    helpers:GlassButton.IsLit="True"
                    ToolTip="{t:Text menu.csp.tip}"
                    Command="{Binding ShowCspProblemCommand}"
                    Visibility="{Binding HasCspProblem, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- The menu -->
        <StackPanel x:Name="MenuPanel"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,60,0,0"
                    Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform/>
            </StackPanel.RenderTransform>
            <!-- The flow's cards (flow/*.json, "cards"), from the left, 36 apart; each card's kind has its picture -->
            <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Command}"
                                Content="{Binding Text}"
                                Margin="18,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Card}" Value="load_game">
                                            <Setter Property="Background" Value="{StaticResource LoadGameButtonBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Card}" Value="new_game">
                                            <Setter Property="Background" Value="{StaticResource NewGameButtonBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Card}" Value="mods">
                                            <Setter Property="Background" Value="{StaticResource ModsButtonBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Card}" Value="settings">
                                            <Setter Property="Background" Value="{StaticResource SettingsButtonBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- The open card, in the menu's place. It may reach down over the cars: a new game's form is tall. -->
        <ScrollViewer x:Name="CardPanel"
                      Grid.Row="0"
                      Grid.RowSpan="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Top"
                      Margin="0,28,0,28"
                      Visibility="Collapsed"
                      Opacity="0">
            <ScrollViewer.RenderTransform>
                <TranslateTransform/>
            </ScrollViewer.RenderTransform>
            <ContentControl x:Name="CardHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Focusable="False"/>
        </ScrollViewer>

        <!-- The title the game opens on is the window's (MainWindow.Intro): up from the first frame, taken over here -->
    </Grid>
</UserControl>
