<UserControl x:Class="StreetCorsa.Controls.LoadingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsHitTestVisible="False">
    <!-- The one loader of every screen: a turning ring and what is being waited for. It fades out when IsLoading goes
         false and in again when it comes back; on a new screen it fades in with the screen. -->
    <StackPanel>
        <Border Width="60" Height="60" Margin="0,0,0,30">
            <Border.RenderTransform>
                <RotateTransform x:Name="SpinnerRotation" CenterX="30" CenterY="30"/>
            </Border.RenderTransform>
            <Ellipse Stroke="{StaticResource SpinnerOrangeBrush}" StrokeThickness="4"
                     StrokeDashArray="3 2"
                     Fill="Transparent"/>
        </Border>
        <TextBlock x:Name="MessageText"
                   FontSize="{StaticResource FontSizeTitleSmall}"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect Color="{StaticResource Shadow}" ShadowDepth="0" BlurRadius="8" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>
    </StackPanel>
</UserControl>
