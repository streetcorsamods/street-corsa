<UserControl x:Class="StreetCorsa.Controls.EnginePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             x:Name="Root">
    <!-- Start the car where it stands and rev it: the key, the tach, the pedal -->
    <Border Background="{StaticResource BgPanelCCBrush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="5"
            Padding="10,8">
        <Grid DataContext="{Binding Runner, ElementName=Root}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Ignition (a screen with a key of its own hides it) -->
            <Button x:Name="StartButton"
                    Grid.Column="0"
                    Width="92"
                    Height="46"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Focusable="False"
                    IsEnabled="{Binding CanToggle}"
                    Visibility="{Binding ShowStartButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="OnStartClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{StaticResource BgMediumBrush}"
                                BorderBrush="{StaticResource TextDisabledBrush}"
                                BorderThickness="1"
                                CornerRadius="23">
                            <TextBlock x:Name="label"
                                       Text="{t:Text garage.engine.start}"
                                       FontSize="{StaticResource FontSizeCompact}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GrayA0Brush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="label" Property="Text" Value="{t:Text garage.engine.stop}"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Tach -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="150">
                <Grid>
                    <TextBlock Text="{Binding RpmDisplay}"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="Bold"
                               FontFamily="{StaticResource NumbersFont}"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{t:Text garage.engine.rpm}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,3"/>
                </Grid>
                <Grid x:Name="TachTrack" Height="8" Margin="0,3,0,4" ClipToBounds="True">
                    <Border Background="{StaticResource Gray30Brush}" CornerRadius="2"/>
                    <Rectangle x:Name="RedZone" Fill="{StaticResource RedZoneBrush}" HorizontalAlignment="Right"/>
                    <Rectangle x:Name="Needle" Fill="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding RpmFraction}"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <TextBlock x:Name="StatusLine"
                           Text="{Binding StatusText}"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Pedal: press and hold, lower is further down -->
            <Border x:Name="Pedal"
                    Grid.Column="2"
                    Width="30"
                    Height="52"
                    Margin="12,0,0,0"
                    Background="{StaticResource Gray26Brush}"
                    BorderBrush="{StaticResource TextDisabledBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Cursor="Hand"
                    ToolTip="{t:Text garage.engine.pedal.tip}"
                    MouseLeftButtonDown="OnPedalDown"
                    MouseMove="OnPedalMove"
                    MouseLeftButtonUp="OnPedalUp"
                    LostMouseCapture="OnPedalLost">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{StaticResource AccentPrimaryBrush}" Opacity="0.75" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleY="{Binding Pedal}"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                        <Rectangle Height="2" Margin="6,2" Fill="{StaticResource Gray70Brush}"/>
                        <Rectangle Height="2" Margin="6,2" Fill="{StaticResource Gray70Brush}"/>
                        <Rectangle Height="2" Margin="6,2" Fill="{StaticResource Gray70Brush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
