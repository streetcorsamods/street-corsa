<UserControl x:Class="StreetCorsa.Controls.TalkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:StreetCorsa.Services.Text"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="440">
    <!-- A talk (Screens/Shared/TalkViewModel as the DataContext): who, the lines, the price as it stands, what to say -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Who, where, and the price -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="84" Height="84"
                    CornerRadius="6"
                    Margin="0,0,12,0"
                    BorderBrush="{StaticResource Cream70Brush}"
                    BorderThickness="2"
                    Visibility="{Binding HasPortrait, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" Viewbox="0.15,0.02,0.7,0.7"/>
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Subtitle}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding PriceLine}"
                           Visibility="{Binding PriceLine, Converter={StaticResource StringToVisibilityConverter}}"
                           FontSize="{StaticResource FontSizeCompact}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentSuccessBrush}"/>
                <TextBlock Text="{Binding DealLine}"
                           Visibility="{Binding DealLine, Converter={StaticResource StringToVisibilityConverter}}"
                           FontSize="{StaticResource FontSizeCaption}"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource GoldBrush}"/>
            </StackPanel>
        </Grid>

        <!-- The talk so far, the newest at the bottom -->
        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <!-- Theirs: on the left, their name over it -->
                            <StackPanel HorizontalAlignment="Left"
                                        MaxWidth="290"
                                        Visibility="{Binding FromThem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Who}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding Who, Converter={StaticResource StringToVisibilityConverter}}"/>
                                <Border Background="{StaticResource BgPanelCCBrush}"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,6">
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeCompact}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <!-- The player's: on the right -->
                            <Border HorizontalAlignment="Right"
                                    MaxWidth="270"
                                    Background="{StaticResource UiPrimaryGlassBrush}"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Visibility="{Binding FromPlayer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           FontSize="{StaticResource FontSizeCompact}"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                            <!-- The game's note -->
                            <TextBlock Text="{Binding Text}"
                                       HorizontalAlignment="Center"
                                       FontStyle="Italic"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource GoldBrush}"
                                       Visibility="{Binding IsNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Shaken on: the deal is closed here, by the screen's own purchase -->
        <Button Grid.Row="2"
                Content="{Binding BuyLabel}"
                Command="{Binding BuyCommand}"
                Visibility="{Binding CanBuy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Height="38"
                Margin="0,10,0,0"
                FontSize="{StaticResource FontSizeBody}"
                FontWeight="Bold"
                Foreground="{StaticResource BgPanelBrush}"
                Background="{StaticResource GoldBrush}"/>

        <!-- What the player says: Enter or the button -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input"
                     Grid.Column="0"
                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="300"
                     FontSize="{StaticResource FontSizeCompact}"
                     VerticalContentAlignment="Center"
                     Height="34">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <!-- The hint, until something is typed -->
            <TextBlock Grid.Column="0"
                       Text="{Binding Hint}"
                       IsHitTestVisible="False"
                       FontStyle="Italic"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{StaticResource TextDisabledBrush}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Visibility="{Binding ShowsHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Grid.Column="1"
                    Content="{t:Text chat.ui.send}"
                    Command="{Binding SendCommand}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Height="34"
                    MinWidth="84"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    FontSize="{StaticResource FontSizeCompact}"/>
        </Grid>
    </Grid>
</UserControl>
