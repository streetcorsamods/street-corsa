<Window x:Class="StreetCorsa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StreetCorsa"
        xmlns:radio="clr-namespace:StreetCorsa.Audio.Radio"
        xmlns:controls="clr-namespace:StreetCorsa.Controls"
        xmlns:helpers="clr-namespace:StreetCorsa.Helpers"
        mc:Ignorable="d"
        Title="Street Corsa"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="{StaticResource BgDarkBrush}"
        x:Name="MainWindowRoot">
    <Grid>
        <!-- The screen and its transition: the still of a change of screen is taken of the two together, so a change
             in the middle of another carries on from what is on show -->
        <Grid x:Name="ScreenArea">
            <!-- Screen Host. Disabled while a dialog is up: the overlay only stops the mouse, and the keyboard would
                 otherwise still press the button behind it or rev the engine. Window-level key handlers check
                 Dialogs.ModalState themselves. -->
            <ContentControl x:Name="ScreenHost"
                            Content="{Binding NavigationService.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- The player's money, the date and the time, top right over every screen of a game in play
                 (IScreen.InGame); read off the game a few times a second (see UpdateStatus) -->
            <Border x:Name="StatusCard"
                    Style="{StaticResource GlassPanelStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,20,20,0"
                    Padding="14,6,14,8"
                    MinWidth="150"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="StatusMoney"
                               Foreground="{StaticResource AccentSuccessBrush}"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="StatusTime"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="StatusDate"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- A change of screen: a still of the screen being left, over black. The still fades to black, then the
                 black fades off the new screen (see ScreenTransition). Takes the clicks while it plays. -->
            <Grid x:Name="TransitionLayer" Visibility="Collapsed" Background="Transparent">
                <Rectangle x:Name="TransitionBlack" Fill="Black"/>
                <Image x:Name="TransitionStill" Stretch="Fill"/>
            </Grid>
        </Grid>

        <!-- Assetto Corsa is running (a free run: a race has its own screen for it). The screen fades to this on the
             launch, and back when AC closes. -->
        <Grid x:Name="RacingLayer"
              Background="{StaticResource BgPanelBrush}"
              helpers:Reveal.IsShown="False">
            <controls:LoadingIndicator x:Name="RacingIndicator" Message="Out on the track..."/>
        </Grid>

        <!-- The radio's panel, over any screen (F2, the garage's radio). The screen behind is disabled as for a dialog. -->
        <Grid x:Name="RadioHost"
              Background="{StaticResource OverlayBrush}"
              helpers:Reveal.IsShown="False">
            <radio:RadioPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"/>
        </Grid>

        <!-- What the radio has just put on, for a few seconds: it comes out of the radio's icon (or the money card on a
             screen without one) to the left, and goes back into it (see ShowNowPlaying) -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="RadioToast"
                    Opacity="0"
                    Padding="16,7"
                    CornerRadius="18"
                    Background="{StaticResource UiGlassCardBrush}"
                    BorderBrush="{StaticResource UiOutlineBrush}"
                    BorderThickness="2"
                    RenderTransformOrigin="1,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="RadioToastScale"/>
                        <TranslateTransform x:Name="RadioToastShift"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="♪" Foreground="{StaticResource AmberBrush}" FontSize="{StaticResource FontSizeHeading}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RadioToastText" Foreground="{StaticResource CreamBrush}" FontFamily="Georgia" FontSize="{StaticResource FontSizeBodyLarge}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Canvas>

        <!-- Dialog Host Overlay: fades in and out (see OnDialogChanged); the dialog that closed stays in it while it
             fades -->
        <Grid x:Name="DialogHost"
              Background="{StaticResource OverlayBrush}"
              helpers:Reveal.IsShown="False">
            <Border x:Name="DialogCard"
                    Background="{StaticResource UiGlassCardBrush}"
                    BorderBrush="{StaticResource UiOutlineBrush}"
                    BorderThickness="3"
                    CornerRadius="10"
                    MaxWidth="750"
                    Margin="40"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource DropShadowEffect}">
                <!-- As tall as the window allows, and scrolling beyond that: a long message or the event entry's
                     car list is never cut off on a small or high-DPI screen -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="DialogContent"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
