<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StreetCorsa</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- The part logic is the game's; the bench only drives it from the command line -->
  <ItemGroup>
    <Compile Include="..\..\Street Corsa\Parts\PartDefinition.cs" Link="Parts\PartDefinition.cs" />
    <Compile Include="..\..\Street Corsa\Parts\CameIn.cs" Link="Parts\CameIn.cs" />
    <Compile Include="..\..\Street Corsa\Parts\EngineBuild.cs" Link="Parts\EngineBuild.cs" />
    <Compile Include="..\..\Street Corsa\Parts\PartsCatalog.cs" Link="Parts\PartsCatalog.cs" />
    <Compile Include="..\..\Street Corsa\Parts\SlotShifts.cs" Link="Parts\SlotShifts.cs" />
    <Compile Include="..\..\Street Corsa\Parts\PartKinds.cs" Link="Parts\PartKinds.cs" />
    <Compile Include="..\..\Street Corsa\Parts\PartClasses.cs" Link="Parts\PartClasses.cs" />
    <Compile Include="..\..\Street Corsa\Parts\PartSlots.cs" Link="Parts\PartSlots.cs" />
    <Compile Include="..\..\Street Corsa\Parts\PartGroups.cs" Link="Parts\PartGroups.cs" />
    <Compile Include="..\..\Street Corsa\Parts\WorkOrder.cs" Link="Parts\WorkOrder.cs" />
    <Compile Include="..\..\Street Corsa\Parts\PartRebuilds.cs" Link="Parts\PartRebuilds.cs" />
    <Compile Include="..\..\Street Corsa\Parts\EngineLayout.cs" Link="Parts\EngineLayout.cs" />
    <Compile Include="..\..\Street Corsa\Parts\Cars\*.cs" Exclude="..\..\Street Corsa\Parts\Cars\CarCondition.cs;..\..\Street Corsa\Parts\Cars\RepairShop.cs;..\..\Street Corsa\Parts\Cars\GasStation.cs;..\..\Street Corsa\Parts\Cars\AttendantCheck.cs;..\..\Street Corsa\Parts\Cars\CarLooks.cs" Link="Parts\Cars\%(Filename)%(Extension)" />
    <Compile Include="..\..\Street Corsa\Models\Race\RaceStartState.cs" Link="Models\RaceStartState.cs" />
    <Compile Include="..\..\Street Corsa\Models\GameState\PartInstance.cs" Link="Models\PartInstance.cs" />
    <Compile Include="..\..\Street Corsa\Parts\Logic\*.cs" Link="Parts\Logic\%(Filename)%(Extension)" />
    <Compile Include="..\..\Street Corsa\Parts\Export\*.cs" Link="Parts\Export\%(Filename)%(Extension)" />
    <Compile Include="..\..\Street Corsa\Parts\Sounds\*.cs" Link="Parts\Sounds\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The game's plain-BCL helpers the linked part code uses (and the tool itself): atomic writes, paths kept inside a root, the career's multipliers, figures held to 0..1 -->
  <ItemGroup>
    <Compile Include="..\..\Street Corsa\Helpers\SafeFile.cs" Link="Helpers\SafeFile.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ModIds.cs" Link="Mods\ModIds.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ModSet.cs" Link="Mods\ModSet.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ModVersion.cs" Link="Mods\ModVersion.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ModJson.cs" Link="Mods\ModJson.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ModJsonOptions.cs" Link="Mods\ModJsonOptions.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ModMerge.cs" Link="Mods\ModMerge.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ContentRegistry.cs" Link="Mods\ContentRegistry.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ModRemovals.cs" Link="Mods\ModRemovals.cs" />
    <Compile Include="..\..\Street Corsa\Helpers\PathNames.cs" Link="Helpers\PathNames.cs" />
    <Compile Include="..\..\Street Corsa\Helpers\Multiplier.cs" Link="Helpers\Multiplier.cs" />
    <Compile Include="..\..\Street Corsa\Helpers\Unit.cs" Link="Helpers\Unit.cs" />
    <Compile Include="..\..\Street Corsa\Helpers\Conversion.cs" Link="Helpers\Conversion.cs" />
  </ItemGroup>

</Project>
