<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StreetCorsa</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcTools">
      <HintPath>..\..\..\actools\AcTools\bin\x64\Release\AcTools.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- The converted part format is owned by the game; the converter only writes it -->
  <ItemGroup>
    <Compile Include="..\..\Street Corsa\Parts\PartDefinition.cs" Link="Parts\PartDefinition.cs" />
    <Compile Include="..\..\Street Corsa\Parts\PartOverrides.cs" Link="Parts\PartOverrides.cs" />
    <Compile Include="..\..\Street Corsa\Parts\EngineBuild.cs" Link="Parts\EngineBuild.cs" />
    <Compile Include="..\..\Street Corsa\Parts\SlotShifts.cs" Link="Parts\SlotShifts.cs" />
    <Compile Include="..\..\Street Corsa\Parts\Kn5Bitmap.cs" Link="Parts\Kn5Bitmap.cs" />
    <Compile Include="..\..\Street Corsa\Parts\Scripting\*.cs" Link="Parts\Scripting\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The game's plain-BCL helpers the linked part code uses (and the tool itself): atomic writes, paths kept inside a root -->
  <ItemGroup>
    <Compile Include="..\..\Street Corsa\Helpers\SafeFile.cs" Link="Helpers\SafeFile.cs" />
    <Compile Include="..\..\Street Corsa\Mods\ModIds.cs" Link="Mods\ModIds.cs" />
    <Compile Include="..\..\Street Corsa\Helpers\PathNames.cs" Link="Helpers\PathNames.cs" />
  </ItemGroup>

</Project>
