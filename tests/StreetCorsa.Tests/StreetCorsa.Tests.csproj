<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- xunit.v3 test projects are executables, run by Microsoft.Testing.Platform (global.json opts dotnet test in) -->
    <OutputType>Exe</OutputType>
    <RootNamespace>StreetCorsa.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The game ships ~550 MB of parts and sounds as content; the tests read the parts from the source tree
         instead of getting a copy of them in their output folder -->
    <_GetChildProjectCopyToOutputDirectoryItems>false</_GetChildProjectCopyToOutputDirectoryItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Street Corsa\Street Corsa.csproj" />
    <!-- Reads the scenes the game ships (CarLotTests), as the game does -->
    <Reference Include="AcTools">
      <HintPath>$(AcToolsLib)AcTools.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The core's data and the street rods' (not their models, sounds or pictures): the services that read the content in
       play by default (the career, the words, the dealers, the racers) find it in the test output as the game finds it
       next to itself. The tests play the street rods (TestContent) -->
  <ItemGroup>
    <None Include="..\..\Street Corsa\Content\streetcorsa\mod.json" Link="Content\streetcorsa\mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\game.json" Link="Content\streetcorsa\game.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\rules\*.json" LinkBase="Content\streetcorsa\rules" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\flow\*.json" LinkBase="Content\streetcorsa\flow" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\parts\part_groups.json" Link="Content\streetcorsa\parts\part_groups.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\parts\part_classes.json" Link="Content\streetcorsa\parts\part_classes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\parts\fuels.json" Link="Content\streetcorsa\parts\fuels.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\text\*.json" LinkBase="Content\streetcorsa\text" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\ai\*.json" LinkBase="Content\streetcorsa\ai" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\formats\*.json" LinkBase="Content\streetcorsa\formats" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\mod.json" Link="Content\streetrod\mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\game.json" Link="Content\streetrod\game.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\rules\*.json" LinkBase="Content\streetrod\rules" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\cars\*.json" LinkBase="Content\streetrod\cars" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\text\*.json" LinkBase="Content\streetrod\text" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\ai\*.json" LinkBase="Content\streetrod\ai" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\events\*.json" LinkBase="Content\streetrod\events" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\milestones\*.json" LinkBase="Content\streetrod\milestones" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\victories\*.json" LinkBase="Content\streetrod\victories" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\dealers\*.json" LinkBase="Content\streetrod\dealers" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\partshops\*.json" LinkBase="Content\streetrod\partshops" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\racers\*.json" LinkBase="Content\streetrod\racers" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\diners\*.json" LinkBase="Content\streetrod\diners" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetrod\stations\*\station.json" LinkBase="Content\streetrod\stations" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What the scene builders share, tried on models in memory: their meshes, a prop's OBJ meshes and their command lines -->
  <ItemGroup>
    <Compile Include="..\..\tools\Shared\Kn5SceneWriter.cs" Link="Tools\Kn5SceneWriter.cs" />
    <Compile Include="..\..\tools\Shared\ObjModel.cs" Link="Tools\ObjModel.cs" />
    <Compile Include="..\..\tools\Shared\SceneMesh.cs" Link="Tools\SceneMesh.cs" />
    <Compile Include="..\..\tools\Shared\BuilderArgs.cs" Link="Tools\BuilderArgs.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The WPF SDK leaves System.IO out of the implicit usings; nearly every test here works on files -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
