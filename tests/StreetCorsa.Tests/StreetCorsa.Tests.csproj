<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- xunit.v3 test projects are executables, run by Microsoft.Testing.Platform (global.json opts dotnet test in) -->
    <OutputType>Exe</OutputType>
    <RootNamespace>StreetCorsa.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The game ships ~550 MB of parts and sounds as content; the tests read the parts from the source tree
         instead of getting a copy of them in their output folder -->
    <_GetChildProjectCopyToOutputDirectoryItems>false</_GetChildProjectCopyToOutputDirectoryItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Street Corsa\Street Corsa.csproj" />
    <!-- Reads the scenes the game ships (CarLotTests), as the game does -->
    <Reference Include="AcTools">
      <HintPath>..\..\..\actools\Output\x64\Debug\AcTools.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The base game's data (not its models, sounds or pictures): the services that read the installed mods by default
       (the career, the words, the dealers, the racers) find it in the test output as the game finds it next to itself -->
  <ItemGroup>
    <None Include="..\..\Street Corsa\Content\streetcorsa\mod.json" Link="Content\streetcorsa\mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\text\*.json" LinkBase="Content\streetcorsa\text" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\events\*.json" LinkBase="Content\streetcorsa\events" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\milestones\*.json" LinkBase="Content\streetcorsa\milestones" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\victories\*.json" LinkBase="Content\streetcorsa\victories" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\dealers\*.json" LinkBase="Content\streetcorsa\dealers" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\partshops\*.json" LinkBase="Content\streetcorsa\partshops" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\racers\*.json" LinkBase="Content\streetcorsa\racers" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Street Corsa\Content\streetcorsa\stations\*\station.json" LinkBase="Content\streetcorsa\stations" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The WPF SDK leaves System.IO out of the implicit usings; nearly every test here works on files -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
