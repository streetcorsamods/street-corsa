<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Street Corsa for one player: no admin, installed in %LocalAppData%\Programs\Street Corsa, so mods can be dropped into
    its Content folder. The wizard asks where Assetto Corsa is (Dialogs.wxs) and keeps it in HKCU\Software\Street Corsa,
    where the game looks when its settings name no folder (AcInstallFinder). The UpgradeCode never changes: a newer MSI
    replaces the older one.
  -->
  <Package Name="Street Corsa"
           Manufacturer="Pablo Camardelli"
           Version="$(ProductVersion)"
           UpgradeCode="B2E61D38-8857-425F-B0EE-0F27F1F909D5"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="Street Corsa: a Street Rod-style career that runs on top of Assetto Corsa" />

    <!-- Same version too: a rebuilt MSI of one version replaces the one installed rather than going in beside it -->
    <MajorUpgrade DowngradeErrorMessage="A newer Street Corsa is already installed." Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="200" />

    <!-- The game's icon, on its shortcuts and in Windows' installed apps -->
    <Icon Id="StreetCorsaIcon" SourceFile="..\Street Corsa\street_corsa.ico" />
    <Property Id="ARPPRODUCTICON" Value="StreetCorsaIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/streetcorsamods/street-corsa" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!--
      Windows' own entry for the MSI uninstalls with no wizard (msiexec /x: a progress bar), so it is hidden and the game
      writes its own (UninstallEntry): its Uninstall opens the MSI in maintenance mode, where the wizard's uninstall page
      (UninstallDlg, Dialogs.wxs) asks whether the saves, the settings and the mods stay.
    -->
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />

    <!-- The uninstall page's tick: the saves, settings and mods stay (on the command line, KEEP_DATA=1); unticked they go -->
    <Property Id="KEEP_DATA" Secure="yes" />

    <!-- The game's folder -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Street Corsa" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!--
      Assetto Corsa's folder: nothing is installed in it, it is a directory so the wizard's Browse can set it. FindAcFolder
      fills it (the game's own folder, the one picked last time, Steam's), each only when it holds AC: a directory is
      resolved on every run, uninstall too, and one on a drive gone since would stop it (error 1327). On the command line
      ACFOLDER=... for a quiet install.
    -->
    <!-- Steam's own folder for AC when nothing better is known; the 32-bit Program Files, where Steam installs -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="SteamDir" Name="Steam">
        <Directory Id="SteamAppsDir" Name="steamapps">
          <Directory Id="SteamCommonDir" Name="common">
            <Directory Id="ACFOLDER" Name="assettocorsa" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Property Id="ACFOLDER" Secure="yes" />

    <!--
      Windows 10 or later (.NET 10 runs on nothing older, nor does today's Steam). Windows Installer's own VersionNT says
      603 (8.1) on Windows 10, so the check is the registry value Windows 10 brought in: absent on 8.1 and before, 10 on
      Windows 10 and 11. 64-bit is the package's own platform: an x64 MSI does not install on 32-bit Windows.
    -->
    <Property Id="WINDOWS_MAJOR">
      <RegistrySearch Id="WindowsMajor" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentMajorVersionNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR WINDOWS_MAJOR" Message="Street Corsa needs 64-bit Windows 10 or 11." />

    <!-- What the game needs beside AC, for the wizard's checks page: DirectX's June 2010 runtime and VC++ 2015-2022 (SlimDX) -->
    <Property Id="HAS_D3DX">
      <DirectorySearch Id="D3dxSearch" Path="[System64Folder]" Depth="0">
        <FileSearch Id="D3dxFile" Name="d3dx11_43.dll" />
      </DirectorySearch>
    </Property>
    <Property Id="HAS_VCRT">
      <DirectorySearch Id="VcrtSearch" Path="[System64Folder]" Depth="0">
        <FileSearch Id="VcrtFile" Name="msvcp140.dll" />
      </DirectorySearch>
    </Property>

    <Property Id="DESKTOP_SHORTCUT" Value="1" Secure="yes" />

    <Binary Id="InstallerActions" SourceFile="$(var.InstallerActions.TargetDir)InstallerActions.CA.dll" />
    <CustomAction Id="FindAcFolder" BinaryRef="InstallerActions" DllEntry="FindAcFolder" Execute="immediate" Return="ignore" />
    <CustomAction Id="CheckAcFolder" BinaryRef="InstallerActions" DllEntry="CheckAcFolder" Execute="immediate" Return="ignore" />
    <CustomAction Id="FindOllama" BinaryRef="InstallerActions" DllEntry="FindOllama" Execute="immediate" Return="ignore" />
    <CustomAction Id="OpenOllamaPage" BinaryRef="InstallerActions" DllEntry="OpenOllamaPage" Execute="immediate" Return="ignore" />
    <CustomAction Id="LaunchGame" BinaryRef="InstallerActions" DllEntry="LaunchGame" Execute="immediate" Return="ignore" />

    <!--
      Uninstall: the game puts back what races changed in AC and takes its CSP modes out ("Street Corsa.exe" with its
      uninstall switch, AcUninstall); not on an upgrade. Before RemoveRegistryValues, while the AC folder the installer kept is still there
      for the game to find. RestoreAc (Actions\CustomActions.cs) runs the exe and reads its exit code: Assetto Corsa still
      running with a race's changes in it is put to the player (close it and retry, go on without, or keep the game) rather
      than gone past; a quiet uninstall goes on. Deferred, so the exe's path reaches it as CustomActionData (SetProperty).
    -->
    <SetProperty Id="RestoreAc" Value="Exe=[#GameExe]" Before="RestoreAc" Sequence="execute" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="RestoreAc" BinaryRef="InstallerActions" DllEntry="RestoreAc" Execute="deferred" Impersonate="yes" Return="check" />

    <!--
      Uninstall, unless KEEP_DATA: what the game made of its own goes too, once the files are gone: %AppData%\StreetCorsa
      (saves, settings, log) and the install folder's Content (the mods put there). PlanGameData (immediate) names the
      folders, only ones that are the game's, and RemoveGameData (deferred, last, where nothing is rolled back) deletes
      them. Not on an upgrade.
    -->
    <CustomAction Id="PlanGameData" BinaryRef="InstallerActions" DllEntry="PlanGameData" Execute="immediate" Return="ignore" />
    <CustomAction Id="RemoveGameData" BinaryRef="InstallerActions" DllEntry="RemoveGameData" Execute="deferred" Impersonate="yes" Return="ignore" />

    <InstallUISequence>
      <Custom Action="FindAcFolder" After="AppSearch" />
      <Custom Action="FindOllama" After="FindAcFolder" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="FindAcFolder" After="AppSearch" Condition="NOT Installed" />
      <!-- Again here, whatever the wizard set: the folder the game is told about (AC_CHOSEN) is none when it is put off -->
      <Custom Action="CheckAcFolder" After="FindAcFolder" Condition="NOT Installed" />
      <Custom Action="RestoreAc" Before="RemoveRegistryValues" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PlanGameData" Before="RemoveGameData" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND KEEP_DATA &lt;&gt; &quot;1&quot;" />
      <Custom Action="RemoveGameData" Before="InstallFinalize" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND KEEP_DATA &lt;&gt; &quot;1&quot;" />
    </InstallExecuteSequence>

    <Feature Id="Game" Title="Street Corsa" AllowAbsent="no">
      <ComponentGroupRef Id="GameFiles" />
      <ComponentRef Id="GameExe" />
      <ComponentRef Id="AcFolderChoice" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="UninstallEntry" />
    </Feature>

    <UIRef Id="StreetCorsaUI" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <!-- From the game's main screen background (make_art.py) -->
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
  </Package>

  <Fragment>
    <!-- Everything the build staged, but the exe, which the shortcuts and the uninstall point at -->
    <ComponentGroup Id="GameFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.stage)\**">
        <Exclude Files="!(bindpath.stage)\Street Corsa.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="GameExe" Directory="INSTALLFOLDER">
      <File Id="GameExe" Source="!(bindpath.stage)\Street Corsa.exe" KeyPath="yes" />
    </Component>

    <!--
      The game in Windows' installed apps, in place of the MSI's hidden entry (ARPSYSTEMCOMPONENT): Uninstall opens the
      wizard (msiexec /i on the installed product: maintenance mode, UninstallDlg); a quiet one is msiexec /x ... /qn
    -->
    <Component Id="UninstallEntry" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Street Corsa">
        <RegistryValue Name="DisplayName" Type="string" Value="[ProductName]" KeyPath="yes" />
        <RegistryValue Name="DisplayVersion" Type="string" Value="[ProductVersion]" />
        <RegistryValue Name="Publisher" Type="string" Value="[Manufacturer]" />
        <RegistryValue Name="DisplayIcon" Type="string" Value="[#GameExe],0" />
        <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Name="URLInfoAbout" Type="string" Value="[ARPURLINFOABOUT]" />
        <RegistryValue Name="UninstallString" Type="string" Value="&quot;[System64Folder]msiexec.exe&quot; /i [ProductCode]" />
        <RegistryValue Name="QuietUninstallString" Type="string" Value="&quot;[System64Folder]msiexec.exe&quot; /x [ProductCode] /qn" />
        <RegistryValue Name="NoModify" Type="integer" Value="1" />
        <RegistryValue Name="NoRepair" Type="integer" Value="1" />
      </RegistryKey>
    </Component>

    <!-- Only a folder that holds AC (CheckAcFolder): one the player put off setting stays for the game's Settings -->
    <Component Id="AcFolderChoice" Directory="INSTALLFOLDER" Condition="AC_CHOSEN">
      <RegistryValue Root="HKCU" Key="Software\Street Corsa" Name="AssettoCorsaPath" Type="string" Value="[AC_CHOSEN]" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuShortcut" Name="Street Corsa" Description="A Street Rod-style career on top of Assetto Corsa"
                Target="[#GameExe]" WorkingDirectory="INSTALLFOLDER" Icon="StreetCorsaIcon" />
      <RegistryValue Root="HKCU" Key="Software\Street Corsa" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOP_SHORTCUT = 1">
      <Shortcut Id="DesktopShortcut" Name="Street Corsa" Description="A Street Rod-style career on top of Assetto Corsa"
                Target="[#GameExe]" WorkingDirectory="INSTALLFOLDER" Icon="StreetCorsaIcon" />
      <RegistryValue Root="HKCU" Key="Software\Street Corsa" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
